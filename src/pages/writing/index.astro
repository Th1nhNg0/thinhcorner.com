---
export const prerender = true;
import Container from "@/components/Container.astro";
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";
import { format } from "date-fns";
import { tagLabel } from "@/lib/tags";

const blog = (await getCollection("writing")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const postsByYear = blog.reduce(
  (acc, post) => {
    const year = new Date(post.data.date).getFullYear();
    if (!acc[year]) acc[year] = [];
    acc[year].push(post);
    return acc;
  },
  {} as Record<number, typeof blog>,
);

// Tags ordered by how many published posts use them.
const tagCounts = new Map<string, number>();
for (const post of blog) {
  if (post.data.draft) continue;
  for (const tag of post.data.tags) tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
}
const tags = [...tagCounts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

const years = Object.keys(postsByYear).map(Number).sort((a, b) => b - a);
---

<Layout
  description="Read my collection of posts and the things that interest me"
  title="Writing — Thinh's Corner"
  image="/og/writing.jpg"
  lang="en"
  locale="en_US"
  structuredData={{
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Writing",
    description: "Read my collection of posts and the things that interest me",
    url: new URL("/writing", Astro.site).toString(),
  }}
>
  <Container>
    <header class="page-header">
      <div class="flex items-start justify-between gap-6">
        <div>
          <h1 class="page-title">Writing</h1>
          <p class="page-intro">Notes and essays on technology, research, and things I’m learning.</p>
        </div>
        <div class="mt-2 flex gap-2 text-sm text-zinc-500">
          <a href="/rss.xml" class="transition-colors hover:text-[#eab308]">RSS</a>
          <span aria-hidden="true">·</span>
          <a href="/rss/en.xml" hreflang="en" title="English posts only" class="transition-colors hover:text-[#eab308]">EN</a>
          <a href="/rss/vi.xml" hreflang="vi" title="Vietnamese posts only" class="transition-colors hover:text-[#eab308]">VI</a>
        </div>
      </div>
    </header>

    <nav class="mb-6 flex flex-wrap gap-x-3 gap-y-1 font-mono text-xs uppercase tracking-wider" aria-label="Tags">
      {
        tags.map(([tag, count]) => (
          <a href={`/writing/tag/${tag}`} class="text-zinc-500 transition-colors hover:text-[#eab308]">
            #{tagLabel(tag)} <span class="text-zinc-700">{count}</span>
          </a>
        ))
      }
    </nav>

    <div class="mb-8 flex items-center justify-between border-b border-[#27272a] pb-3 text-xs text-zinc-600">
      <span id="postCount">{blog.length} posts</span>
      <div id="langFilter" class="flex gap-3" role="group" aria-label="Filter by language">
        {
          [
            { lang: "all", label: "All" },
            { lang: "en", label: "English" },
            { lang: "vi", label: "Tiếng Việt" },
          ].map(({ lang, label }) => (
            <button
              type="button"
              data-lang-filter={lang}
              aria-pressed={lang === "all" ? "true" : "false"}
              class="cursor-pointer transition-colors hover:text-zinc-200 aria-pressed:text-[#eab308]"
            >
              {label}
            </button>
          ))
        }
      </div>
    </div>

    <div id="blogPosts" class="space-y-9">
      {
        years.map((year) => (
          <section data-year={year}>
            <h2 class="mb-2 text-base font-medium text-zinc-200">{year}</h2>
            <ol>
              {postsByYear[year].map((post) => (
                <li data-lang={post.data.lang || "en"}>
                  <a
                    data-astro-prefetch
                    href={`/writing/${post.id}`}
                    class="group grid grid-cols-[1fr_auto] items-baseline gap-4 py-2 focus-visible:outline-none"
                  >
                    <span class="min-w-0 text-base leading-snug text-zinc-400 transition-colors group-hover:text-zinc-100">
                      {post.data.draft && <span class="mr-2 text-xs text-[#eab308]">Draft</span>}
                      {post.data.title}
                    </span>
                    <time datetime={post.data.date.toISOString()} title={post.data.date.toISOString()} class="font-mono text-xs text-zinc-600">
                      {format(new Date(post.data.date), "MMM dd")}
                    </time>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </div>
  </Container>

<script>
  function initLanguageFilter() {
    const filter = document.getElementById("langFilter");
    const container = document.getElementById("blogPosts");
    const countLabel = document.getElementById("postCount");
    if (!filter || !container || !countLabel) return;
    const postsContainer = container;
    const count = countLabel;
    if (filter.dataset.filterInitialized === "true") return;

    const buttons = Array.from(
      filter.querySelectorAll<HTMLButtonElement>("[data-lang-filter]"),
    );

    function filterPosts(lang: string) {
      let visible = 0;
      postsContainer.querySelectorAll<HTMLLIElement>("li[data-lang]").forEach((item) => {
        const show = lang === "all" || item.dataset.lang === lang;
        item.style.display = show ? "" : "none";
        if (show) visible++;
      });

      postsContainer.querySelectorAll<HTMLElement>("[data-year]").forEach((section) => {
        const hasVisiblePosts = Array.from(
          section.querySelectorAll<HTMLLIElement>("li[data-lang]"),
        ).some((post) => post.style.display !== "none");
        section.style.display = hasVisiblePosts ? "" : "none";
      });

      buttons.forEach((button) =>
        button.setAttribute("aria-pressed", String(button.dataset.langFilter === lang)),
      );
      count.textContent = `${visible} posts`;
    }

    filter.dataset.filterInitialized = "true";
    buttons.forEach((button) =>
      button.addEventListener("click", () => filterPosts(button.dataset.langFilter ?? "all")),
    );
  }

  document.addEventListener("astro:page-load", initLanguageFilter);
</script>
</Layout>
