---
export const prerender = true;
import Container from "@/components/Container.astro";
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";
import { format } from "date-fns";
import { tagLabel } from "@/lib/tags";

const blog = (await getCollection("writing")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const postsByYear = blog.reduce(
  (acc, post) => {
    const year = new Date(post.data.date).getFullYear();
    if (!acc[year]) acc[year] = [];
    acc[year].push(post);
    return acc;
  },
  {} as Record<number, typeof blog>,
);

// Tags ordered by how many published posts use them.
const tagCounts = new Map<string, number>();
for (const post of blog) {
  if (post.data.draft) continue;
  for (const tag of post.data.tags) tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
}
const tags = [...tagCounts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

const years = Object.keys(postsByYear).map(Number).sort((a, b) => b - a);
---

<Layout
  description="Read my collection of posts and the things that interest me"
  title="Writing — Thinh's Corner"
  image="/og/writing.jpg"
  lang="en"
  locale="en_US"
  structuredData={{
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Writing",
    description: "Read my collection of posts and the things that interest me",
    url: new URL("/writing", Astro.site).toString(),
  }}
>
  <Container>
    <header class="page-header">
      <div class="flex items-start justify-between gap-6">
        <div>
          <h1 class="page-title">Writing</h1>
          <p class="page-intro">Notes and essays on technology, research, and things I’m learning.</p>
        </div>
        <div class="mt-2 flex items-center gap-1 text-sm text-zinc-500">
          <a href="/rss.xml" class="inline-flex min-h-6 min-w-6 items-center justify-center px-1 transition-colors hover:text-[#eab308]">RSS</a>
          <span aria-hidden="true">·</span>
          <a href="/rss/en.xml" hreflang="en" title="English posts only" class="inline-flex min-h-6 min-w-6 items-center justify-center px-1 transition-colors hover:text-[#eab308]">EN</a>
          <a href="/rss/vi.xml" hreflang="vi" title="Vietnamese posts only" class="inline-flex min-h-6 min-w-6 items-center justify-center px-1 transition-colors hover:text-[#eab308]">VI</a>
        </div>
      </div>
    </header>

    <form id="postSearch" role="search" class="mb-6" action="/writing" method="get">
      <label for="postSearchInput" class="sr-only">Search posts</label>
      <div class="relative">
        <input
          id="postSearchInput"
          name="q"
          type="search"
          autocomplete="off"
          spellcheck="false"
          placeholder="Search posts…"
          class="w-full rounded border border-[#27272a] bg-[#111113] px-3 py-2 pr-10 text-base text-zinc-200 placeholder:text-zinc-600 transition-colors focus:border-[#eab308] [&::-webkit-search-cancel-button]:hidden"
        />
        <kbd
          aria-hidden="true"
          class="pointer-events-none absolute top-1/2 right-3 hidden -translate-y-1/2 rounded border border-[#27272a] px-1.5 font-mono text-xs text-zinc-600 sm:block"
          >/</kbd
        >
      </div>
    </form>

    <nav class="mb-5 flex flex-wrap gap-x-3 font-mono text-xs uppercase tracking-wider" aria-label="Tags">
      {
        tags.map(([tag, count]) => (
          <a href={`/writing/tag/${tag}`} class="inline-block py-1 text-zinc-500 transition-colors hover:text-[#eab308]">
            #{tagLabel(tag)} <span class="text-zinc-700">{count}</span>
          </a>
        ))
      }
    </nav>

    <div class="mb-8 flex items-center justify-between border-b border-[#27272a] pb-3 text-xs text-zinc-600">
      <span id="postCount">{blog.length} posts</span>
      <div id="langFilter" class="flex gap-3" role="group" aria-label="Filter by language">
        {
          [
            { lang: "all", label: "All" },
            { lang: "en", label: "English" },
            { lang: "vi", label: "Tiếng Việt" },
          ].map(({ lang, label }) => (
            <button
              type="button"
              data-lang-filter={lang}
              aria-pressed={lang === "all" ? "true" : "false"}
              class="cursor-pointer transition-colors hover:text-zinc-200 aria-pressed:text-[#eab308]"
            >
              {label}
            </button>
          ))
        }
      </div>
    </div>

    <div id="searchResults" class="hidden" aria-live="polite">
      <ol id="searchResultList" class="space-y-6"></ol>
      <p id="searchStatus" class="text-sm text-zinc-500"></p>
    </div>

    <div id="blogPosts" class="space-y-9">
      {
        years.map((year) => (
          <section data-year={year}>
            <h2 class="mb-2 text-base font-medium text-zinc-200">{year}</h2>
            <ol>
              {postsByYear[year].map((post) => (
                <li data-lang={post.data.lang || "en"}>
                  <a
                    data-astro-prefetch
                    href={`/writing/${post.id}`}
                    class="group grid grid-cols-[1fr_auto] items-baseline gap-4 py-2 focus-visible:outline-none"
                  >
                    <span class="min-w-0 text-base leading-snug text-zinc-400 transition-colors group-hover:text-zinc-100">
                      {post.data.draft && <span class="mr-2 text-xs text-[#eab308]">Draft</span>}
                      {post.data.title}
                    </span>
                    <time datetime={post.data.date.toISOString()} title={post.data.date.toISOString()} class="font-mono text-xs text-zinc-600">
                      {format(new Date(post.data.date), "MMM dd")}
                    </time>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </div>
  </Container>

<script>
  function initLanguageFilter() {
    const filter = document.getElementById("langFilter");
    const container = document.getElementById("blogPosts");
    const countLabel = document.getElementById("postCount");
    if (!filter || !container || !countLabel) return;
    const postsContainer = container;
    const count = countLabel;
    if (filter.dataset.filterInitialized === "true") return;

    const buttons = Array.from(
      filter.querySelectorAll<HTMLButtonElement>("[data-lang-filter]"),
    );

    function filterPosts(lang: string) {
      let visible = 0;
      postsContainer.querySelectorAll<HTMLLIElement>("li[data-lang]").forEach((item) => {
        const show = lang === "all" || item.dataset.lang === lang;
        item.style.display = show ? "" : "none";
        if (show) visible++;
      });

      postsContainer.querySelectorAll<HTMLElement>("[data-year]").forEach((section) => {
        const hasVisiblePosts = Array.from(
          section.querySelectorAll<HTMLLIElement>("li[data-lang]"),
        ).some((post) => post.style.display !== "none");
        section.style.display = hasVisiblePosts ? "" : "none";
      });

      buttons.forEach((button) =>
        button.setAttribute("aria-pressed", String(button.dataset.langFilter === lang)),
      );
      count.textContent = `${visible} posts`;
    }

    filter.dataset.filterInitialized = "true";
    buttons.forEach((button) =>
      button.addEventListener("click", () => filterPosts(button.dataset.langFilter ?? "all")),
    );
  }

  document.addEventListener("astro:page-load", initLanguageFilter);

  // Full-text search over the static Pagefind index built after `astro build`
  // (see pagefind.yml). The index only exists in built output, not under `astro dev`.
  type PagefindResult = {
    url: string;
    excerpt: string;
    meta: { title?: string; date?: string };
    filters: { lang?: string[] };
  };
  type Pagefind = {
    init: () => Promise<void>;
    debouncedSearch: (
      term: string,
      options?: { filters?: Record<string, string> },
      timeout?: number,
    ) => Promise<{ results: { data: () => Promise<PagefindResult> }[] } | null>;
  };

  let pagefindPromise: Promise<Pagefind> | undefined;
  function loadPagefind() {
    pagefindPromise ??= import(/* @vite-ignore */ "/pagefind/pagefind.js" as string).then(
      async (module: Pagefind) => {
        await module.init();
        return module;
      },
    );
    return pagefindPromise;
  }

  const MAX_RESULTS = 20;
  const dateFormat = new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "2-digit",
    year: "numeric",
    timeZone: "UTC",
  });

  function escapeHtml(text: string) {
    return text.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
  }

  function initSearch() {
    const form = document.getElementById("postSearch") as HTMLFormElement | null;
    const input = document.getElementById("postSearchInput") as HTMLInputElement | null;
    const panel = document.getElementById("searchResults");
    const list = document.getElementById("searchResultList");
    const status = document.getElementById("searchStatus");
    const posts = document.getElementById("blogPosts");
    const count = document.getElementById("postCount");
    const filter = document.getElementById("langFilter");
    if (!form || !input || !panel || !list || !status || !posts || !count || !filter) return;
    if (form.dataset.searchInitialized === "true") return;
    form.dataset.searchInitialized = "true";

    const searchInput = input;
    let latest = 0;

    const currentLang = () =>
      (filter.querySelector('[aria-pressed="true"]') as HTMLElement | null)?.dataset.langFilter ??
      "all";

    function syncUrl(term: string) {
      const url = new URL(window.location.href);
      if (term) url.searchParams.set("q", term);
      else url.searchParams.delete("q");
      history.replaceState(history.state, "", url);
    }

    async function run() {
      const term = searchInput.value.trim();
      const id = ++latest;
      syncUrl(term);

      if (!term) {
        panel!.classList.add("hidden");
        posts!.classList.remove("hidden");
        // Clicking the active language button makes the filter recount the visible posts.
        (filter!.querySelector('[aria-pressed="true"]') as HTMLElement | null)?.click();
        return;
      }

      panel!.classList.remove("hidden");
      posts!.classList.add("hidden");

      let pagefind: Pagefind;
      try {
        pagefind = await loadPagefind();
      } catch {
        if (id !== latest) return;
        list!.innerHTML = "";
        status!.textContent = "Search isn’t available right now.";
        count!.textContent = "";
        return;
      }

      const lang = currentLang();
      const search = await pagefind.debouncedSearch(
        term,
        lang === "all" ? {} : { filters: { lang } },
        150,
      );
      // null means a newer keystroke superseded this search.
      if (!search || id !== latest) return;

      const results = await Promise.all(search.results.slice(0, MAX_RESULTS).map((r) => r.data()));
      if (id !== latest) return;

      list!.innerHTML = results
        .map((r) => {
          const href = r.url.replace(/\/$/, "");
          const lang = r.filters.lang?.[0] ?? "en";
          const date = r.meta.date ? dateFormat.format(new Date(r.meta.date)) : "";
          return `<li>
            <a href="${escapeHtml(href)}" hreflang="${escapeHtml(lang)}" class="group block focus-visible:outline-none">
              <span class="flex items-baseline justify-between gap-4">
                <span class="min-w-0 text-base leading-snug text-zinc-200 transition-colors group-hover:text-[#eab308]">${escapeHtml(r.meta.title ?? href)}</span>
                <span class="shrink-0 font-mono text-xs text-zinc-600">${date}</span>
              </span>
              <span class="search-excerpt mt-1 block text-sm leading-6 text-zinc-500">${r.excerpt}</span>
            </a>
          </li>`;
        })
        .join("");

      const total = search.results.length;
      count!.textContent = `${total} ${total === 1 ? "result" : "results"}`;
      status!.textContent =
        total === 0
          ? `No posts match “${term}”.`
          : total > MAX_RESULTS
            ? `Showing the top ${MAX_RESULTS}.`
            : "";
    }

    searchInput.addEventListener("input", run);
    searchInput.addEventListener("focus", () => void loadPagefind().catch(() => {}), { once: true });
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      void run();
    });
    searchInput.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && searchInput.value) {
        searchInput.value = "";
        void run();
      }
    });
    // Re-run the search when the language filter changes.
    filter.addEventListener("click", () => {
      if (searchInput.value.trim()) void run();
    });

    const initial = new URLSearchParams(window.location.search).get("q");
    if (initial) {
      searchInput.value = initial;
      void run();
    }
  }

  // "/" focuses the search box, unless the user is already typing somewhere.
  function onSlash(event: KeyboardEvent) {
    if (event.key !== "/" || event.metaKey || event.ctrlKey || event.altKey) return;
    const target = event.target as HTMLElement | null;
    if (target?.closest("input, textarea, select, [contenteditable]")) return;
    const input = document.getElementById("postSearchInput") as HTMLInputElement | null;
    if (!input) return;
    event.preventDefault();
    input.focus();
  }

  document.addEventListener("astro:page-load", initSearch);
  document.addEventListener("keydown", onSlash);
</script>
</Layout>
