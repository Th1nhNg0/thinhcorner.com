---
export const prerender = true;
import Container from "@/components/Container.astro";
import Layout from "@/layouts/Layout.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import PostRow from "@/components/PostRow.astro";
import { tagLabel } from "@/lib/tags";

export async function getStaticPaths() {
  const posts = (await getCollection("writing"))
    .filter((p) => !p.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

type Props = { posts: CollectionEntry<"writing">[] };
const { posts } = Astro.props;
const { tag } = Astro.params;
const label = tagLabel(tag);
const description = `Posts about ${label.toLowerCase() === "ai" ? "AI" : label.toLowerCase()} on Thinh's Corner, in English and Vietnamese.`;
const url = new URL(`/writing/tag/${tag}`, Astro.site).toString();
---

<Layout
  title={`${label} — Writing — Thinh's Corner`}
  description={description}
  image="/og/writing.jpg"
  lang="en"
  locale="en_US"
  structuredData={[
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      name: `${label} posts`,
      description,
      url,
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site).toString() },
        { "@type": "ListItem", position: 2, name: "Writing", item: new URL("/writing", Astro.site).toString() },
        { "@type": "ListItem", position: 3, name: label, item: url },
      ],
    },
  ]}
>
  <Container>
    <header class="page-header">
      <a href="/writing" class="page-kicker arrow-link transition-colors hover:text-[#eab308]"><span class="arrow" aria-hidden="true">←</span> Writing</a>
      <h1 class="page-title mt-3">{label}</h1>
      <p class="page-intro">{posts.length} {posts.length === 1 ? "post" : "posts"} tagged {label}.</p>
    </header>

    <ol class="border-t border-[#27272a]">
      {
        posts.map((post) => (
          <li>
            <PostRow post={post} />
          </li>
        ))
      }
    </ol>
  </Container>
</Layout>
