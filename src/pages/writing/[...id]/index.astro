---
export const prerender = true;
import Container from "@/components/Container.astro";
import Layout from "@/layouts/Layout.astro";
import type { CollectionEntry } from "astro:content";
import { AUTHOR_NAME } from "../../../../data/consts";
import { getCollection, render } from "astro:content";
import { format } from "date-fns";
import getReadingTime from "reading-time";
import { getModifiedDate } from "@/lib/post-dates";
import EditOnGithub from "../../../components/EditOnGithub.astro";
import { getRelatedPosts, tagLabel } from "@/lib/tags";
import PostRow from "@/components/PostRow.astro";

export async function getStaticPaths() {
  const paths = (await getCollection("writing")).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );
  return paths.map((post) => ({
    params: { id: post.id },
    props: post,
  }));
}
type Props = CollectionEntry<"writing">;

const post = Astro.props;
const postLang = post.data.lang ?? "en";

// Newer/Older links stay within the post's language.
const posts = (await getCollection("writing"))
  .filter((p) => (p.data.lang ?? "en") === postLang)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function getNextPost() {
  const idx = posts.findIndex((p) => p.id === Astro.params.id);
  return idx !== -1 ? posts[idx + 1] : undefined;
}

function getPrevPost() {
  const idx = posts.findIndex((p) => p.id === Astro.params.id);
  return idx > 0 ? posts[idx - 1] : undefined;
}

const nextPost = getNextPost();
const relatedPosts = getRelatedPosts(post, await getCollection("writing"));
const prevPost = getPrevPost();

const { Content, headings } = await render(post);
// Only long posts get a table of contents.
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const showToc = tocHeadings.filter((h) => h.depth === 2).length >= 4;
const minutesRead = post.body ? getReadingTime(post.body).text : undefined;
const tocLabel = postLang === "vi" ? "Mục lục" : "On this page";

const modifiedTime = getModifiedDate(post).toISOString();

// Detect math content without mistaking escaped currency or MDX `${...}` expressions for math.
const hasMath = post.body
  ? /(?<!\\)\$\$|(?<![\\\w])\$(?!\{)[^\n$]+\$(?!\w)|(?<!\\)\\\[|(?<!\\)\\\(/.test(
      post.body,
    )
  : false;

let slug = Array.isArray(Astro.params.id)
  ? Astro.params.id[0]
  : Astro.params.id;
---

<Layout
  title={post.data.title}
  description={post.data.description}
  image={`/writing/${post.id}/og.jpg`}
  type="article"
  katex={hasMath}
  robots={post.data.draft ? "noindex,nofollow" : undefined}
  lang={postLang}
  locale={postLang === "vi" ? "vi_VN" : "en_US"}
  author={AUTHOR_NAME}
  publishedTime={post.data.date.toISOString()}
  modifiedTime={modifiedTime}
  imageAlt={post.data.title}
  tags={post.data.tags.map(tagLabel)}
  structuredData={[
    {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: post.data.title,
      description: post.data.description,
      image: new URL(`/writing/${post.id}/og.jpg`, Astro.site).toString(),
      author: {
        "@type": "Person",
        name: AUTHOR_NAME,
        url: new URL("/", Astro.site).toString(),
      },
      publisher: {
        "@type": "Person",
        name: AUTHOR_NAME,
        url: new URL("/", Astro.site).toString(),
      },
      datePublished: post.data.date.toISOString(),
      dateModified: modifiedTime,
      mainEntityOfPage: new URL(`/writing/${post.id}`, Astro.site).toString(),
      url: new URL(`/writing/${post.id}`, Astro.site).toString(),
      inLanguage: postLang,
      ...(post.data.tags.length > 0 && {
        keywords: post.data.tags.map(tagLabel).join(", "),
      }),
      ...(minutesRead && {
        timeRequired: `PT${Math.ceil(parseInt(minutesRead))}M`,
      }),
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: new URL("/", Astro.site).toString(),
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Writing",
          item: new URL("/writing", Astro.site).toString(),
        },
        {
          "@type": "ListItem",
          position: 3,
          name: post.data.title,
          item: new URL(`/writing/${post.id}`, Astro.site).toString(),
        },
      ],
    },
  ]}
>
  <Container>
    {
      post.data.draft && (
        <div class="mb-5 border border-[#eab308]/30 bg-[#eab308]/5 px-3 py-2 text-sm text-[#eab308]">
          <p>Draft: this post may be incomplete or contain incorrect information.</p>
        </div>
      )
    }
    <div class="grid gap-x-12 lg:grid-cols-[minmax(0,45rem)_minmax(0,1fr)]">
      <div class="min-w-0">
        <article
          aria-labelledby="post-title"
          data-pagefind-body={post.data.draft ? undefined : ""}
          data-pagefind-filter={`lang:${postLang}`}
          data-pagefind-meta={`date:${post.data.date.toISOString()}`}
        >
          <header class="mb-8 border-b border-[#27272a] pb-7 pt-2 sm:pt-6">
            <a
              href="/writing"
              data-pagefind-ignore
              class="page-kicker arrow-link transition-colors hover:text-[#eab308]"
              ><span class="arrow" aria-hidden="true">←</span> Writing</a
            >
            <h1
              id="post-title"
              class="mt-4 text-[clamp(1.875rem,6vw,3rem)] font-semibold leading-[1.08] tracking-[-0.04em] text-zinc-100"
            >
              {post.data.title}
            </h1>
            <p
              data-pagefind-ignore
              class="mt-4 text-[1.0625rem] leading-[1.6] text-zinc-400 sm:text-lg sm:leading-[1.6]"
            >
              {post.data.description}
            </p>
            <div
              data-pagefind-ignore
              class="mt-5 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-zinc-500 lg:hidden"
            >
              <time datetime={post.data.date.toISOString()} title={post.data.date.toISOString()}>
                {format(post.data.date, "MMM dd, yyyy")}
              </time>
              {
                post.data.updated && (
                  <>
                    <span aria-hidden="true">·</span>
                    <span>
                      {postLang === "vi" ? "Cập nhật" : "Updated"}{" "}
                      <time datetime={post.data.updated.toISOString()}>
                        {format(post.data.updated, "MMM dd, yyyy")}
                      </time>
                    </span>
                  </>
                )
              }
              {
                minutesRead && (
                  <>
                    <span aria-hidden="true">·</span>
                    <span>{minutesRead}</span>
                  </>
                )
              }
              {
                post.data.tags.map((tag) => (
                  <>
                    <span aria-hidden="true">·</span>
                    <a
                      href={`/writing/tag/${tag}`}
                      class="inline-flex min-h-6 items-center transition-colors hover:text-[#eab308]"
                    >
                      {tagLabel(tag)}
                    </a>
                  </>
                ))
              }
            </div>
          </header>
          {
            showToc && (
              <details data-pagefind-ignore class="mb-8 rounded border border-[#27272a] px-4 py-3 text-sm lg:hidden">
                <summary class="cursor-pointer text-zinc-400 transition-colors hover:text-zinc-200">
                  {tocLabel}
                </summary>
                <ol class="mt-3 space-y-1.5">
                  {tocHeadings.map((h) => (
                    <li class:list={[h.depth === 3 && "pl-4"]}>
                      <a
                        href={`#${h.slug}`}
                        class="text-zinc-400 transition-colors hover:text-[#eab308]"
                      >
                        {h.text}
                      </a>
                    </li>
                  ))}
                </ol>
              </details>
            )
          }
          <div
            class="prose max-w-none prose-invert prose-headings:mb-3 prose-headings:leading-tight prose-h2:mt-11 prose-h3:mt-8 prose-h4:mt-6 prose-p:my-4 prose-p:leading-[1.75] prose-ul:my-4 prose-ol:my-4 prose-li:my-1 prose-blockquote:my-6 prose-figure:my-6 prose-pre:my-5 prose-hr:my-10 prose-code:before:content-[''] prose-code:after:content-[''] prose-img:mx-auto prose-img:my-6 prose-video:my-6 prose-table:my-5 prose-table:text-xs"
          >
            <Content />
          </div>
        </article>

        <EditOnGithub slug={slug} />

        {
          relatedPosts.length > 0 && (
            <section class="mb-10" aria-labelledby="related-heading">
              <h2 id="related-heading" class="star-heading mb-2">
                {postLang === "vi" ? "Bài liên quan" : "Related"}
              </h2>
              <ul class="border-t border-[#1f1f23]">
                {relatedPosts.map((p) => (
                  <li>
                    <PostRow post={p} description={false} />
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <nav class="grid gap-x-8 gap-y-5 border-t border-[#27272a] pt-5 sm:grid-cols-2" aria-label="Post navigation">
          {
            prevPost ? (
              <a href={`/writing/${prevPost.id}`} class="arrow-link group block">
                <div class="text-sm text-zinc-500">
                  <span class="arrow" aria-hidden="true">←</span> {postLang === "vi" ? "Mới hơn" : "Newer"}
                </div>
                <div class="mt-1 line-clamp-2 font-medium text-zinc-200 transition-colors group-hover:text-[#eab308]">
                  {prevPost.data.title}
                </div>
              </a>
            ) : (
              <span class="hidden sm:block" />
            )
          }
          {
            nextPost && (
              <a href={`/writing/${nextPost.id}`} class="arrow-link group block sm:text-right">
                <div class="text-sm text-zinc-500">
                  {postLang === "vi" ? "Cũ hơn" : "Older"} <span class="arrow" aria-hidden="true">→</span>
                </div>
                <div class="mt-1 line-clamp-2 font-medium text-zinc-200 transition-colors group-hover:text-[#eab308]">
                  {nextPost.data.title}
                </div>
              </a>
            )
          }
        </nav>
      </div>

      <aside class="hidden lg:block" aria-label={postLang === "vi" ? "Thông tin bài viết" : "About this post"}>
        <div class="post-rail">
          <dl class="space-y-3 text-sm">
            <div>
              <dt class="text-xs text-zinc-600">{postLang === "vi" ? "Ngày đăng" : "Published"}</dt>
              <dd class="text-zinc-300">
                <time datetime={post.data.date.toISOString()} title={post.data.date.toISOString()}>
                  {format(post.data.date, "MMM dd, yyyy")}
                </time>
              </dd>
            </div>
            {
              post.data.updated && (
                <div>
                  <dt class="text-xs text-zinc-600">{postLang === "vi" ? "Cập nhật" : "Updated"}</dt>
                  <dd class="text-zinc-300">
                    <time datetime={post.data.updated.toISOString()}>
                      {format(post.data.updated, "MMM dd, yyyy")}
                    </time>
                  </dd>
                </div>
              )
            }
            {
              minutesRead && (
                <div>
                  <dt class="text-xs text-zinc-600">{postLang === "vi" ? "Thời gian đọc" : "Reading time"}</dt>
                  <dd class="text-zinc-300">{minutesRead}</dd>
                </div>
              )
            }
            {
              post.data.tags.length > 0 && (
                <div>
                  <dt class="text-xs text-zinc-600">{postLang === "vi" ? "Chủ đề" : "Topics"}</dt>
                  <dd class="flex flex-wrap gap-x-3">
                    {post.data.tags.map((tag) => (
                      <a
                        href={`/writing/tag/${tag}`}
                        class="text-zinc-300 underline decoration-[#3f3f46] underline-offset-4 transition-colors hover:text-[#eab308] hover:decoration-[#eab308]"
                      >
                        {tagLabel(tag)}
                      </a>
                    ))}
                  </dd>
                </div>
              )
            }
          </dl>
          {
            showToc && (
              <nav class="mt-8" aria-labelledby="toc-heading">
                <h2 id="toc-heading" class="text-xs text-zinc-600">
                  {tocLabel}
                </h2>
                <ol id="postToc" class="post-toc mt-2">
                  {tocHeadings.map((h) => (
                    <li>
                      <a href={`#${h.slug}`} class:list={[h.depth === 3 && "post-toc-sub"]}>
                        {h.text}
                      </a>
                    </li>
                  ))}
                </ol>
              </nav>
            )
          }
        </div>
      </aside>
    </div>
    <script>
      // Highlight the section being read in the side table of contents.
      let tocLinks = new Map<string, HTMLAnchorElement>();
      let tocHeadings: HTMLElement[] = [];
      let tocTicking = false;

      const updateToc = () => {
        tocTicking = false;
        if (tocHeadings.length === 0) return;
        // The current section is the last heading that has scrolled past the top third.
        const line = window.innerHeight * 0.3;
        let current = tocHeadings[0];
        for (const h of tocHeadings) {
          if (h.getBoundingClientRect().top <= line) current = h;
          else break;
        }
        tocLinks.forEach((a, id) => {
          if (id !== current.id) {
            a.removeAttribute("aria-current");
          } else if (!a.hasAttribute("aria-current")) {
            a.setAttribute("aria-current", "location");
            // Long tables of contents scroll inside the rail; keep the current entry visible.
            const rail = a.closest<HTMLElement>(".post-rail");
            if (rail && rail.scrollHeight > rail.clientHeight) {
              rail.scrollTo({ top: a.offsetTop - rail.clientHeight / 2 });
            }
          }
        });
      };

      const initTocSpy = () => {
        tocLinks = new Map();
        document
          .querySelectorAll<HTMLAnchorElement>("#postToc a[href^='#']")
          .forEach((a) => tocLinks.set(decodeURIComponent(a.hash.slice(1)), a));
        tocHeadings = [...tocLinks.keys()]
          .map((id) => document.getElementById(id))
          .filter((el): el is HTMLElement => el !== null);
        updateToc();
      };

      // One listener for the whole session; it does nothing on pages without a contents list.
      window.addEventListener(
        "scroll",
        () => {
          if (tocTicking || tocHeadings.length === 0) return;
          tocTicking = true;
          requestAnimationFrame(updateToc);
        },
        { passive: true },
      );

      document.addEventListener("astro:page-load", initTocSpy);
    </script>
    <script>
      // Lazy-load medium-zoom after the page is idle for better LCP/TBT.
      // astro:page-load also runs after ClientRouter navigations.
      const initMediumZoom = () => {
        const load = () => {
          const imageSelectors = [
            ...document.querySelectorAll("article .prose img"),
            ...document.querySelectorAll("[data-zoomable]"),
          ] as HTMLElement[];

          if (imageSelectors.length === 0) return;

          import("medium-zoom").then(({ default: mediumZoom }) => {
            mediumZoom(imageSelectors, {
              background: "var(--color-zinc-950)",
            });
          });
        };

        if ("requestIdleCallback" in window) {
          (window as any).requestIdleCallback(load);
        } else {
          setTimeout(load, 200);
        }
      };

      document.addEventListener("astro:page-load", initMediumZoom);

      // Add a copy button to every code block. The button sits in a wrapper rather than
      // inside <pre>, so it stays put when a long line scrolls horizontally.
      const initCodeCopy = () => {
        const blocks = document.querySelectorAll("article .prose pre") as NodeListOf<HTMLPreElement>;
        blocks.forEach((pre) => {
          if (pre.parentElement?.classList.contains("code-block")) return;

          const wrapper = document.createElement("div");
          wrapper.className = "code-block";
          pre.parentNode?.insertBefore(wrapper, pre);
          wrapper.appendChild(pre);

          const button = document.createElement("button");
          button.type = "button";
          button.className = "code-copy";
          button.textContent = "Copy";
          button.setAttribute("aria-label", "Copy code to clipboard");
          wrapper.appendChild(button);

          let reset: ReturnType<typeof setTimeout> | undefined;
          button.addEventListener("click", async () => {
            const text = (pre.querySelector("code") ?? pre).textContent ?? "";
            try {
              await navigator.clipboard.writeText(text.replace(/\n$/, ""));
              button.textContent = "Copied";
            } catch {
              button.textContent = "Failed";
            }
            button.dataset.state = "done";
            clearTimeout(reset);
            reset = setTimeout(() => {
              button.textContent = "Copy";
              delete button.dataset.state;
            }, 1600);
          });
        });
      };

      document.addEventListener("astro:page-load", initCodeCopy);
    </script>
  </Container>
</Layout>
