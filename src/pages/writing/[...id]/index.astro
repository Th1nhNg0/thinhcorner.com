---
export const prerender = true;
import Container from "@/components/Container.astro";
import Layout from "@/layouts/Layout.astro";
import type { CollectionEntry } from "astro:content";
import { AUTHOR_NAME } from "../../../../data/consts";
import { getCollection, render } from "astro:content";
import { format } from "date-fns";
import getReadingTime from "reading-time";
import { getModifiedDate } from "@/lib/post-dates";
import EditOnGithub from "../../../components/EditOnGithub.astro";
import { getRelatedPosts, tagLabel } from "@/lib/tags";

export async function getStaticPaths() {
  const paths = (await getCollection("writing")).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );
  return paths.map((post) => ({
    params: { id: post.id },
    props: post,
  }));
}
type Props = CollectionEntry<"writing">;

const post = Astro.props;
const postLang = post.data.lang ?? "en";

// Newer/Older links stay within the post's language.
const posts = (await getCollection("writing"))
  .filter((p) => (p.data.lang ?? "en") === postLang)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function getNextPost() {
  const idx = posts.findIndex((p) => p.id === Astro.params.id);
  return idx !== -1 ? posts[idx + 1] : undefined;
}

function getPrevPost() {
  const idx = posts.findIndex((p) => p.id === Astro.params.id);
  return idx > 0 ? posts[idx - 1] : undefined;
}

const nextPost = getNextPost();
const relatedPosts = getRelatedPosts(post, await getCollection("writing"));
const prevPost = getPrevPost();

const { Content, headings } = await render(post);
// Only long posts get a table of contents.
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const showToc = tocHeadings.filter((h) => h.depth === 2).length >= 4;
const minutesRead = post.body ? getReadingTime(post.body).text : undefined;

const modifiedTime = getModifiedDate(post).toISOString();

// Detect math content without mistaking escaped currency or MDX `${...}` expressions for math.
const hasMath = post.body
  ? /(?<!\\)\$\$|(?<![\\\w])\$(?!\{)[^\n$]+\$(?!\w)|(?<!\\)\\\[|(?<!\\)\\\(/.test(
      post.body,
    )
  : false;

let slug = Array.isArray(Astro.params.id)
  ? Astro.params.id[0]
  : Astro.params.id;
---

<Layout
  title={post.data.title}
  description={post.data.description}
  image={`/writing/${post.id}/og.jpg`}
  type="article"
  katex={hasMath}
  robots={post.data.draft ? "noindex,nofollow" : undefined}
  lang={postLang}
  locale={postLang === "vi" ? "vi_VN" : "en_US"}
  author={AUTHOR_NAME}
  publishedTime={post.data.date.toISOString()}
  modifiedTime={modifiedTime}
  imageAlt={post.data.title}
  tags={post.data.tags.map(tagLabel)}
  structuredData={[
    {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: post.data.title,
      description: post.data.description,
      image: new URL(`/writing/${post.id}/og.jpg`, Astro.site).toString(),
      author: {
        "@type": "Person",
        name: AUTHOR_NAME,
        url: new URL("/", Astro.site).toString(),
      },
      publisher: {
        "@type": "Person",
        name: AUTHOR_NAME,
        url: new URL("/", Astro.site).toString(),
      },
      datePublished: post.data.date.toISOString(),
      dateModified: modifiedTime,
      mainEntityOfPage: new URL(`/writing/${post.id}`, Astro.site).toString(),
      url: new URL(`/writing/${post.id}`, Astro.site).toString(),
      inLanguage: postLang,
      ...(post.data.tags.length > 0 && {
        keywords: post.data.tags.map(tagLabel).join(", "),
      }),
      ...(minutesRead && {
        timeRequired: `PT${Math.ceil(parseInt(minutesRead))}M`,
      }),
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: new URL("/", Astro.site).toString(),
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Writing",
          item: new URL("/writing", Astro.site).toString(),
        },
        {
          "@type": "ListItem",
          position: 3,
          name: post.data.title,
          item: new URL(`/writing/${post.id}`, Astro.site).toString(),
        },
      ],
    },
  ]}
>
  <Container>
    {
      post.data.draft && (
        <div class="mb-5 border border-[#eab308]/30 bg-[#eab308]/5 px-3 py-2 text-[#eab308]">
          <p class="font-mono text-xs uppercase tracking-wider">
            Draft — this post may be incomplete or contain incorrect
            information.
          </p>
        </div>
      )
    }
    <article
      aria-labelledby="post-title"
      data-pagefind-body={post.data.draft ? undefined : ""}
      data-pagefind-filter={`lang:${postLang}`}
      data-pagefind-meta={`date:${post.data.date.toISOString()}`}
    >
      <header class="mb-8 border-b border-[#27272a] pb-6">
        <a
          href="/writing"
          data-pagefind-ignore
          class="page-kicker transition-colors hover:text-white"
          >Writing / {postLang}</a
        >
        <h1
          id="post-title"
          class="mt-3 max-w-3xl text-[clamp(1.75rem,6vw,2.75rem)] font-semibold leading-[1.08] tracking-[-0.04em] text-zinc-100"
        >
          {post.data.title}
        </h1>
        <div
          data-pagefind-ignore
          class="mt-4 flex items-center gap-2 font-mono text-xs uppercase tracking-wider text-zinc-600"
        >
          <time
            datetime={post.data.date.toISOString()}
            title={post.data.date.toISOString()}
          >
            {format(new Date(post.data.date), "dd MMMM yyyy")}
          </time>
          {
            post.data.updated && (
              <>
                <span aria-hidden="true">/</span>
                <span>
                  Updated{" "}
                  <time datetime={post.data.updated.toISOString()}>
                    {format(post.data.updated, "dd MMMM yyyy")}
                  </time>
                </span>
              </>
            )
          }
          {
            post.body && (
              <>
                <>
                  <span aria-hidden="true">/</span>
                  <span>{minutesRead}</span>
                </>
              </>
            )
          }
        </div>
        {
          post.data.tags.length > 0 && (
            <ul data-pagefind-ignore class="mt-3 flex flex-wrap gap-x-3 gap-y-1 font-mono text-xs uppercase tracking-wider" aria-label="Tags">
              {post.data.tags.map((tag) => (
                <li>
                  <a
                    href={`/writing/tag/${tag}`}
                    class="text-zinc-500 transition-colors hover:text-[#eab308]"
                  >
                    #{tagLabel(tag)}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </header>
      {
        showToc && (
          <details data-pagefind-ignore class="mb-8 border border-[#27272a] px-4 py-3 text-sm">
            <summary class="cursor-pointer font-mono text-xs uppercase tracking-wider text-zinc-500 transition-colors hover:text-zinc-200">
              {postLang === "vi" ? "Mục lục" : "Contents"}
            </summary>
            <ol class="mt-3 space-y-1.5">
              {tocHeadings.map((h) => (
                <li class:list={[h.depth === 3 && "pl-4"]}>
                  <a
                    href={`#${h.slug}`}
                    class="text-zinc-400 transition-colors hover:text-[#eab308]"
                  >
                    {h.text}
                  </a>
                </li>
              ))}
            </ol>
          </details>
        )
      }
      <div
        class="prose max-w-none prose-invert prose-headings:mt-7 prose-headings:mb-3 prose-headings:leading-tight prose-p:my-3 prose-p:leading-7 prose-ul:my-3 prose-ol:my-3 prose-li:my-1 prose-blockquote:my-5 prose-figure:my-5 prose-pre:my-4 prose-hr:my-8 prose-code:before:content-[''] prose-code:after:content-[''] prose-img:mx-auto prose-img:my-5 prose-video:my-5 prose-table:my-4 prose-table:text-xs"
      >
        <Content />
      </div>
    </article>

    <EditOnGithub slug={slug} />

    {
      relatedPosts.length > 0 && (
        <section class="mb-8" aria-labelledby="related-heading">
          <h2
            id="related-heading"
            class="mb-2 font-mono text-xs uppercase tracking-wider text-zinc-600"
          >
            {postLang === "vi" ? "Bài liên quan" : "Related"}
          </h2>
          <ul>
            {relatedPosts.map((p) => (
              <li>
                <a
                  href={`/writing/${p.id}`}
                  hreflang={p.data.lang ?? "en"}
                  class="block py-1.5 text-sm text-zinc-400 transition-colors hover:text-[#eab308]"
                >
                  {p.data.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <nav
      class="grid border-y border-[#27272a] sm:grid-cols-2"
      aria-label="Post navigation"
    >
      {
        prevPost ? (
          <a
            href={`/writing/${prevPost.id}`}
            class="group px-3 py-4 transition-colors hover:bg-[#111113] sm:border-r sm:border-[#27272a]"
          >
            <div class="font-mono text-xs uppercase tracking-wider text-zinc-600">
              Newer
            </div>
            <div class="mt-1 line-clamp-2 text-sm text-zinc-300 group-hover:text-[#eab308]">
              {prevPost.data.title}
            </div>
          </a>
        ) : (
          <span />
        )
      }
      {
        nextPost && (
          <a
            href={`/writing/${nextPost.id}`}
            class="group px-3 py-4 text-right transition-colors hover:bg-[#111113]"
          >
            <div class="font-mono text-xs uppercase tracking-wider text-zinc-600">
              Older
            </div>
            <div class="mt-1 line-clamp-2 text-sm text-zinc-300 group-hover:text-[#eab308]">
              {nextPost.data.title}
            </div>
          </a>
        )
      }
    </nav>
    <script>
      // Lazy-load medium-zoom after the page is idle for better LCP/TBT.
      // astro:page-load also runs after ClientRouter navigations.
      const initMediumZoom = () => {
        const load = () => {
          const imageSelectors = [
            ...document.querySelectorAll("article .prose img"),
            ...document.querySelectorAll("[data-zoomable]"),
          ] as HTMLElement[];

          if (imageSelectors.length === 0) return;

          import("medium-zoom").then(({ default: mediumZoom }) => {
            mediumZoom(imageSelectors, {
              background: "var(--color-zinc-950)",
            });
          });
        };

        if ("requestIdleCallback" in window) {
          (window as any).requestIdleCallback(load);
        } else {
          setTimeout(load, 200);
        }
      };

      document.addEventListener("astro:page-load", initMediumZoom);

      // Add a copy button to every code block. The button sits in a wrapper rather than
      // inside <pre>, so it stays put when a long line scrolls horizontally.
      const initCodeCopy = () => {
        const blocks = document.querySelectorAll("article .prose pre") as NodeListOf<HTMLPreElement>;
        blocks.forEach((pre) => {
          if (pre.parentElement?.classList.contains("code-block")) return;

          const wrapper = document.createElement("div");
          wrapper.className = "code-block";
          pre.parentNode?.insertBefore(wrapper, pre);
          wrapper.appendChild(pre);

          const button = document.createElement("button");
          button.type = "button";
          button.className = "code-copy";
          button.textContent = "Copy";
          button.setAttribute("aria-label", "Copy code to clipboard");
          wrapper.appendChild(button);

          let reset: ReturnType<typeof setTimeout> | undefined;
          button.addEventListener("click", async () => {
            const text = (pre.querySelector("code") ?? pre).textContent ?? "";
            try {
              await navigator.clipboard.writeText(text.replace(/\n$/, ""));
              button.textContent = "Copied";
            } catch {
              button.textContent = "Failed";
            }
            button.dataset.state = "done";
            clearTimeout(reset);
            reset = setTimeout(() => {
              button.textContent = "Copy";
              delete button.dataset.state;
            }, 1600);
          });
        });
      };

      document.addEventListener("astro:page-load", initCodeCopy);
    </script>
  </Container>
</Layout>
