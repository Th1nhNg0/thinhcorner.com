---
export const prerender = true;
import Container from "@/components/Container.astro";
import Layout from "@/layouts/Layout.astro";
import type { CollectionEntry } from "astro:content";
import { AUTHOR_NAME } from "../../../../data/consts";
import { getCollection, render } from "astro:content";
import { format } from "date-fns";
import getReadingTime from "reading-time";
import { statSync, existsSync } from "node:fs";
import { join } from "node:path";
import EditOnGithub from "../../../components/EditOnGithub.astro";

export async function getStaticPaths() {
  const paths = (await getCollection("blog")).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );
  return paths.map((post) => ({
    params: { id: post.id },
    props: post,
  }));
}
type Props = CollectionEntry<"blog">;

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

function getNextPost() {
  const idx = posts.findIndex((p) => p.id === Astro.params.id);
  return idx !== -1 ? posts[idx + 1] : undefined;
}

function getPrevPost() {
  const idx = posts.findIndex((p) => p.id === Astro.params.id);
  return idx > 0 ? posts[idx - 1] : undefined;
}

const nextPost = getNextPost();
const prevPost = getPrevPost();

const post = Astro.props;
const { Content } = await render(post);
const minutesRead = post.body ? getReadingTime(post.body).text : undefined;

const postDir = join(process.cwd(), "src/content/blog", post.id);
const postFile = ["index.md", "index.mdx"].find((f) =>
  existsSync(join(postDir, f)),
);
const modifiedTime = postFile
  ? statSync(join(postDir, postFile)).mtime.toISOString()
  : post.data.date.toISOString();

// Detect math content without mistaking escaped currency or MDX `${...}` expressions for math.
const hasMath = post.body
  ? /(?<!\\)\$\$|(?<![\\\w])\$(?!\{)[^\n$]+\$(?!\w)|(?<!\\)\\\[|(?<!\\)\\\(/.test(
      post.body,
    )
  : false;

let slug = Array.isArray(Astro.params.id)
  ? Astro.params.id[0]
  : Astro.params.id;
---

<Layout
  title={post.data.title}
  description={post.data.description}
  image={`/writing/${post.id}/og.jpg`}
  type="article"
  katex={hasMath}
  robots={post.data.draft ? "noindex,nofollow" : undefined}
  lang={post.data.lang ?? "en"}
  locale={post.data.lang === "vi" ? "vi_VN" : "en_US"}
  author={AUTHOR_NAME}
  publishedTime={post.data.date.toISOString()}
  modifiedTime={modifiedTime}
  imageAlt={post.data.title}
  prevUrl={prevPost
    ? new URL(`/writing/${prevPost.id}`, Astro.site)
    : undefined}
  nextUrl={nextPost
    ? new URL(`/writing/${nextPost.id}`, Astro.site)
    : undefined}
  structuredData={[
    {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: post.data.title,
      description: post.data.description,
      image: new URL(`/writing/${post.id}/og.jpg`, Astro.site).toString(),
      author: {
        "@type": "Person",
        name: AUTHOR_NAME,
        url: new URL("/", Astro.site).toString(),
      },
      publisher: {
        "@type": "Person",
        name: AUTHOR_NAME,
        url: new URL("/", Astro.site).toString(),
      },
      datePublished: post.data.date.toISOString(),
      dateModified: modifiedTime,
      mainEntityOfPage: new URL(`/writing/${post.id}`, Astro.site).toString(),
      url: new URL(`/writing/${post.id}`, Astro.site).toString(),
      inLanguage: post.data.lang ?? "en",
      ...(minutesRead && {
        timeRequired: `PT${Math.ceil(parseInt(minutesRead))}M`,
      }),
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: new URL("/", Astro.site).toString(),
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Writing",
          item: new URL("/writing", Astro.site).toString(),
        },
        {
          "@type": "ListItem",
          position: 3,
          name: post.data.title,
          item: new URL(`/writing/${post.id}`, Astro.site).toString(),
        },
      ],
    },
  ]}
>
  <Container>
    {
      post.data.draft && (
        <div class="mb-5 border border-[#eab308]/30 bg-[#eab308]/5 px-3 py-2 text-[#eab308]">
          <p class="font-mono text-[10px] uppercase tracking-wider">
            Draft — this post may be incomplete or contain incorrect
            information.
          </p>
        </div>
      )
    }
    <article aria-labelledby="post-title">
      <header class="mb-8 border-b border-[#27272a] pb-6">
        <a
          href="/writing"
          class="page-kicker transition-colors hover:text-white"
          >Writing / {post.data.lang ?? "en"}</a
        >
        <h1
          id="post-title"
          class="mt-3 max-w-3xl text-[clamp(1.75rem,6vw,2.75rem)] font-semibold leading-[1.08] tracking-[-0.04em] text-zinc-100"
        >
          {post.data.title}
        </h1>
        <div
          class="mt-4 flex items-center gap-2 font-mono text-[10px] uppercase tracking-wider text-zinc-600"
        >
          <time
            datetime={post.data.date.toISOString()}
            title={post.data.date.toISOString()}
          >
            {format(new Date(post.data.date), "dd MMMM yyyy")}
          </time>
          {
            post.body && (
              <>
                <>
                  <span aria-hidden="true">/</span>
                  <span>{minutesRead}</span>
                </>
              </>
            )
          }
        </div>
      </header>
      <div
        class="prose prose-sm max-w-none prose-invert prose-headings:mt-7 prose-headings:mb-3 prose-headings:leading-tight prose-p:my-3 prose-p:leading-7 prose-ul:my-3 prose-ol:my-3 prose-li:my-1 prose-blockquote:my-5 prose-figure:my-5 prose-pre:my-4 prose-hr:my-8 prose-code:before:content-[''] prose-code:after:content-[''] prose-img:mx-auto prose-img:my-5 prose-table:my-4 prose-table:text-xs"
      >
        <Content />
      </div>
    </article>

    <EditOnGithub slug={slug} />

    <nav
      class="grid border-y border-[#27272a] sm:grid-cols-2"
      aria-label="Post navigation"
    >
      {
        prevPost ? (
          <a
            href={`/writing/${prevPost.id}`}
            class="group px-3 py-4 transition-colors hover:bg-[#111113] sm:border-r sm:border-[#27272a]"
          >
            <div class="font-mono text-[9px] uppercase tracking-wider text-zinc-600">
              Newer
            </div>
            <div class="mt-1 line-clamp-2 text-xs text-zinc-300 group-hover:text-[#eab308]">
              {prevPost.data.title}
            </div>
          </a>
        ) : (
          <span />
        )
      }
      {
        nextPost && (
          <a
            href={`/writing/${nextPost.id}`}
            class="group px-3 py-4 text-right transition-colors hover:bg-[#111113]"
          >
            <div class="font-mono text-[9px] uppercase tracking-wider text-zinc-600">
              Older
            </div>
            <div class="mt-1 line-clamp-2 text-xs text-zinc-300 group-hover:text-[#eab308]">
              {nextPost.data.title}
            </div>
          </a>
        )
      }
    </nav>
    <script>
      // Lazy-load medium-zoom after the page is idle for better LCP/TBT.
      // astro:page-load also runs after ClientRouter navigations.
      const initMediumZoom = () => {
        const load = () => {
          const imageSelectors = [
            ...document.querySelectorAll("article .prose img"),
            ...document.querySelectorAll("[data-zoomable]"),
          ] as HTMLElement[];

          if (imageSelectors.length === 0) return;

          import("medium-zoom").then(({ default: mediumZoom }) => {
            mediumZoom(imageSelectors, {
              background: "var(--color-zinc-950)",
            });
          });
        };

        if ("requestIdleCallback" in window) {
          (window as any).requestIdleCallback(load);
        } else {
          setTimeout(load, 200);
        }
      };

      document.addEventListener("astro:page-load", initMediumZoom);
    </script>
  </Container>
</Layout>
