---
export const prerender = true;
import Container from "@/components/Container.astro";
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";
import { format } from "date-fns";

const blog = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const postsByYear = blog.reduce(
  (acc, post) => {
    const year = new Date(post.data.date).getFullYear();
    if (!acc[year]) acc[year] = [];
    acc[year].push(post);
    return acc;
  },
  {} as Record<number, typeof blog>,
);

const years = Object.keys(postsByYear).map(Number).sort((a, b) => b - a);
---

<Layout
  description="Read my collection of posts and the things that interest me"
  title="Writing — Thinh's Corner"
  lang="en"
  locale="en_US"
  structuredData={{
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Writing",
    description: "Read my collection of posts and the things that interest me",
    url: new URL("/blog", Astro.site).toString(),
  }}
>
  <Container>
    <header class="page-header">
      <div class="flex items-start justify-between gap-6">
        <div>
          <h1 class="page-title">Writing</h1>
          <p class="page-intro">Notes and essays on technology, research, and things I’m learning.</p>
        </div>
        <a href="/rss.xml" class="mt-2 text-xs text-zinc-500 transition-colors hover:text-[#eab308]">RSS</a>
      </div>
    </header>

    <div class="mb-8 flex items-center justify-between border-b border-[#27272a] pb-3 text-xs text-zinc-600">
      <span>{blog.length} posts</span>
      <label class="flex cursor-pointer select-none items-center gap-2">
        <input type="checkbox" id="englishOnly" class="size-3 accent-[#eab308]" />
        English only
      </label>
    </div>

    <div id="blogPosts" class="space-y-9">
      {
        years.map((year) => (
          <section data-year={year}>
            <h2 class="mb-2 text-sm font-medium text-zinc-200">{year}</h2>
            <ol>
              {postsByYear[year].map((post) => (
                <li data-lang={post.data.lang || "en"}>
                  <a
                    data-astro-prefetch
                    href={`/blog/${post.id}`}
                    class="group grid grid-cols-[1fr_auto] items-baseline gap-4 py-2 focus-visible:outline-none"
                  >
                    <span class="min-w-0 text-sm leading-snug text-zinc-400 transition-colors group-hover:text-zinc-100">
                      {post.data.draft && <span class="mr-2 text-xs text-[#eab308]">Draft</span>}
                      {post.data.title}
                    </span>
                    <time datetime={post.data.date.toISOString()} title={post.data.date.toISOString()} class="font-mono text-[10px] text-zinc-600">
                      {format(new Date(post.data.date), "MMM dd")}
                    </time>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </div>
  </Container>

<script>
  function initEnglishFilter() {
    const checkbox = document.getElementById("englishOnly");
    const blogPostsContainer = document.getElementById("blogPosts");
    if (!(checkbox instanceof HTMLInputElement) || !blogPostsContainer) return;
    const filterCheckbox = checkbox;
    const postsContainer = blogPostsContainer;
    if (filterCheckbox.dataset.filterInitialized === "true") return;

    function filterPosts() {
      postsContainer.querySelectorAll("li[data-lang]").forEach((post) => {
        const item = post as HTMLLIElement;
        item.style.display = filterCheckbox.checked && item.dataset.lang !== "en" ? "none" : "";
      });

      postsContainer.querySelectorAll("[data-year]").forEach((yearSection) => {
        const section = yearSection as HTMLElement;
        const hasVisiblePosts = Array.from(section.querySelectorAll("li[data-lang]")).some(
          (post) => (post as HTMLLIElement).style.display !== "none",
        );
        section.style.display = hasVisiblePosts ? "" : "none";
      });
    }

    filterCheckbox.dataset.filterInitialized = "true";
    filterCheckbox.addEventListener("change", filterPosts);
  }

  document.addEventListener("astro:page-load", initEnglishFilter);
</script>
</Layout>
