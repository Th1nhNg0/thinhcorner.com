---
import Container from "@/components/Container.astro";
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="404 — Page not found"
  description="The page you're looking for doesn't exist."
  image="/og/404.jpg"
  robots="noindex,nofollow"
>
  <Container>
    <section class="mx-auto max-w-xl py-16">
      <p class="page-kicker">Error / 404</p>
      <h1 class="page-title">Nothing here.</h1>
      <p class="page-intro">This page moved, never existed, or took a wrong turn somewhere.</p>
      <div class="mt-8 flex gap-2">
        <a href="/" class="bg-[#eab308] px-3 py-1.5 font-mono text-xs uppercase tracking-wider text-black transition-colors hover:bg-white">Go home</a>
        <a href="/writing" class="border border-[#27272a] px-3 py-1.5 font-mono text-xs uppercase tracking-wider text-zinc-400 transition-colors hover:border-zinc-500 hover:text-white">Browse writing</a>
      </div>
      <p class="mt-16 border-t border-[#27272a] pt-3 font-mono text-xs uppercase tracking-wider text-zinc-700">End of line.</p>
    </section>
  </Container>
</Layout>
