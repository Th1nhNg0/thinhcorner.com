---
import Container from "@/components/Container.astro";
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="404 — Page not found"
  description="The page you're looking for doesn't exist."
  image="/og/404.jpg"
  robots="noindex,nofollow"
>
  <Container>
    <section class="py-16 sm:py-24">
      <p class="page-kicker">404</p>
      <h1 class="page-title">Nothing here.</h1>
      <p class="page-intro">This page moved, never existed, or took a wrong turn somewhere.</p>
      <div class="mt-8 flex flex-wrap gap-x-6 gap-y-2">
        <a href="/" class="text-link arrow-link">Go home <span class="arrow" aria-hidden="true">→</span></a>
        <a href="/writing" class="text-link arrow-link">Browse writing <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </section>
  </Container>
</Layout>
