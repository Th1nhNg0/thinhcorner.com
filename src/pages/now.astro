---
import Container from "@/components/Container.astro";
import Layout from "@/layouts/Layout.astro";
import TimelineItem from "@/components/blog/TimelineItem.astro";
import { Image } from "astro:assets";
import YouTubeEmbed from "@/components/YouTubeEmbed.astro";
import imgWebdev2022 from "@/assets/timeline/webdev2022.jpg";
import imgHcmus from "@/assets/timeline/hcmus.jpg";
import imgOlp from "@/assets/timeline/olp.jpg";
import imgCpnh from "@/assets/timeline/cpnh.jpg";
import imgVts from "@/assets/timeline/vts.jpg";
---

<Layout
  title="Now — Thinh's Corner"
  description="What Ngô Phú Thịnh is doing now, and a timeline of the school, research and work that came before."
  image="/og/now.jpg"
  lang="en"
  locale="en_US"
  structuredData={{
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    name: "Now",
    description:
      "What Ngô Phú Thịnh is doing now, and a timeline of the school, research and work that came before.",
    url: new URL("/now", Astro.site).toString(),
  }}
>
  <Container>
    <header class="page-header">
      <h1 class="page-title">Now & then</h1>
      <p class="page-intro">What I’m doing now, and everything that came before it, back to the Big Bang.</p>
    </header>
    <ol class="timeline">
      <TimelineItem title="What am I doing now?" time="now">
        <p>Wrapping up the last stretch of my MBA at UEH.</p>
        <p>
          Building small games and tools with AI coding agents. The latest ones are on the{" "}
          <a href="/projects">projects page</a>.
        </p>
        <p>Also waiting for AI to replace me 🤖</p>
      </TimelineItem>
      <TimelineItem
        title="Started an MBA at UEH, the University of Economics Ho Chi Minh City"
        time="2024-10-01"
      />
      <TimelineItem
        title="Published my third research paper"
        time="2024"
      >
        <a
          href="https://arxiv.org/abs/2406.06239"
          target="_blank"
          rel="noopener noreferrer"
          class="text-link"
        >
          I-MPN: Inductive Message Passing Network for Efficient
          Human-in-the-Loop Annotation of Mobile Eye Tracking Data
          <span class="sr-only">(opens in new tab)</span>
        </a>
      </TimelineItem>
      <TimelineItem
        title="Published my second research paper"
        time="2024"
      >
        <a
          href="https://doi.org/10.11591/ijai.v13.i4.pp3962-3973"
          target="_blank"
          rel="noopener noreferrer"
          class="text-link"
        >
          Enhancing legal research through knowledge-infused information
          retrieval for Vietnamese labor law
          <span class="sr-only">(opens in new tab)</span>
        </a>
      </TimelineItem>

      <TimelineItem
        title="Graduated from the University of Science, Vietnam National University Ho Chi Minh City"
        time="2023-11-25"
      />
      <TimelineItem
        title="Finished my graduation thesis"
        time="2023-07-16"
      >
        <a href="/timeline/thesis.pdf" class="text-link">
          Deep learning in legal system: Opportunities and Challenges
        </a>
      </TimelineItem>
      <TimelineItem
        title="Published my first research paper"
        time="2023-07-18"
      >
        <a
          href="https://doi.org/10.1007/978-981-99-5834-4_8"
          target="_blank"
          rel="noopener noreferrer"
          class="text-link"
        >
          Intelligent Retrieval System on Legal Information
          <span class="sr-only">(opens in new tab)</span>
        </a>
      </TimelineItem>
      <TimelineItem
        title="Won first prize in WebDev Adventure 2022"
        time="2022-05-13"
      >
        <a
          href="https://github.com/Th1nhNg0/travel_flow_hackathon"
          target="_blank"
          rel="noopener noreferrer"
          class="text-link"
        >
          Travel Flow, the project that won
          <span class="sr-only">(opens in new tab)</span>
        </a>
        <Image
          width={800}
          height={450}
          widths={[400, 640, 800]}
          sizes="(min-width: 720px) 640px, calc(100vw - 4rem)"
          src={imgWebdev2022}
          alt="First prize award at WebDev Adventure 2022"
          loading="lazy"
          decoding="async"
          class="mt-2"
        />
      </TimelineItem>
      <TimelineItem
        title="Started working at King Attorney Joint Stock Company"
        time="2021-01-01"
      />
      <TimelineItem
        title="Started studying at the University of Science, Vietnam National University Ho Chi Minh City"
        time="2019-08-15"
      >
        <Image
          width={800}
          height={450}
          widths={[400, 640, 800]}
          sizes="(min-width: 720px) 640px, calc(100vw - 4rem)"
          src={imgHcmus}
          alt="University of Science, Vietnam National University Ho Chi Minh City campus"
          loading="lazy"
          decoding="async"
          class="mt-2"
        />
      </TimelineItem>
      <TimelineItem
        title="Graduated from Phan Ngoc Hien High School for the Gifted"
        time="2019-05-21"
      />
      <TimelineItem
        title="Won a consolation prize at the national competition for excellent high school students"
        time="2019-04-21"
      />
      <TimelineItem
        title="Won first prize at the provincial competition for excellent high school students"
        time="2017-10-11"
      />
      <TimelineItem
        title="Won a silver medal at the 23rd 30/4 Olympic competition"
        time="2017-04-16"
      >
        <Image
          width={800}
          height={450}
          widths={[400, 640, 800]}
          sizes="(min-width: 720px) 640px, calc(100vw - 4rem)"
          src={imgOlp}
          alt="Silver medal at the 23rd 30/4 Olympic competition"
          loading="lazy"
          decoding="async"
          class="mt-2"
        />
      </TimelineItem>
      <TimelineItem
        title="Started studying at Phan Ngoc Hien High School for the Gifted"
        time="2016-09-10"
      >
        <Image
          width={800}
          height={450}
          widths={[400, 640, 800]}
          sizes="(min-width: 720px) 640px, calc(100vw - 4rem)"
          src={imgCpnh}
          alt="Phan Ngoc Hien High School for the Gifted"
          loading="lazy"
          decoding="async"
          class="mt-2"
        />
      </TimelineItem>
      <TimelineItem
        title="Graduated from Vo Thi Sau Secondary School"
        time="2016-07-15"
      />
      <TimelineItem title="Started learning guitar" time="2012" />
      <TimelineItem
        title="Started studying at Vo Thi Sau Secondary School"
        time="2012"
      >
        <Image
          width={800}
          height={450}
          widths={[400, 640, 800]}
          sizes="(min-width: 720px) 640px, calc(100vw - 4rem)"
          src={imgVts}
          alt="Vo Thi Sau Secondary School"
          loading="lazy"
          decoding="async"
          class="mt-2"
        />
      </TimelineItem>
      <TimelineItem
        title="Born in Ca Mau City, Vietnam"
        time="2001-09-08"
      />
      <TimelineItem
        title="The Big Bang, the beginning of everything"
        time="13.8 billion years ago"
      >
        <p class="text-zinc-400 italic">
          A long time ago in a galaxy far, far away...
        </p>
        <YouTubeEmbed
          id="UcgV4OFRS-w"
          class="w-full aspect-video"
          title="Big Bang - The Beginning of Everything video"
        />
      </TimelineItem>
    </ol>
  </Container>
</Layout>

