---
import Container from "@/components/Container.astro";
import Layout from "@/layouts/Layout.astro";
import TimelineItem from "@/components/blog/TimelineItem.astro";
import { Image } from "astro:assets";
import YouTubeEmbed from "@/components/YouTubeEmbed.astro";
import imgWebdev2022 from "@/assets/timeline/webdev2022.jpg";
import imgHcmus from "@/assets/timeline/hcmus.jpg";
import imgOlp from "@/assets/timeline/olp.jpg";
import imgCpnh from "@/assets/timeline/cpnh.jpg";
import imgVts from "@/assets/timeline/vts.jpg";
---

<Layout
  title="Now — Thinh's Corner"
  description="My personal timeline — where I've been and what I'm doing now."
  image="/og/now.jpg"
  lang="en"
  locale="en_US"
  structuredData={{
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    name: "Now",
    description: "My personal timeline — where I've been and what I'm doing now.",
    url: new URL("/now", Astro.site).toString(),
  }}
>
  <Container>
    <header class="page-header">
        <h1 class="page-title">Now & then</h1>
      <p class="page-intro">A compact timeline of what I’m doing now and the stops that brought me here.</p>
    </header>
    <ol class="space-y-6 pb-10">
      <TimelineItem title="What am i doing now?" time="now">
        <p>Waiting for AI to replace me 🤖</p>
      </TimelineItem>
      <TimelineItem
        title="Start learning Master of Business Administration at UEH University of Economics Ho Chi Minh City"
        time="2024-10-01"
      />
      <TimelineItem
        title="Third research paper published"
        time="2024"
      >
        <a
          href="https://arxiv.org/abs/2406.06239"
          target="_blank"
          rel="noopener noreferrer"
          class="text-link"
        >
          I-MPN: Inductive Message Passing Network for Efficient
          Human-in-the-Loop Annotation of Mobile Eye Tracking Data
          <span class="sr-only">(opens in new tab)</span>
        </a>
      </TimelineItem>
      <TimelineItem
        title="Second research paper published"
        time="2024"
      >
        <a
          href="https://doi.org/10.11591/ijai.v13.i4.pp3962-3973"
          target="_blank"
          rel="noopener noreferrer"
          class="text-link"
        >
          Enhancing legal research through knowledge-infused information
          retrieval for Vietnamese labor law
          <span class="sr-only">(opens in new tab)</span>
        </a>
      </TimelineItem>

      <TimelineItem
        title="Graduated from University of Science, Vietnam National University Ho Chi Minh City"
        time="2023-11-25"
      />
      <TimelineItem
        title="Finished my graduation thesis at University of Science, Vietnam National University Ho Chi Minh City"
        time="2023-07-16"
      >
        <a href="/timeline/thesis.pdf" class="text-link">
          Deep learning in legal system: Opportunities and Challenges
        </a>
      </TimelineItem>
      <TimelineItem
        title="First research paper published"
        time="2023-07-18"
      >
        <a
          href="https://doi.org/10.1007/978-981-99-5834-4_8"
          target="_blank"
          rel="noopener noreferrer"
          class="text-link"
        >
          Intelligent Retrieval System on Legal Information
          <span class="sr-only">(opens in new tab)</span>
        </a>
      </TimelineItem>
      <TimelineItem
        title="Won first prize in WebDev Adventure 2022"
        time="2022-05-13"
      >
        <a
          href="https://github.com/Th1nhNg0/travel_flow_hackathon"
          target="_blank"
          rel="noopener noreferrer"
          class="text-link"
        >
          Link to Project
          <span class="sr-only">(opens in new tab)</span>
        </a>
        <Image
          width={800}
          height={450}
          src={imgWebdev2022}
          alt="First prize award at WebDev Adventure 2022"
          loading="lazy"
          decoding="async"
          class="rounded-lg mt-2"
        />
      </TimelineItem>
      <TimelineItem
        title="Start working at KING ATTORNEY JOINT STOCK COMPANY"
        time="2021-01-01"
      />
      <TimelineItem
        title="Start studying at University of Science, Vietnam National University Ho Chi Minh City"
        time="2019-08-15"
      >
        <Image
          width={800}
          height={450}
          src={imgHcmus}
          alt="University of Science, Vietnam National University Ho Chi Minh City campus"
          loading="lazy"
          decoding="async"
          class="rounded-lg mt-2"
        />
      </TimelineItem>
      <TimelineItem
        title="Graduated from Phan Ngoc Hien High School for the Gifted"
        time="2019-05-21"
      />
      <TimelineItem
        title="Won the Consolation prize at the national competition for excellent students in high school"
        time="2019-04-21"
      />
      <TimelineItem
        title="Won the First prize at the provincial competition for excellent students in high school"
        time="2017-10-11"
      />
      <TimelineItem
        title="Won Silver medal at olympic competition 30/4 XXIII"
        time="2017-04-16"
      >
        <Image
          width={800}
          height={450}
          src={imgOlp}
          alt="Silver medal at Olympic competition 30/4 XXIII"
          loading="lazy"
          decoding="async"
          class="rounded-lg mt-2"
        />
      </TimelineItem>
      <TimelineItem
        title="Start studying at Phan Ngoc Hien High School for the Gifted"
        time="2016-09-10"
      >
        <Image
          width={800}
          height={450}
          src={imgCpnh}
          alt="Phan Ngoc Hien High School for the Gifted"
          loading="lazy"
          decoding="async"
          class="rounded-lg mt-2"
        />
      </TimelineItem>
      <TimelineItem
        title="Graduated from Vo Thi Sau Secondary School"
        time="2016-07-15"
      />
      <TimelineItem title="Learning to play guitar" time="2012" />
      <TimelineItem
        title="Start studying at Vo Thi Sau Secondary School"
        time="2012"
      >
        <Image
          width={800}
          height={450}
          src={imgVts}
          alt="Vo Thi Sau Secondary School"
          loading="lazy"
          decoding="async"
          class="rounded-lg mt-2"
        />
      </TimelineItem>
      <TimelineItem
        title="Born in Ca Mau City, Vietnam"
        time="2001-09-08"
      />
      <li class="border-t border-[#27272a] pt-3 font-mono text-xs uppercase tracking-wider text-zinc-700">Earlier</li>
      <TimelineItem
        title="Big Bang - The Beginning of Everything"
        time="13.8 billion years ago"
      >
        <p class="text-zinc-400 italic">
          A long time ago in a galaxy far, far away...
        </p>
        <YouTubeEmbed
          id="UcgV4OFRS-w"
          class="w-full aspect-video"
          title="Big Bang - The Beginning of Everything video"
        />
      </TimelineItem>
    </ol>
  </Container>
</Layout>

<style>
  /* Remove the gradient style since we're using a simpler design */
</style>
