---
import Container from "@/components/Container.astro";
import { AUTHOR_NAME } from "../../data/consts";
import Layout from "@/layouts/Layout.astro";
import { Image } from "astro:assets";
import riftRecapScoreboard from "@/assets/projects/rift-recap-scoreboard.webp";
import legalTimeline from "../../data/writing/phan-tich-van-ban-phap-luat/timeline_annotated.png";
import railboundBeforeAfter from "../../data/writing/railbound-constraint-solver/before-after.webp";
import haydaySchedule from "../../data/writing/hayday-game-schedule/machine_schedule.png";

type Project = {
  name: string;
  repo: string;
  url: string;
  description: string;
  tags: string[];
  year: string;
  featured?: boolean;
} & ({ image: ImageMetadata; imageAlt: string } | { image?: undefined; imageAlt?: undefined });

const projects: Project[] = [
  {
    name: "Rift Recap",
    repo: "th1nhng0/rift-recap",
    url: "https://github.com/Th1nhNg0/rift-recap",
    description:
      "A self-hosted Discord bot for my League of Legends squad. After each game it posts a scoreboard with everyone's LP change, plus daily, weekly and monthly recaps and optional AI commentary. One small Rust binary and a SQLite file.",
    tags: ["Rust", "Discord", "League of Legends", "SQLite", "Docker"],
    year: "2026",
    featured: true,
    image: riftRecapScoreboard,
    imageAlt: "A Rift Recap match scoreboard posted in Discord",
  },
  {
    name: "Vietnamese Legal Documents",
    repo: "th1nhng0/vietnamese-legal-documents",
    url: "https://huggingface.co/datasets/th1nhng0/vietnamese-legal-documents",
    description:
      "A dataset of Vietnamese legal documents including laws, decrees, circulars, and other normative documents for NLP research and legal AI applications.",
    tags: ["Dataset", "Vietnamese", "NLP", "Legal", "Hugging Face"],
    year: "2026",
    image: legalTimeline,
    imageAlt:
      "Line chart of Vietnamese legal documents issued per year from 1945 to 2025, with historical milestones marked",
  },
  {
    name: "Railbound CP Solver",
    repo: "railbound_cp",
    url: "https://github.com/Th1nhNg0/railbound_cp",
    description:
      "A constraint programming solver for the Railbound puzzle game using MiniZinc and OR-Tools. Models track placement, train movement, switches, and gates as a constraint satisfaction problem.",
    tags: ["MiniZinc", "Python", "Constraint Programming", "Puzzle Solver"],
    year: "2025",
    image: railboundBeforeAfter,
    imageAlt:
      "A Railbound puzzle on the left and the track layout the solver found on the right",
  },
  {
    name: "Hayday Game Schedule",
    repo: "th1nhng0/hayday",
    url: "https://github.com/Th1nhNg0/hayday",
    description:
      "Code and resources for the Hayday Game Schedule blog post. Models Hay Day production as a Flexible Job Shop Scheduling Problem (FJSP) and solves it with Google OR-Tools and a genetic algorithm, including a web crawler for game data.",
    tags: ["Python", "OR-Tools", "Genetic Algorithm", "Scheduling", "Jupyter Notebook"],
    year: "2024",
    image: haydaySchedule,
    imageAlt:
      "Gantt chart of a Hay Day production schedule across fields, a feed mill and a chicken coop",
  },
  {
    name: "Vietnamese Legal AI Thesis",
    repo: "th1nhng0/vietnamese-legal-ai-thesis",
    url: "https://github.com/Th1nhNg0/vietnamese-legal-ai-thesis",
    description:
      "Bachelor thesis on Vietnamese legal question answering using BM25, TF-IDF, ChromaDB, dense embeddings, Instructor model fine-tuning, and RAG (final score 9.7/10).",
    tags: ["Python", "Legal AI", "Vietnamese", "RAG", "BM25", "TF-IDF", "ChromaDB", "Embeddings"],
    year: "2023",
  },
  {
    name: "Travel Flow Hackathon",
    repo: "th1nhng0/travel_flow_hackathon",
    url: "https://github.com/Th1nhNg0/travel_flow_hackathon",
    description:
      "First-prize UIT Web Adventure 2022 mobile app for Travel Flow. Built with Expo and React Native, with authentication, location permissions, map-based travel discovery, location details, and trip plan detail screens.",
    tags: ["React Native", "Expo", "Travel", "Maps", "Hackathon"],
    year: "2022",
  },
  {
    name: "VAIPE 2022",
    repo: "th1nhng0/VAIPE-2022",
    url: "https://github.com/Th1nhNg0/VAIPE-2022",
    description:
      "Medicine pill image recognition challenge pipeline using Tesseract OCR for prescriptions, U-2-Net preprocessing, YOLOv5 object detection, and ResNet50 classification, with Dockerized training and inference scripts.",
    tags: ["Computer Vision", "YOLOv5", "ResNet50", "OCR", "Docker", "Jupyter Notebook"],
    year: "2022",
  },
  {
    name: "AthenaEdu",
    repo: "th1nhng0/athenaedu-spkt-hackathon",
    url: "https://github.com/Th1nhNg0/athenaedu-spkt-hackathon",
    description:
      "SPKT Hackathon 2020 education platform using Vue, Firebase, Express, and Socket.IO. Includes login, quiz categories, single-player practice, multiplayer quiz rooms, forum questions, and rankings.",
    tags: ["Vue", "Firebase", "Express", "Socket.IO", "Education", "Hackathon"],
    year: "2020",
  },
  {
    name: "TicTacMul",
    repo: "th1nhng0/tic-tac-toe-multiplayer",
    url: "https://github.com/Th1nhNg0/tic-tac-toe-multiplayer",
    description:
      "A realtime multiplayer tic-tac-toe game built with Vue, Node.js, Express, and Socket.IO, including room-based play and a bundled Vue client served by the Node backend.",
    tags: ["Vue", "Node.js", "Express", "Socket.IO", "Game"],
    year: "2019",
  },
];

// Newest first, with the featured project pulled to the front so it lands on
// the wide tile regardless of when it shipped.
const sortedProjects = [...projects].sort((a, b) => {
  const yearDiff = Number(b.year) - Number(a.year);
  return yearDiff || a.name.localeCompare(b.name);
});
const ordered = [...sortedProjects].sort(
  (a, b) => Number(Boolean(b.featured)) - Number(Boolean(a.featured)),
);

const years = projects.map((project) => Number(project.year));
const yearRange = `${Math.min(...years)} — ${Math.max(...years)}`;

// 12 columns, mixed widths. Index 0 is the featured tile.
const spans = [
  "md:col-span-7",
  "md:col-span-5",
  "md:col-span-4",
  "md:col-span-4",
  "md:col-span-4",
  "md:col-span-6",
  "md:col-span-6",
  "md:col-span-6",
  "md:col-span-6",
];
const spanFor = (index: number) => spans[index % spans.length];
// Narrow tiles get an extra line so their summaries don't collapse to fragments.
const narrow = (index: number) => /\bcol-span-(4|5)\b/.test(spanFor(index));
---

<Layout
  title="Projects — Thinh's Corner"
  description="A showcase of my side projects and experiments."
  image="/og/projects.jpg"
  lang="en"
  locale="en_US"
  structuredData={{
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Projects",
    description: "A showcase of my side projects and experiments.",
    url: new URL("/projects", Astro.site).toString(),
    author: {
      "@type": "Person",
      name: AUTHOR_NAME,
      url: new URL("/", Astro.site).toString(),
    },
  }}
>
  <Container>
    <div class="pb-8">
      <header class="page-header">
        <h1 class="page-title">Projects</h1>
        <p class="page-intro">
          Small tools, research work, experiments, and things built to answer a
          question.
        </p>
        <div
          class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-1 font-mono text-[0.6875rem] uppercase tracking-[0.06em] text-zinc-600"
        >
          <span>
            <span class="text-zinc-500 tabular-nums"
              >{String(projects.length).padStart(2, "0")}</span
            > projects
          </span>
          <span class="tabular-nums">{yearRange}</span>
          <a
            href="https://github.com/Th1nhNg0"
            target="_blank"
            rel="noopener noreferrer"
            class="ml-auto transition-colors hover:text-[#eab308]"
          >
            all source on github <span aria-hidden="true">↗</span>
            <span class="sr-only">(opens in new tab)</span>
          </a>
        </div>
      </header>

      <ul class="grid grid-cols-12 gap-2.5">
        {
          ordered.map((project, index) => (
            <li class:list={["col-span-12", spanFor(index)]}>
              <a
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group relative flex h-full flex-col border border-[var(--line)] bg-[var(--surface)] p-3.5 transition-colors hover:border-[#eab308] hover:bg-[var(--surface-hover)] focus-visible:border-[#eab308]"
              >
                <span
                  class="absolute right-2.5 top-2 font-mono text-[0.625rem] tabular-nums text-[#2f2f33] transition-colors group-hover:text-[#eab308]"
                  aria-hidden="true"
                >
                  {String(index + 1).padStart(2, "0")}
                </span>

                {project.image && (
                  <span class="-mx-3.5 -mt-3.5 mb-3 block aspect-[2/1] overflow-hidden border-b border-[var(--line)] bg-[#141416]">
                    <Image
                      src={project.image}
                      alt={project.imageAlt}
                      widths={[240, 400, 560, 760]}
                      sizes="(min-width: 768px) 45vw, 92vw"
                      class="h-full w-full object-contain"
                    />
                  </span>
                )}

                <span class="flex flex-wrap items-baseline gap-x-2 pr-6 font-mono text-[0.6875rem] tracking-[0.06em] text-zinc-600">
                  <span class="tabular-nums">{project.year}</span>
                  <span class="break-all">{project.repo}</span>
                </span>

                <span
                  class:list={[
                    "mt-1 block font-medium leading-[1.3] tracking-[-0.015em] transition-colors group-hover:text-[#eab308]",
                    project.featured ? "text-xl" : "text-base",
                  ]}
                >
                  {project.name}
                </span>

                <span
                  class:list={[
                    "mt-1.5 text-[0.8125rem] leading-[1.6] text-zinc-500",
                    project.featured || narrow(index) ? "line-clamp-4" : "line-clamp-3",
                  ]}
                >
                  {project.description}
                </span>

                <span class="mt-auto flex flex-wrap gap-1 pt-3">
                  {project.tags.slice(0, 3).map((tag) => (
                    <span class="border border-[var(--line)] px-1 font-mono text-[0.625rem] uppercase leading-[1.5] tracking-[0.07em] text-zinc-600">
                      {tag}
                    </span>
                  ))}
                  {project.tags.length > 3 && (
                    <span class="px-1 font-mono text-[0.625rem] uppercase leading-[1.5] tracking-[0.07em] text-zinc-700">
                      +{project.tags.length - 3}
                    </span>
                  )}
                </span>

                <span class="sr-only">(opens in new tab)</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</Layout>
