---
import Container from "@/components/Container.astro";
import { AUTHOR_NAME } from "../../data/consts";
import Layout from "@/layouts/Layout.astro";
import { Image } from "astro:assets";
import riftRecapScoreboard from "@/assets/projects/rift-recap-scoreboard.webp";

const projects = [
  {
    name: "Rift Recap",
    repo: "th1nhng0/rift-recap",
    url: "https://github.com/Th1nhNg0/rift-recap",
    description:
      "A self-hosted Discord bot for my League of Legends squad. After each game it posts a scoreboard with everyone's LP change, plus daily, weekly and monthly recaps and optional AI commentary. One small Rust binary and a SQLite file.",
    tags: ["Rust", "Discord", "League of Legends", "SQLite", "Docker"],
    year: "2026",
    featured: true,
  },
  {
    name: "Vietnamese Legal Documents",
    repo: "th1nhng0/vietnamese-legal-documents",
    url: "https://huggingface.co/datasets/th1nhng0/vietnamese-legal-documents",
    description:
      "A dataset of Vietnamese legal documents including laws, decrees, circulars, and other normative documents for NLP research and legal AI applications.",
    tags: ["Dataset", "Vietnamese", "NLP", "Legal", "Hugging Face"],
    year: "2026",
  },
  {
    name: "Railbound CP Solver",
    repo: "railbound_cp",
    url: "https://github.com/Th1nhNg0/railbound_cp",
    description:
      "A constraint programming solver for the Railbound puzzle game using MiniZinc and OR-Tools. Models track placement, train movement, switches, and gates as a constraint satisfaction problem.",
    tags: ["MiniZinc", "Python", "Constraint Programming", "Puzzle Solver"],
    year: "2025",
  },
  {
    name: "Hayday Game Schedule",
    repo: "th1nhng0/hayday",
    url: "https://github.com/Th1nhNg0/hayday",
    description:
      "Code and resources for the Hayday Game Schedule blog post. Models Hay Day production as a Flexible Job Shop Scheduling Problem (FJSP) and solves it with Google OR-Tools and a genetic algorithm, including a web crawler for game data.",
    tags: [
      "Python",
      "OR-Tools",
      "Genetic Algorithm",
      "Scheduling",
      "Jupyter Notebook",
    ],
    year: "2024",
  },
  {
    name: "Vietnamese Legal AI Thesis",
    repo: "th1nhng0/vietnamese-legal-ai-thesis",
    url: "https://github.com/Th1nhNg0/vietnamese-legal-ai-thesis",
    description:
      "Bachelor thesis on Vietnamese legal question answering using BM25, TF-IDF, ChromaDB, dense embeddings, Instructor model fine-tuning, and RAG (final score 9.7/10).",
    tags: [
      "Python",
      "Legal AI",
      "Vietnamese",
      "RAG",
      "BM25",
      "TF-IDF",
      "ChromaDB",
      "Embeddings",
    ],
    year: "2023",
  },
  {
    name: "Travel Flow Hackathon",
    repo: "th1nhng0/travel_flow_hackathon",
    url: "https://github.com/Th1nhNg0/travel_flow_hackathon",
    description:
      "First-prize UIT Web Adventure 2022 mobile app for Travel Flow. Built with Expo and React Native, with authentication, location permissions, map-based travel discovery, location details, and trip plan detail screens.",
    tags: ["React Native", "Expo", "Travel", "Maps", "Hackathon"],
    year: "2022",
  },
  {
    name: "VAIPE 2022",
    repo: "th1nhng0/VAIPE-2022",
    url: "https://github.com/Th1nhNg0/VAIPE-2022",
    description:
      "Medicine pill image recognition challenge pipeline using Tesseract OCR for prescriptions, U-2-Net preprocessing, YOLOv5 object detection, and ResNet50 classification, with Dockerized training and inference scripts.",
    tags: [
      "Computer Vision",
      "YOLOv5",
      "ResNet50",
      "OCR",
      "Docker",
      "Jupyter Notebook",
    ],
    year: "2022",
  },
  {
    name: "AthenaEdu",
    repo: "th1nhng0/athenaedu-spkt-hackathon",
    url: "https://github.com/Th1nhNg0/athenaedu-spkt-hackathon",
    description:
      "SPKT Hackathon 2020 education platform using Vue, Firebase, Express, and Socket.IO. Includes login, quiz categories, single-player practice, multiplayer quiz rooms, forum questions, and rankings.",
    tags: ["Vue", "Firebase", "Express", "Socket.IO", "Education", "Hackathon"],
    year: "2020",
  },
  {
    name: "TicTacMul",
    repo: "th1nhng0/tic-tac-toe-multiplayer",
    url: "https://github.com/Th1nhNg0/tic-tac-toe-multiplayer",
    description:
      "A realtime multiplayer tic-tac-toe game built with Vue, Node.js, Express, and Socket.IO, including room-based play and a bundled Vue client served by the Node backend.",
    tags: ["Vue", "Node.js", "Express", "Socket.IO", "Game"],
    year: "2019",
  },
];

const sortedProjects = [...projects].sort((a, b) => {
  const yearDiff = Number(b.year) - Number(a.year);
  return yearDiff || a.name.localeCompare(b.name);
});

const featured = sortedProjects.find((project) => project.featured);
const others = sortedProjects.filter((project) => project !== featured);

// Cards sit two to a row on a 12-column grid and alternate 5/7 and 7/5.
const spans = [
  ["md:col-span-5", "md:col-span-7"],
  ["md:col-span-7", "md:col-span-5"],
];
const spanFor = (index: number) => spans[Math.floor(index / 2) % 2][index % 2];
---

<Layout
  title="Projects — Thinh's Corner"
  description="A showcase of my side projects and experiments."
  image="/og/projects.jpg"
  lang="en"
  locale="en_US"
  structuredData={{
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Projects",
    description: "A showcase of my side projects and experiments.",
    url: new URL("/projects", Astro.site).toString(),
    author: {
      "@type": "Person",
      name: AUTHOR_NAME,
      url: new URL("/", Astro.site).toString(),
    },
  }}
>
  <Container>
    <div class="pb-8">
      <header class="page-header">
        <h1 class="page-title">Projects</h1>
        <p class="page-intro">
          Small tools, research work, experiments, and things built to answer a
          question.
        </p>
      </header>

      {
        featured && (
          <a
            href={featured.url}
            target="_blank"
            rel="noopener noreferrer"
            class="project-card project-card-featured group mb-3 flex flex-col gap-2.5 p-5"
          >
            <p class="relative font-mono text-xs">
              {featured.year} · {featured.repo}
            </p>
            <h2 class="relative text-2xl font-semibold tracking-tight">
              {featured.name}
            </h2>
            <p class="relative max-w-xl text-sm leading-6">
              {featured.description}
            </p>
            <Image
              src={riftRecapScoreboard}
              alt="A Rift Recap match scoreboard posted in Discord"
              widths={[480, 672, 960]}
              sizes="(min-width: 640px) 632px, calc(100vw - 72px)"
              class="relative mt-2 h-56 w-full object-cover object-top"
            />
            <p class="relative mt-1 font-mono text-xs uppercase tracking-wide">
              {featured.tags.join(" · ")}
            </p>
            <span class="sr-only">(opens in new tab)</span>
          </a>
        )
      }

      <ul class="grid grid-cols-1 gap-3 md:grid-cols-12">
        {
          others.map((project, index) => (
            <li class={spanFor(index)}>
              <a
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
                class="project-card group flex h-full flex-col gap-2.5 p-5"
              >
                <p class="relative font-mono text-xs text-zinc-600">
                  {project.year} · {project.repo}
                </p>
                <h2 class="relative text-lg font-medium text-zinc-200 transition-colors group-hover:text-[#eab308]">
                  {project.name}
                </h2>
                <p class="relative text-sm leading-6 text-zinc-500">
                  {project.description}
                </p>
                <div class="relative mt-auto flex flex-wrap gap-x-3 gap-y-1 pt-2">
                  {project.tags.map((tag) => (
                    <span class="font-mono text-xs uppercase tracking-wide text-zinc-600">
                      {tag}
                    </span>
                  ))}
                </div>
                <span class="sr-only">(opens in new tab)</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</Layout>

<style>
  .project-card {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--surface);
    transition:
      border-color 150ms ease,
      background-color 150ms ease;
  }

  .project-card:hover,
  .project-card:focus-visible {
    border-color: var(--accent);
    background: var(--surface-hover);
  }

  .project-card-featured,
  .project-card-featured:hover,
  .project-card-featured:focus-visible {
    border-color: var(--accent);
    background: var(--accent);
    color: #111;
  }

  .project-card-featured p {
    color: #27272a;
  }


  .project-card-featured:hover h2,
  .project-card-featured:focus-visible h2 {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
