---
import Container from "@/components/Container.astro";
import { AUTHOR_NAME } from "../../data/consts";
import Layout from "@/layouts/Layout.astro";
import { projects, type ProjectLink } from "@/data/projects";

const isExternal = (link: ProjectLink) => link.href.startsWith("http");
const firstYear = Math.min(...projects.map((project) => project.year));
const pageDescription = `Games, tools, datasets and research projects by ${AUTHOR_NAME}, with links to the source.`;
---

<Layout
  title="Projects — Thinh's Corner"
  description={pageDescription}
  image="/og/projects.jpg"
  lang="en"
  locale="en_US"
  structuredData={{
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Projects",
    description: pageDescription,
    url: new URL("/projects", Astro.site).toString(),
    author: {
      "@type": "Person",
      name: AUTHOR_NAME,
      url: new URL("/", Astro.site).toString(),
    },
  }}
>
  <Container>
    <div>
      <header class="page-header">
        <h1 class="page-title">Projects</h1>
        <p class="page-intro">
          Games, tools, datasets and research I’ve built since {firstYear}. Most of the source is
          on{" "}
          <a
            href="https://github.com/Th1nhNg0"
            target="_blank"
            rel="noopener noreferrer"
            class="text-link">GitHub</a
          >.
        </p>
      </header>

      <div class="grid grid-cols-1 gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
        {
          projects.map((project, i) => (
            <article class="cover-card">
              <a
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
                tabindex="-1"
                aria-hidden="true"
                class="cover-frame"
              >
                <img
                  src={project.cover.src}
                  width={project.cover.width}
                  height={project.cover.height}
                  alt=""
                  loading={i < 3 ? "eager" : "lazy"}
                  fetchpriority={i === 0 ? "high" : undefined}
                  decoding="async"
                />
              </a>
              <div class="mt-3 flex items-baseline justify-between gap-3">
                <h2 class="text-base font-medium text-zinc-100">
                  <a
                    href={project.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="transition-colors hover:text-[#eab308]"
                  >
                    {project.name}
                    <span class="sr-only">(opens in new tab)</span>
                  </a>
                </h2>
                <span class="shrink-0 font-mono text-xs tabular-nums text-zinc-600">
                  {project.year}
                </span>
              </div>
              <p class="mt-1 text-sm leading-relaxed text-zinc-500">{project.summary}</p>
              <div class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-sm">
                {project.links.map((link) => (
                  <a
                    href={link.href}
                    {...(isExternal(link)
                      ? { target: "_blank", rel: "noopener noreferrer" }
                      : {})}
                    class="text-zinc-400 underline decoration-[var(--line-strong)] underline-offset-4 transition-colors hover:text-[#eab308] hover:decoration-[#eab308]"
                  >
                    {link.label}
                    {isExternal(link) && (
                      <>
                        <span aria-hidden="true" class="ml-0.5">↗</span>
                        <span class="sr-only">(opens in new tab)</span>
                      </>
                    )}
                  </a>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </Container>
</Layout>
