---
export const prerender = false;
import Container from "@/components/Container.astro";
import Layout from "@/layouts/Layout.astro";
import { getRecentlyPlayed, getTopArtists, getTopTracks } from "@/lib/spotify";
import { SOCIAL_MEDIA } from "@/consts";
import { format, formatDistanceToNow } from "date-fns";
import { env } from "cloudflare:workers";

const topTracks = await getTopTracks(env, env.CACHE);
const recentlyPlayed = await getRecentlyPlayed(env, env.CACHE);
const topArtists = await getTopArtists(env, env.CACHE);
const mobileArtistCount = topArtists.length - (topArtists.length % 2);
const desktopArtistCount = topArtists.length - (topArtists.length % 3);
const now = new Date();

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=600, stale-while-revalidate=300",
);
---

<Layout
  title="Music"
  description="A list of music I've listened to and recommend."
  structuredData={{
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Music",
    description: "A list of music I've listened to and recommend.",
    url: new URL("/music", Astro.site).toString(),
  }}
>
  <Container>
    <div class="collection-page">
    <header class="page-header">
      <p class="page-kicker">Listening log / 4 week window</p>
      <h1 class="page-title">Music library</h1>
      <p class="page-intro">
        A live snapshot of what I’ve been listening to, synced from my{" "}
        <a href={SOCIAL_MEDIA.spotify} class="text-link">Spotify profile</a>.
      </p>
    </header>

    <section class="mb-8">
      <div class="mb-3 flex items-center justify-between">
        <h2 class="text-sm font-medium text-zinc-200">Recently played</h2>
        <span class="font-mono text-[10px] text-zinc-600">{recentlyPlayed.length} tracks</span>
      </div>
      <div class="border-y border-[#27272a]">
        {
          recentlyPlayed.map((track) => (
            <a
              href={track.songUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="compact-row group flex items-center gap-3 border-b border-[#27272a] p-2 last:border-b-0"
            >
              <div class="relative size-10 shrink-0">
                <img
                  src={track.imageUrl}
                  alt={track.title}
                  width="64"
                  height="64"
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full border border-[#27272a] object-cover"
                />

              </div>
              <div class="flex-1 min-w-0">
                <h3 class="line-clamp-1 text-xs font-medium text-zinc-200 transition-colors group-hover:text-[#eab308]">
                  {track.title}
                </h3>
                <p class="line-clamp-1 text-[10px] text-zinc-500">
                  {track.artist}
                </p>
                <p class="mt-0.5 font-mono text-[9px] text-zinc-700">
                  Played{" "}
                  {formatDistanceToNow(new Date(track.played_at), {
                    addSuffix: true,
                  })}
                </p>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <section class="mb-8">
      <div class="mb-3 flex items-center justify-between">
        <h2 class="text-sm font-medium text-zinc-200">Top tracks</h2>
        <span class="font-mono text-[10px] text-zinc-600">Past 4 weeks</span>
      </div>
      <div class="grid grid-cols-3 border-l border-t border-[#27272a] md:grid-cols-5">
        {
          topTracks.map((track) => (
            <a
              href={track.songUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="compact-row group border-b border-r border-[#27272a] p-2 last:hidden sm:last:block"
            >
              <div class="relative aspect-square mb-2">
                <img
                  src={track.imageUrl}
                  alt={track.title}
                  width="300"
                  height="300"
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full border border-[#27272a] object-cover"
                />

              </div>
              <h3 class="line-clamp-1 text-[11px] font-medium text-zinc-300 transition-colors group-hover:text-[#eab308]">
                {track.title}
              </h3>
              <p class="text-zinc-400 text-xs line-clamp-1">
                {track.artist}
              </p>
            </a>
          ))
        }
      </div>
    </section>

    <section class="mb-8">
      <div class="mb-3 flex items-center justify-between">
        <h2 class="text-sm font-medium text-zinc-200">Top artists</h2>
        <span class="font-mono text-[10px] text-zinc-600">Past 4 weeks</span>
      </div>
      <div class="grid grid-cols-2 border-l border-t border-[#27272a] md:grid-cols-3">
        {
          topArtists.map((artist, index) => (
            <a
              href={artist.url}
              target="_blank"
              rel="noopener noreferrer"
              class:list={[
                "group relative aspect-[4/3] overflow-hidden border-b border-r border-[#27272a]",
                index < mobileArtistCount ? "block" : "hidden",
                index < desktopArtistCount ? "md:block" : "md:hidden",
              ]}
            >
              <img
                src={artist.imageUrl}
                alt={artist.name}
                width="640"
                height="480"
                loading="lazy"
                decoding="async"
                class="absolute inset-0 h-full w-full object-cover opacity-70 transition duration-300 group-hover:scale-[1.02] group-hover:opacity-85"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent opacity-80 group-hover:opacity-100 transition-opacity" />
              <div class="absolute inset-0 p-4 flex flex-col justify-end">
                <h3 class="mb-1 text-sm font-medium text-white">
                  {artist.name}
                </h3>
                <div class="flex flex-col gap-0.5 font-mono text-[8px] uppercase tracking-wide text-zinc-300 sm:flex-row sm:gap-3">
                  <span>{artist.followers.toLocaleString()} followers</span>
                  <span>{artist.popularity}% popularity</span>
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <p class="mb-8 mt-4 border-t border-[#27272a] pt-3 text-right font-mono text-[10px] text-zinc-600">
      Updated <time id="last-updated" datetime={now.toISOString()}>{format(now, "MMM d, yyyy 'at' h:mm a")}</time>
    </p>
    </div>
  </Container>
</Layout>

