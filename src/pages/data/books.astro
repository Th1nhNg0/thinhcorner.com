---
export const prerender = false;
import Container from "@/components/Container.astro";
import Layout from "@/layouts/Layout.astro";
import DataHeader from "@/components/data/DataHeader.astro";
import SectionHeading from "@/components/data/SectionHeading.astro";
import StatGrid from "@/components/data/StatGrid.astro";
import { get_book } from "@/lib/goodread";
import type { Book } from "@/lib/goodreads-shelves";
import { format } from "date-fns";
import { GOODREADS_USER_URL } from "../../../data/consts";
import { env } from "cloudflare:workers";

const books = await get_book(env.CACHE);
const read = books.read;
const hasBooks = read.length > 0 || books.current_reads.length > 0;

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=600, stale-while-revalidate=300",
);

// Goodreads stopped publishing read dates, so only books finished since the sync
// began carry one. The rest keep Goodreads' order (most recently read first) under
// one heading.
const dated = read.filter((book) => book.user_read_at);
const undated = read.filter((book) => !book.user_read_at);
const UNDATED = dated.length > 0 ? "Earlier" : "Read";

const readByYear = read.reduce(
  (acc, book) => {
    const group = book.user_read_at
      ? String(new Date(book.user_read_at).getFullYear())
      : UNDATED;
    (acc[group] ??= []).push(book);
    return acc;
  },
  {} as Record<string, Book[]>,
);

// Year headings newest first, then the undated books.
const years = Object.keys(readByYear).sort(
  (a, b) => (Number(b) || -Infinity) - (Number(a) || -Infinity),
);
const now = new Date();
const currentYear = now.getFullYear();
// Charts by year and month would mislead while most books have no date.
const showTimeline = dated.length > 0 && dated.length >= undated.length;

// --- Stats ---
const booksThisYear = readByYear[currentYear]?.length ?? 0;
const totalPages = read.reduce(
  (sum, b) => sum + (parseInt(b.num_pages || "0") || 0),
  0,
);
const totalMinutes = Math.round(totalPages * 1.5);
const totalHours = Math.round(totalMinutes / 60);

// --- Year-over-year chart data ---
const numericYears = years
  .filter((y) => y !== UNDATED)
  .map(Number)
  .sort((a, b) => a - b);
const booksPerYear = numericYears.map((y) => ({
  year: y,
  count: readByYear[y]?.length ?? 0,
}));
const maxBooksInYear = Math.max(...booksPerYear.map((d) => d.count), 1);

// --- Monthly chart data (current year) ---
const monthNames = [
  "Jan",
  "Feb",
  "Mar",
  "Apr",
  "May",
  "Jun",
  "Jul",
  "Aug",
  "Sep",
  "Oct",
  "Nov",
  "Dec",
];
const booksPerMonthThisYear = Array(12).fill(0);
(readByYear[currentYear] ?? []).forEach((book) => {
  if (book.user_read_at) {
    const month = new Date(book.user_read_at).getMonth();
    booksPerMonthThisYear[month]++;
  }
});
const maxMonthly = Math.max(...booksPerMonthThisYear, 1);

// --- Monthly chart data (all years combined) ---
const booksPerMonthAllYears = Array(12).fill(0);
read.forEach((book) => {
  if (book.user_read_at) {
    const month = new Date(book.user_read_at).getMonth();
    booksPerMonthAllYears[month]++;
  }
});
const maxMonthlyAll = Math.max(...booksPerMonthAllYears, 1);

// Combined max for toggle chart (so bars scale the same in both views)
const maxMonthlyBoth = Math.max(maxMonthly, maxMonthlyAll, 1);
const ratingLabels = {
  1: "did not like it",
  2: "it was ok",
  3: "liked it",
  4: "really liked it",
  5: "it was amazing",
};

const rated = read.filter((book) => book.rating > 0);
const averageRating = rated.reduce((sum, book) => sum + book.rating, 0) / Math.max(rated.length, 1);
const fiveStars = rated.filter((book) => Math.round(book.rating) === 5).length;

const stats = [
  {
    label: "Books read",
    value: read.length,
    note: showTimeline ? `${numericYears.length} years tracked` : "most recent first",
  },
  showTimeline
    ? { label: `In ${currentYear}`, value: booksThisYear, note: `${books.current_reads.length} in progress` }
    : { label: "Reading now", value: books.current_reads.length, note: books.current_reads[0]?.title },
  ...(totalPages > 0
    ? [
        { label: "Pages", value: totalPages.toLocaleString(), note: `~${Math.round(totalPages / Math.max(read.length, 1))} per book` },
        { label: "Time spent", value: `~${totalHours.toLocaleString()}h`, note: "at 1.5 min / page" },
      ]
    : [
        { label: "Average rating", value: rated.length ? averageRating.toFixed(1) : "–", note: `across ${rated.length} rated` },
        { label: "Five stars", value: fiveStars, note: `${Math.round((fiveStars / Math.max(rated.length, 1)) * 100)}% of rated books` },
      ]),
];

const pageDescription = "Books I have read and rated, synced from Goodreads.";

---

<Layout
  title="Books — Thinh's Corner"
  description={pageDescription}
  image="/og/books.jpg"
  structuredData={{
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Books",
    description: pageDescription,
    url: new URL("/data/books", Astro.site).toString(),
  }}
>
  <Container>
    <div class="collection-page">
      <DataHeader title="Books" source="Goodreads" sourceHref={GOODREADS_USER_URL} updated={now}>
        Everything I have finished reading, synced from my{" "}
        <a href={GOODREADS_USER_URL} class="text-link">Goodreads profile</a>.
      </DataHeader>

      {
        !hasBooks && (
          <section class="data-section">
            <div class="data-notice">
              <p>Goodreads isn’t sharing right now.</p>
              <p>
                The synced copy of my shelves couldn’t be loaded and Goodreads didn’t answer
                directly either. The shelves sync every six hours, so this should clear up on
                its own.
              </p>
              <p>
                Meanwhile, everything lives on my{" "}
                <a
                  href={GOODREADS_USER_URL}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-link"
                >
                  Goodreads profile
                </a>.
              </p>
            </div>
          </section>
        )
      }

      {
        hasBooks && (
          <>
      <!-- Stats Bar -->
      <section class="data-section">
        <StatGrid stats={stats} />
      </section>

      <!-- Currently Reading -->
      {
        books.current_reads.length > 0 && (
          <section class="data-section">
            <SectionHeading
              title="Currently reading"
              note={`${books.current_reads.length} ${books.current_reads.length === 1 ? "book" : "books"}`}
            />
            <ul class="grid grid-cols-1 gap-x-8 gap-y-6 sm:grid-cols-2">
              {books.current_reads.map((book) => (
                <li>
                  <a
                    href={book.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group flex items-center gap-5"
                  >
                    {book.cover ? (
                      <img
                        src={book.cover}
                        alt=""
                        width="96"
                        height="144"
                        class="book-cover w-20 shrink-0 sm:w-24"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <span class="book-cover w-20 shrink-0 sm:w-24" />
                    )}
                    <span class="min-w-0">
                      <span class="inline-flex items-center gap-2 text-sm text-[#eab308]">
                        <span class="data-live-dot" aria-hidden="true" />
                        Reading now
                      </span>
                      <span class="mt-1.5 block text-xl font-medium leading-snug tracking-tight text-zinc-100 transition-colors group-hover:text-[#eab308]">
                        {book.title}
                      </span>
                      <span class="mt-1 block text-zinc-500">{book.author}</span>
                    </span>
                    <span class="sr-only">(opens in new tab)</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <!-- Charts Section -->
      {showTimeline && (
      <section class="data-section grid grid-cols-1 gap-x-6 gap-y-8 md:grid-cols-2">
        <!-- Year-over-year chart -->
        <div>
          <SectionHeading title="Books per year" note={`${numericYears.length} years`} />
          <div class="data-panel">
            <div class="flex h-36 items-end gap-1.5 border-b border-[#1f1f23]">
              {
                booksPerYear.map((d) => (
                  <div
                    class="group flex h-full flex-1 flex-col items-center justify-end gap-1"
                    title={`${d.year}: ${d.count} books`}
                  >
                    <span class="data-figure transition-colors group-hover:text-[#eab308]">
                      {d.count || ""}
                    </span>
                    <div
                      class="w-full rounded-t-sm bg-[#eab308]/70 transition-colors group-hover:bg-[#eab308]"
                      style={`height: ${Math.max((d.count / maxBooksInYear) * 82, d.count ? 4 : 1)}%;`}
                    />
                  </div>
                ))
              }
            </div>
            <div class="mt-1.5 flex gap-1.5">
              {booksPerYear.map((d) => (
                <span class="data-figure flex-1 text-center">
                  '{String(d.year).slice(-2)}
                </span>
              ))}
            </div>
          </div>
        </div>

        <!-- Monthly chart with toggle -->
        <div id="monthly-chart">
          <SectionHeading title="By month">
            <div class="segmented" role="group" aria-label="Monthly chart range">
              <button id="btn-this-year" type="button" aria-pressed="true">
                {currentYear}
              </button>
              <button id="btn-all-years" type="button" aria-pressed="false">
                All
              </button>
            </div>
          </SectionHeading>
          <div class="data-panel">
            {
              [
                { id: "chart-this-year", counts: booksPerMonthThisYear, hidden: false },
                { id: "chart-all-years", counts: booksPerMonthAllYears, hidden: true },
              ].map(({ id, counts, hidden }) => (
                <div
                  id={id}
                  class:list={["h-36 items-end gap-1.5 border-b border-[#1f1f23]", hidden ? "hidden" : "flex"]}
                >
                  {monthNames.map((m, i) => {
                    const count = counts[i];
                    const isFuture = !hidden && i > now.getMonth();
                    return (
                      <div
                        class="group flex h-full flex-1 flex-col items-center justify-end gap-1"
                        title={`${m}: ${count} books`}
                      >
                        <span class="data-figure transition-colors group-hover:text-[#eab308]">
                          {count || ""}
                        </span>
                        <div
                          class:list={[
                            "w-full rounded-t-sm transition-colors",
                            isFuture
                              ? "bg-zinc-800/40"
                              : count > 0
                                ? "bg-[#eab308]/70 group-hover:bg-[#eab308]"
                                : "bg-zinc-700/60",
                          ]}
                          style={`height: ${count ? Math.max((count / maxMonthlyBoth) * 82, 4) : 1}%;`}
                        />
                      </div>
                    );
                  })}
                </div>
              ))
            }
            <div class="mt-1.5 flex gap-1.5">
              {monthNames.map((m) => (
                <span class="data-figure flex-1 text-center" title={m}>
                  {m[0]}
                </span>
              ))}
            </div>
          </div>
        </div>
      </section>
      )}

      <!-- Book List -->
      <section id="book-list">
        {
          years.map((year) => (
            <div class="data-section" data-year={year}>
              <SectionHeading
                title={year}
                note={`${readByYear[year].length} ${readByYear[year].length === 1 ? "book" : "books"}`}
              />
              <ul class="grid grid-cols-3 gap-x-4 gap-y-8 sm:grid-cols-4 sm:gap-x-6 md:grid-cols-6">
                {readByYear[year].map((book) => {
                  const r = Math.round(book.rating);
                  return (
                    <li class="group relative min-w-0">
                      {book.cover ? (
                        <img
                          src={book.cover}
                          alt=""
                          width="160"
                          height="240"
                          class="book-cover w-full"
                          loading="lazy"
                          decoding="async"
                        />
                      ) : (
                        <div class="book-cover flex w-full items-center justify-center p-3 text-center text-xs leading-snug text-zinc-500">
                          {book.title}
                        </div>
                      )}
                      <a
                        href={book.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="mt-3 line-clamp-2 text-sm font-medium leading-snug text-zinc-200 transition-colors after:absolute after:inset-0 group-hover:text-[#eab308]"
                      >
                        {book.title}
                        <span class="sr-only">(opens in new tab)</span>
                      </a>
                      <p class="mt-0.5 truncate text-xs text-zinc-500">{book.author}</p>
                      {r > 0 && (
                        <p
                          class="mt-1 text-xs leading-none tracking-[0.08em]"
                          title={`${r}/5 · ${ratingLabels[r as keyof typeof ratingLabels]}`}
                        >
                          <span class="sr-only">Rated {r} out of 5</span>
                          <span aria-hidden="true" class="text-[#eab308]">{"★".repeat(r)}</span><span aria-hidden="true" class="text-zinc-700">{"★".repeat(5 - r)}</span>
                        </p>
                      )}
                      {(book.user_read_at || book.num_pages) && (
                        <p class="data-figure mt-1.5 truncate">
                          {book.user_read_at && format(new Date(book.user_read_at), "MMM d")}
                          {book.user_read_at && book.num_pages && " · "}
                          {book.num_pages && `${book.num_pages} pp`}
                        </p>
                      )}
                    </li>
                  );
                })}
              </ul>
            </div>
          ))
        }
      </section>

          </>
        )
      }

    </div>
  </Container>

  <script>
    function initReadingChartToggle() {
      const buttons = [
        { btn: document.getElementById("btn-this-year"), chart: document.getElementById("chart-this-year") },
        { btn: document.getElementById("btn-all-years"), chart: document.getElementById("chart-all-years") },
      ];
      if (buttons.some(({ btn, chart }) => !btn || !chart)) return;
      if (buttons[0].btn!.dataset.chartInitialized === "true") return;
      buttons[0].btn!.dataset.chartInitialized = "true";

      buttons.forEach(({ btn }) => {
        btn!.addEventListener("click", () => {
          buttons.forEach((other) => {
            const active = other.btn === btn;
            other.btn!.setAttribute("aria-pressed", String(active));
            other.chart!.classList.toggle("hidden", !active);
            other.chart!.classList.toggle("flex", active);
          });
        });
      });
    }

    document.addEventListener("astro:page-load", initReadingChartToggle);
  </script>
</Layout>
