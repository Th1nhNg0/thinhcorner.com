---
export const prerender = false;
import Container from "@/components/Container.astro";
import Layout from "@/layouts/Layout.astro";
import DataHeader from "@/components/data/DataHeader.astro";
import SectionHeading from "@/components/data/SectionHeading.astro";
import StatGrid from "@/components/data/StatGrid.astro";
import { get_book } from "@/lib/goodread";
import { format } from "date-fns";
import { GOODREADS_USER_URL } from "../../../data/consts";
import { env } from "cloudflare:workers";

const books = await get_book(env.CACHE);
const read = books.read;
const hasBooks = read.length > 0 || books.current_reads.length > 0;

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=600, stale-while-revalidate=300",
);

const readByYear = read.reduce(
  (acc, post) => {
    if (!post.user_read_at) {
      if (!acc["Long time ago"]) {
        acc["Long time ago"] = [];
      }
      acc["Long time ago"].push(post);
      return acc;
    }
    const year = new Date(post.user_read_at).getFullYear();
    if (!acc[year]) {
      acc[year] = [];
    }
    acc[year].push(post);
    return acc;
  },
  {} as Record<string, any[]>,
);

const years = Object.keys(readByYear).sort((a, b) => Number(b) - Number(a));
const now = new Date();
const currentYear = now.getFullYear();

// --- Stats ---
const booksThisYear = readByYear[currentYear]?.length ?? 0;
const totalPages = read.reduce(
  (sum, b) => sum + (parseInt(b.num_pages || "0") || 0),
  0,
);
const totalMinutes = Math.round(totalPages * 1.5);
const totalHours = Math.round(totalMinutes / 60);

// --- Year-over-year chart data ---
const numericYears = years
  .filter((y) => y !== "Long time ago")
  .map(Number)
  .sort((a, b) => a - b);
const booksPerYear = numericYears.map((y) => ({
  year: y,
  count: readByYear[y]?.length ?? 0,
}));
const maxBooksInYear = Math.max(...booksPerYear.map((d) => d.count), 1);

// --- Monthly chart data (current year) ---
const monthNames = [
  "Jan",
  "Feb",
  "Mar",
  "Apr",
  "May",
  "Jun",
  "Jul",
  "Aug",
  "Sep",
  "Oct",
  "Nov",
  "Dec",
];
const booksPerMonthThisYear = Array(12).fill(0);
(readByYear[currentYear] ?? []).forEach((book) => {
  if (book.user_read_at) {
    const month = new Date(book.user_read_at).getMonth();
    booksPerMonthThisYear[month]++;
  }
});
const maxMonthly = Math.max(...booksPerMonthThisYear, 1);

// --- Monthly chart data (all years combined) ---
const booksPerMonthAllYears = Array(12).fill(0);
read.forEach((book) => {
  if (book.user_read_at) {
    const month = new Date(book.user_read_at).getMonth();
    booksPerMonthAllYears[month]++;
  }
});
const maxMonthlyAll = Math.max(...booksPerMonthAllYears, 1);

// Combined max for toggle chart (so bars scale the same in both views)
const maxMonthlyBoth = Math.max(maxMonthly, maxMonthlyAll, 1);
const ratingLabels = {
  1: "did not like it",
  2: "it was ok",
  3: "liked it",
  4: "really liked it",
  5: "it was amazing",
};

const pageDescription =
  "Reading analytics from Goodreads: books read, yearly trends and ratings.";

---

<Layout
  title="Books — Thinh's Corner"
  description={pageDescription}
  image="/og/books.jpg"
  structuredData={{
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Books",
    description: pageDescription,
    url: new URL("/data/books", Astro.site).toString(),
  }}
>
  <Container>
    <div class="collection-page">
      <DataHeader title="Books" source="goodreads" sourceHref={GOODREADS_USER_URL} updated={now}>
        Everything I have finished reading, by year and month, synced from my{" "}
        <a href={GOODREADS_USER_URL} class="text-link">Goodreads profile</a>.
      </DataHeader>

      {
        !hasBooks && (
          <section class="data-section">
            <div class="space-y-2 border border-[#27272a] bg-[#0c0c0d] p-6 font-mono text-xs leading-relaxed text-zinc-400">
              <p class="text-[#eab308]">Goodreads isn’t sharing right now.</p>
              <p>
                The RSS feed came back empty — Goodreads sometimes blocks
                server-side requests. This page caches its data, so it will
                recover on its own within a few hours.
              </p>
              <p>
                Meanwhile, everything lives on my{" "}
                <a
                  href={GOODREADS_USER_URL}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-link"
                >
                  Goodreads profile
                </a>.
              </p>
            </div>
          </section>
        )
      }

      {
        hasBooks && (
          <>
      <!-- Stats Bar -->
      <section class="data-section">
        <StatGrid
          stats={[
            { label: "Books read", value: read.length, note: `${numericYears.length} years tracked` },
            { label: `In ${currentYear}`, value: booksThisYear, note: `${books.current_reads.length} in progress` },
            { label: "Pages", value: totalPages.toLocaleString(), note: `~${Math.round(totalPages / Math.max(read.length, 1))} per book` },
            { label: "Time spent", value: `~${totalHours.toLocaleString()}h`, note: "at 1.5 min / page" },
          ]}
        />
      </section>

      <!-- Currently Reading -->
      {
        books.current_reads.length > 0 && (
          <section class="data-section">
            <SectionHeading
              title="Currently reading"
              note={`${books.current_reads.length} ${books.current_reads.length === 1 ? "book" : "books"}`}
            />
            <div
              class:list={[
                "grid grid-cols-1 border-l border-t border-[#27272a]",
                books.current_reads.length > 1 && "sm:grid-cols-2",
              ]}
            >
              {books.current_reads.map((book) => (
                <a
                  href={book.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="compact-row group flex items-center gap-3 border-b border-r border-[#27272a] p-3"
                >
                  {book.cover ? (
                    <img
                      src={book.cover}
                      alt=""
                      width="40"
                      height="60"
                      class="h-[60px] w-[40px] shrink-0 border border-[#27272a] object-cover"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <span class="h-[60px] w-[40px] shrink-0 border border-[#27272a] bg-zinc-900" />
                  )}
                  <span class="min-w-0">
                    <span class="block truncate text-sm font-medium text-zinc-200 transition-colors group-hover:text-[#eab308]">
                      {book.title}
                    </span>
                    <span class="block truncate text-xs text-zinc-500">{book.author}</span>
                    <span class="mt-1 inline-flex items-center gap-1.5 font-mono text-[11px] text-[#eab308]">
                      <span class="data-live-dot" aria-hidden="true" />
                      reading now
                    </span>
                  </span>
                  <span class="sr-only">(opens in new tab)</span>
                </a>
              ))}
            </div>
          </section>
        )
      }

      <!-- Charts Section -->
      <section class="data-section grid grid-cols-1 gap-x-6 gap-y-8 md:grid-cols-2">
        <!-- Year-over-year chart -->
        <div>
          <SectionHeading title="Books per year" note={`${numericYears.length} years`} />
          <div class="data-panel px-4 pb-3 pt-4">
            <div class="flex h-36 items-end gap-1.5 border-b border-[#27272a]">
              {
                booksPerYear.map((d) => (
                  <div
                    class="group flex h-full flex-1 flex-col items-center justify-end gap-1"
                    title={`${d.year}: ${d.count} books`}
                  >
                    <span class="font-mono text-[11px] text-zinc-400 transition-colors group-hover:text-[#eab308]">
                      {d.count || ""}
                    </span>
                    <div
                      class="w-full bg-[#eab308]/70 transition-colors group-hover:bg-[#eab308]"
                      style={`height: ${Math.max((d.count / maxBooksInYear) * 82, d.count ? 4 : 1)}%;`}
                    />
                  </div>
                ))
              }
            </div>
            <div class="mt-1.5 flex gap-1.5">
              {booksPerYear.map((d) => (
                <span class="flex-1 text-center font-mono text-[11px] text-zinc-600">
                  '{String(d.year).slice(-2)}
                </span>
              ))}
            </div>
          </div>
        </div>

        <!-- Monthly chart with toggle -->
        <div id="monthly-chart">
          <SectionHeading title="By month">
            <div class="segmented" role="group" aria-label="Monthly chart range">
              <button id="btn-this-year" type="button" aria-pressed="true">
                {currentYear}
              </button>
              <button id="btn-all-years" type="button" aria-pressed="false">
                All
              </button>
            </div>
          </SectionHeading>
          <div class="data-panel px-4 pb-3 pt-4">
            {
              [
                { id: "chart-this-year", counts: booksPerMonthThisYear, hidden: false },
                { id: "chart-all-years", counts: booksPerMonthAllYears, hidden: true },
              ].map(({ id, counts, hidden }) => (
                <div
                  id={id}
                  class:list={["h-36 items-end gap-1.5 border-b border-[#27272a]", hidden ? "hidden" : "flex"]}
                >
                  {monthNames.map((m, i) => {
                    const count = counts[i];
                    const isFuture = !hidden && i > now.getMonth();
                    return (
                      <div
                        class="group flex h-full flex-1 flex-col items-center justify-end gap-1"
                        title={`${m}: ${count} books`}
                      >
                        <span class="font-mono text-[11px] text-zinc-400 transition-colors group-hover:text-[#eab308]">
                          {count || ""}
                        </span>
                        <div
                          class:list={[
                            "w-full transition-colors",
                            isFuture
                              ? "bg-zinc-800/40"
                              : count > 0
                                ? "bg-[#eab308]/70 group-hover:bg-[#eab308]"
                                : "bg-zinc-700/60",
                          ]}
                          style={`height: ${count ? Math.max((count / maxMonthlyBoth) * 82, 4) : 1}%;`}
                        />
                      </div>
                    );
                  })}
                </div>
              ))
            }
            <div class="mt-1.5 flex gap-1.5">
              {monthNames.map((m) => (
                <span class="flex-1 text-center font-mono text-[11px] text-zinc-600" title={m}>
                  {m[0]}
                </span>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- Book List -->
      <section id="book-list">
        {
          years.map((year) => (
            <div class="data-section" data-year={year}>
              <SectionHeading
                title={year}
                note={`${readByYear[year].length} ${readByYear[year].length === 1 ? "book" : "books"}`}
              />
              <ul class="grid grid-cols-1 border-l border-t border-[#27272a] md:grid-cols-2">
                {readByYear[year].map((book) => {
                  const r = Math.round(book.rating);
                  return (
                    <li class="compact-row group relative flex gap-3.5 border-b border-r border-[#27272a] p-3">
                      {book.cover ? (
                        <img
                          src={book.cover}
                          alt={`Cover of ${book.title}`}
                          width="72"
                          height="108"
                          class="h-[96px] w-[64px] shrink-0 border border-[#27272a] object-cover"
                          loading="lazy"
                          decoding="async"
                        />
                      ) : (
                        <div class="flex h-[96px] w-[64px] shrink-0 items-center justify-center border border-[#27272a] bg-zinc-900 p-1 text-center font-mono text-[10px] uppercase tracking-wide text-zinc-700">
                          No cover
                        </div>
                      )}
                      <div class="flex min-w-0 flex-1 flex-col">
                        <a
                          href={book.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="line-clamp-2 text-sm font-medium leading-snug text-zinc-200 transition-colors after:absolute after:inset-0 hover:text-[#eab308] group-hover:text-[#eab308]"
                        >
                          {book.title}
                          <span class="sr-only">(opens in new tab)</span>
                        </a>
                        <p class="mt-0.5 truncate text-xs text-zinc-500">{book.author}</p>
                        {r > 0 && (
                          <p
                            class="mt-1.5 flex items-center gap-0.5 text-xs leading-none"
                            title={`${r}/5 · ${ratingLabels[r as keyof typeof ratingLabels]}`}
                          >
                            <span class="sr-only">Rated {r} out of 5</span>
                            {[1, 2, 3, 4, 5].map((n) => (
                              <span aria-hidden="true" class={n <= r ? "text-[#eab308]" : "text-zinc-700"}>
                                ★
                              </span>
                            ))}
                            <span class="ml-1.5 font-mono text-[11px] text-zinc-600">
                              {ratingLabels[r as keyof typeof ratingLabels]}
                            </span>
                          </p>
                        )}
                        <div class="mt-auto flex items-center gap-2 pt-2 font-mono text-[11px] text-zinc-600">
                          {book.num_pages && <span>{book.num_pages} pp</span>}
                          {book.user_read_at && (
                            <span class="ml-auto">
                              finished {format(new Date(book.user_read_at), "MMM d")}
                            </span>
                          )}
                        </div>
                      </div>
                    </li>
                  );
                })}
              </ul>
            </div>
          ))
        }
      </section>

          </>
        )
      }

    </div>
  </Container>

  <script>
    function initReadingChartToggle() {
      const buttons = [
        { btn: document.getElementById("btn-this-year"), chart: document.getElementById("chart-this-year") },
        { btn: document.getElementById("btn-all-years"), chart: document.getElementById("chart-all-years") },
      ];
      if (buttons.some(({ btn, chart }) => !btn || !chart)) return;
      if (buttons[0].btn!.dataset.chartInitialized === "true") return;
      buttons[0].btn!.dataset.chartInitialized = "true";

      buttons.forEach(({ btn }) => {
        btn!.addEventListener("click", () => {
          buttons.forEach((other) => {
            const active = other.btn === btn;
            other.btn!.setAttribute("aria-pressed", String(active));
            other.chart!.classList.toggle("hidden", !active);
            other.chart!.classList.toggle("flex", active);
          });
        });
      });
    }

    document.addEventListener("astro:page-load", initReadingChartToggle);
  </script>
</Layout>
