---
export const prerender = false;
import Container from "@/components/Container.astro";
import Layout from "@/layouts/Layout.astro";
import { get_book } from "@/lib/goodread";
import { format } from "date-fns";
import { GOODREADS_USER_URL } from "../../../data/consts";
import { env } from "cloudflare:workers";

const books = await get_book(env.CACHE);
const read = books.read;
const hasBooks = read.length > 0 || books.current_reads.length > 0;

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=600, stale-while-revalidate=300",
);

const readByYear = read.reduce(
  (acc, post) => {
    if (!post.user_read_at) {
      if (!acc["Long time ago"]) {
        acc["Long time ago"] = [];
      }
      acc["Long time ago"].push(post);
      return acc;
    }
    const year = new Date(post.user_read_at).getFullYear();
    if (!acc[year]) {
      acc[year] = [];
    }
    acc[year].push(post);
    return acc;
  },
  {} as Record<string, any[]>,
);

const years = Object.keys(readByYear).sort((a, b) => Number(b) - Number(a));
const now = new Date();
const currentYear = now.getFullYear();

// --- Stats ---
const booksThisYear = readByYear[currentYear]?.length ?? 0;
const totalPages = read.reduce(
  (sum, b) => sum + (parseInt(b.num_pages || "0") || 0),
  0,
);
const totalMinutes = Math.round(totalPages * 1.5);
const totalHours = Math.round(totalMinutes / 60);

// --- Year-over-year chart data ---
const numericYears = years
  .filter((y) => y !== "Long time ago")
  .map(Number)
  .sort((a, b) => a - b);
const booksPerYear = numericYears.map((y) => ({
  year: y,
  count: readByYear[y]?.length ?? 0,
}));
const maxBooksInYear = Math.max(...booksPerYear.map((d) => d.count), 1);

// --- Monthly chart data (current year) ---
const monthNames = [
  "Jan",
  "Feb",
  "Mar",
  "Apr",
  "May",
  "Jun",
  "Jul",
  "Aug",
  "Sep",
  "Oct",
  "Nov",
  "Dec",
];
const booksPerMonthThisYear = Array(12).fill(0);
(readByYear[currentYear] ?? []).forEach((book) => {
  if (book.user_read_at) {
    const month = new Date(book.user_read_at).getMonth();
    booksPerMonthThisYear[month]++;
  }
});
const maxMonthly = Math.max(...booksPerMonthThisYear, 1);

// --- Monthly chart data (all years combined) ---
const booksPerMonthAllYears = Array(12).fill(0);
read.forEach((book) => {
  if (book.user_read_at) {
    const month = new Date(book.user_read_at).getMonth();
    booksPerMonthAllYears[month]++;
  }
});
const maxMonthlyAll = Math.max(...booksPerMonthAllYears, 1);

// Combined max for toggle chart (so bars scale the same in both views)
const maxMonthlyBoth = Math.max(maxMonthly, maxMonthlyAll, 1);
---

<Layout
  title="Books — Thinh's Corner"
  description="A list of books I've read and recommend."
  lang="en"
  locale="en_US"
  structuredData={{
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Books",
    description: "A list of books I've read and recommend.",
    url: new URL("/data/books", Astro.site).toString(),
  }}
>
  <Container>
    <div class="collection-page">
      <header class="page-header">
        <p class="font-mono text-[10px] uppercase tracking-wide text-zinc-600">
          <a href="/data" class="transition-colors hover:text-zinc-400">← All data</a>
        </p>
        <h1 class="page-title">Bookshelf</h1>
        <p class="page-intro">
          A record of what I’ve read over the years, synced from my{" "}
          <a href={GOODREADS_USER_URL} class="text-link">Goodreads profile</a>.
        </p>
      </header>

      {
        !hasBooks && (
          <section class="mb-8">
            <div class="space-y-2 border border-[#27272a] bg-[#0c0c0d] p-6 font-mono text-[11px] leading-relaxed text-zinc-400">
              <p class="text-[#eab308]">Goodreads isn’t sharing right now.</p>
              <p>
                The RSS feed came back empty — Goodreads sometimes blocks
                server-side requests. This page caches its data, so it will
                recover on its own within a few hours.
              </p>
              <p>
                Meanwhile, everything lives on my{" "}
                <a
                  href={GOODREADS_USER_URL}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-link"
                >
                  Goodreads profile
                </a>.
              </p>
            </div>
          </section>
        )
      }

      {
        hasBooks && (
          <>
      <!-- Stats Bar -->
      <div class="mb-7 grid grid-cols-2 border border-[#27272a] sm:grid-cols-4">
        {
          [
            [read.length, "books total"],
            [booksThisYear, `books in ${currentYear}`],
            [totalPages.toLocaleString(), "pages read"],
            [`~${totalHours.toLocaleString()}h`, "time spent"],
          ].map(([value, label]) => (
            <div class="border-b border-r border-[#27272a] p-3 even:border-r-0 sm:border-b-0 sm:even:border-r sm:last:border-r-0">
              <div class="font-mono text-lg text-zinc-200">{value}</div>
              <div class="mt-0.5 font-mono text-[9px] uppercase tracking-wider text-zinc-600">
                {label}
              </div>
            </div>
          ))
        }
      </div>

      <!-- Currently Reading -->
      {
        books.current_reads.length > 0 && (
          <section class="mb-7 border border-[#27272a] bg-[#111113] p-3">
            <h2 class="mb-2 font-mono text-[9px] uppercase tracking-wider text-[#eab308]">
              Currently reading
            </h2>
            <div class="flex flex-wrap gap-2">
              {books.current_reads.map((book) => (
                <a
                  href={book.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 text-xs text-zinc-300 transition-colors hover:text-[#eab308]"
                >
                  <span class="font-medium">{book.title}</span>
                  <span class="text-zinc-600">by {book.author}</span>
                  <span class="sr-only">(opens in new tab)</span>
                </a>
              ))}
            </div>
          </section>
        )
      }

      <!-- Charts Section -->
      <section class="mb-9 grid grid-cols-1 gap-3 md:grid-cols-2">
        <!-- Year-over-year chart -->
        <div class="border border-[#27272a] bg-[#111113] p-4">
          <h3
            class="text-sm font-mono text-zinc-500 uppercase tracking-wider mb-4"
          >
            Books per year
          </h3>
          <div class="flex items-end gap-1" style="height: 7rem;">
            {
              booksPerYear.map((d) => {
                const barH = Math.max((d.count / maxBooksInYear) * 5, 0.25);
                return (
                  <div
                    class="flex-1 flex flex-col items-center justify-end gap-1 group"
                    style="height: 100%;"
                  >
                    <span class="text-[10px] font-mono text-zinc-500 opacity-0 group-hover:opacity-100 transition-opacity">
                      {d.count}
                    </span>
                    <div
                      class="w-full bg-[#eab308]/70 transition-colors hover:bg-[#eab308]"
                      style={`height: ${barH}rem;`}
                      title={`${d.year}: ${d.count} books`}
                    />
                    <span class="text-[10px] font-mono text-zinc-600">
                      {String(d.year).slice(-2)}
                    </span>
                  </div>
                );
              })
            }
          </div>
        </div>

        <!-- Monthly chart with toggle -->
        <div
          class="border border-[#27272a] bg-[#111113] p-4"
          id="monthly-chart"
        >
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-sm text-zinc-500 uppercase tracking-wider">
              Monthly
            </h3>
            <div class="flex border border-[#27272a] bg-[#0c0c0d] p-0.5">
              <button
                id="btn-this-year"
                class="bg-[#eab308] px-2 py-0.5 font-mono text-[9px] uppercase text-black transition-colors"
                type="button"
                aria-pressed="true"
              >
                {currentYear}
              </button>
              <button
                id="btn-all-years"
                class="px-2 py-0.5 font-mono text-[9px] uppercase text-zinc-500 transition-colors hover:text-zinc-300"
                type="button"
                aria-pressed="false"
              >
                All
              </button>
            </div>
          </div>
          <!-- This year view -->
          <div
            id="chart-this-year"
            class="flex items-end gap-1"
            style="height: 7rem;"
          >
            {
              monthNames.map((m, i) => {
                const count = booksPerMonthThisYear[i];
                const barH = Math.max((count / maxMonthlyBoth) * 5, 0.25);
                const isFuture = i > now.getMonth();
                return (
                  <div
                    class="flex-1 flex flex-col items-center justify-end gap-1 group"
                    style="height: 100%;"
                  >
                    <span class="text-[10px] font-mono text-zinc-500 opacity-0 group-hover:opacity-100 transition-opacity">
                      {count}
                    </span>
                    <div
                      class:list={[
                        "w-full transition-colors",
                        isFuture
                          ? "bg-zinc-700/30"
                          : count > 0
                            ? "bg-[#eab308]/70 hover:bg-[#eab308]"
                            : "bg-zinc-700/50",
                      ]}
                      style={`height: ${isFuture ? 0.25 : barH}rem;`}
                      title={`${m}: ${count} books`}
                    />
                    <span class="text-[10px] font-mono text-zinc-600">{m}</span>
                  </div>
                );
              })
            }
          </div>
          <!-- All years view (hidden by default) -->
          <div
            id="chart-all-years"
            class="hidden items-end gap-1"
            style="height: 7rem;"
          >
            {
              monthNames.map((m, i) => {
                const count = booksPerMonthAllYears[i];
                const barH = Math.max((count / maxMonthlyBoth) * 5, 0.25);
                return (
                  <div
                    class="flex-1 flex flex-col items-center justify-end gap-1 group"
                    style="height: 100%;"
                  >
                    <span class="text-[10px] font-mono text-zinc-500 opacity-0 group-hover:opacity-100 transition-opacity">
                      {count}
                    </span>
                    <div
                      class="w-full bg-[#eab308]/60 transition-colors hover:bg-[#eab308]"
                      style={`height: ${barH}rem;`}
                      title={`${m}: ${count} books`}
                    />
                    <span class="text-[10px] font-mono text-zinc-600">{m}</span>
                  </div>
                );
              })
            }
          </div>
        </div>
      </section>

      <!-- Book List -->
      <section id="book-list">
        {
          years.map((year) => (
            <div class="mb-9" data-year={year}>
              <div class="mb-3 flex items-center gap-3">
                <h2 class="font-mono text-xs font-semibold text-zinc-300">
                  {year}
                </h2>
                <div class="flex-1 h-px bg-zinc-800" />
                <span class="text-xs font-mono text-zinc-500 whitespace-nowrap">
                  {readByYear[year].length}{" "}
                  {readByYear[year].length === 1 ? "book" : "books"}
                </span>
              </div>
              <ul class="grid grid-cols-1 border-l border-t border-[#27272a] md:grid-cols-2">
                {readByYear[year].map((book) => (
                  <li class="compact-row group relative flex min-h-[7.25rem] gap-3 overflow-hidden border-b border-r border-[#27272a] p-2.5">
                    {book.cover ? (
                      <img
                        src={book.cover}
                        alt={`Cover of ${book.title}`}
                        width="72"
                        height="108"
                        class="h-[96px] w-[64px] shrink-0 border border-[#27272a] object-cover"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <div class="flex h-[96px] w-[64px] shrink-0 items-center justify-center border border-[#27272a] bg-zinc-900 font-mono text-[8px] uppercase tracking-wide text-zinc-700">
                        No cover
                      </div>
                    )}
                    <div class="flex flex-col flex-1 min-w-0 py-0.5">
                      <a
                        href={book.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="line-clamp-2 text-xs font-medium leading-snug text-zinc-200 transition-colors hover:text-[#eab308]"
                      >
                        {book.title}
                        <span class="sr-only">(opens in new tab)</span>
                      </a>
                      <p class="text-xs text-zinc-500 mt-1">{book.author}</p>
                      {book.rating > 0 &&
                        (() => {
                          const ratingLabels = {
                            1: "did not like it",
                            2: "it was ok",
                            3: "liked it",
                            4: "really liked it",
                            5: "it was amazing",
                          };
                          const r = Math.round(book.rating);
                          return (
                            <span class="flex items-center gap-1.5 mt-1.5">
                              <span class="font-mono text-[10px] text-[#eab308]">
                                {r}/5
                              </span>
                              <span class="text-[10px] text-zinc-500 font-mono">
                                {ratingLabels[r as keyof typeof ratingLabels]}
                              </span>
                            </span>
                          );
                        })()}
                      <div class="mt-auto pt-2 flex items-center gap-2 text-[11px] text-zinc-600 font-mono">
                        {book.num_pages && <span>Pages: {book.num_pages}</span>}
                        {book.user_read_at && (
                          <span class="ml-auto">
                            Read: {format(new Date(book.user_read_at), "MMM d")}
                          </span>
                        )}
                      </div>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </section>

          </>
        )
      }

      <!-- Footer -->
      <p
        class="mb-8 mt-4 border-t border-[#27272a] pt-3 text-right font-mono text-[10px] text-zinc-600"
      >
        Updated <time id="last-updated" datetime={now.toISOString()}></time>
      </p>
    </div>
  </Container>

  <script>
    function initReadingChartToggle() {
      const btnThisYear = document.getElementById("btn-this-year");
      const btnAllYears = document.getElementById("btn-all-years");
      const chartThisYear = document.getElementById("chart-this-year");
      const chartAllYears = document.getElementById("chart-all-years");

      if (!btnThisYear || !btnAllYears || !chartThisYear || !chartAllYears)
        return;
      if (btnThisYear.dataset.chartInitialized === "true") return;

      btnThisYear.dataset.chartInitialized = "true";
      btnThisYear.addEventListener("click", () => {
        chartThisYear.classList.remove("hidden");
        chartThisYear.classList.add("flex");
        chartAllYears.classList.add("hidden");
        chartAllYears.classList.remove("flex");
        btnThisYear.classList.add("bg-[#eab308]", "text-black");
        btnThisYear.classList.remove("text-zinc-500", "hover:text-zinc-300");
        btnAllYears.classList.remove("bg-[#eab308]", "text-black");
        btnAllYears.classList.add("text-zinc-500", "hover:text-zinc-300");
        btnThisYear.setAttribute("aria-pressed", "true");
        btnAllYears.setAttribute("aria-pressed", "false");
      });

      btnAllYears.addEventListener("click", () => {
        chartAllYears.classList.remove("hidden");
        chartAllYears.classList.add("flex");
        chartThisYear.classList.add("hidden");
        chartThisYear.classList.remove("flex");
        btnAllYears.classList.add("bg-[#eab308]", "text-black");
        btnAllYears.classList.remove("text-zinc-500", "hover:text-zinc-300");
        btnThisYear.classList.remove("bg-[#eab308]", "text-black");
        btnThisYear.classList.add("text-zinc-500", "hover:text-zinc-300");
        btnAllYears.setAttribute("aria-pressed", "true");
        btnThisYear.setAttribute("aria-pressed", "false");
      });
    }

    function formatLastUpdated() {
      const timeEl = document.getElementById("last-updated");
      if (!timeEl) return;
      const dt = timeEl.getAttribute("datetime");
      if (!dt) return;
      const date = new Date(dt);
      if (isNaN(date.getTime())) return;

      const datePart = date.toLocaleDateString("en-US", {
        month: "short",
        day: "numeric",
        year: "numeric",
      });
      const timePart = date.toLocaleTimeString("en-US", {
        hour: "numeric",
        minute: "2-digit",
        hour12: true,
      });
      timeEl.textContent = `${datePart} at ${timePart}`;
    }

    document.addEventListener("astro:page-load", () => {
      initReadingChartToggle();
      formatLastUpdated();
    });
  </script>
</Layout>
