---
export const prerender = false;

import Container from "@/components/Container.astro";
import Layout from "@/layouts/Layout.astro";
import DataHeader from "@/components/data/DataHeader.astro";
import ModelStackChart from "@/components/charts/ModelStackChart.astro";
import {
  buildCalendar,
  buildDailyStack,
  buildIntensityThresholds,
  buildUsageReport,
  usageLevel,
} from "@/lib/ccusage";
import { getUsageSnapshot } from "@/lib/ccusage-data";
import { env } from "cloudflare:workers";

const report = buildUsageReport(await getUsageSnapshot(env.CACHE));

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=900, stale-while-revalidate=3600",
);

const {
  days,
  activeDayCount,
  firstPeriod,
  lastPeriod,
  daysStale,
  totals,
  averageTokensPerDay,
  averageCostPerDay,
  costPerMillion,
  outputShare,
  tokenMix,
  models,
  agents,
  medianTokensPerDay,
} = report;

const latestDay = days[days.length - 1];

// --- Formatting -----------------------------------------------------------
const formatNumber = (value: number) => value.toLocaleString("en-US");

const formatCompact = (value: number) => {
  if (value >= 1_000_000_000) return `${(value / 1_000_000_000).toFixed(1)}B`;
  if (value >= 1_000_000) return `${(value / 1_000_000).toFixed(1)}M`;
  if (value >= 1_000) return `${(value / 1_000).toFixed(1)}K`;
  return formatNumber(value);
};

const formatCost = (value: number) =>
  value >= 100 ? `$${Math.round(value).toLocaleString("en-US")}` : `$${value.toFixed(2)}`;

/** Sub-cent rates need more precision than dollar totals. */
const formatRate = (value: number) => {
  if (value === 0) return "$0";
  if (value < 0.01) return `$${value.toFixed(4)}`;
  if (value < 1) return `$${value.toFixed(3)}`;
  return `$${value.toFixed(2)}`;
};

const formatPercent = (share: number, digits = 0) => {
  const pct = share * 100;
  if (pct > 0 && pct < 0.1) return "<0.1%";
  return `${pct.toFixed(digits)}%`;
};

const formatDay = (period: string, includeYear = false) =>
  new Date(`${period}T00:00:00Z`).toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    ...(includeYear ? { year: "numeric" } : {}),
    timeZone: "UTC",
  });

// --- Freshness ------------------------------------------------------------
// This export is refreshed by hand (`bun run data:usage`), so the page states
// plainly how current it is instead of implying it is live.
const freshnessCopy =
  daysStale === 0
    ? "synced today"
    : daysStale === 1
      ? "synced yesterday"
      : `${daysStale} days stale`;
const isStale = daysStale > 2;

// --- Headline stats -------------------------------------------------------
const statCells = [
  {
    label: "Tokens",
    value: formatCompact(totals.totalTokens),
    detail: formatNumber(totals.totalTokens),
  },
  { label: "Estimated cost", value: formatCost(totals.totalCost), detail: "ccusage pricing" },
  {
    label: "Blended rate",
    value: `${formatRate(costPerMillion)}/M`,
    detail: "per million tokens",
  },
  { label: "Active days", value: formatNumber(activeDayCount), detail: "days with usage" },
  {
    label: "Per active day",
    value: formatCompact(averageTokensPerDay),
    detail: `${formatCost(averageCostPerDay)} · median ${formatCompact(medianTokensPerDay)}`,
  },
  {
    label: "Output share",
    value: formatPercent(outputShare, 1),
    detail: `${formatCompact(totals.outputTokens)} generated`,
  },
];

// --- Daily use by model ---------------------------------------------------
// Stacked by model so the chart shows composition as well as magnitude. Both
// metrics are built so the page can toggle between them; see buildDailyStack for
// why cost is linear and tokens need a log scale.
const costStack = buildDailyStack(report, { topN: 6, metric: "cost" });
const tokenStack = buildDailyStack(report, { topN: 6, metric: "tokens" });


const peakDay = [...days].sort((a, b) => b.totalTokens - a.totalTokens)[0];
const priciestDay = [...days].sort((a, b) => b.totalCost - a.totalCost)[0];

// --- Token mix ------------------------------------------------------------
// Rendered as a single 100% stacked bar. Segment widths come straight from the
// token counts, so they are exact shares rather than a visual approximation.
const mixRows = tokenMix.map((slice) => ({
  ...slice,
  // One decimal: at zero decimals the 0.39% output slice renders as "0%".
  shareLabel: formatPercent(slice.share, 1),
  displayValue: formatNumber(slice.value),
  compactValue: formatCompact(slice.value),
  displayCost: formatCost(slice.cost),
}));
// --- Activity grid ----------------------------------------------------------
// One dot grid with three readings of the same data, switched by tabs:
//   Daily       one dot per day, shaded by that day's volume
//   Weekly      one column per week, dots stacked like a bar chart
//   Cumulative  the same columns, stacked against the running total
// Padded back to a full year so a young export still reads as a calendar.
const MIN_WEEKS = 52;
const GRID_ROWS = 7;
const calendarWeeks = buildCalendar(report, MIN_WEEKS);
const usageByPeriod = new Map(days.map((day) => [day.period, day]));
const tokenThresholds = buildIntensityThresholds(days);

const dayLabel = (period: string) => formatDay(period, true);

type Dot = { level: number; tip?: string };
type DotColumn = { dots: Dot[]; tip?: string; label: string };

const dailyColumns: DotColumn[] = calendarWeeks.map((week) => ({
  label: "",
  dots: week.map((period) => {
    // Dates outside the export's span are unknown, not zero, so they get no tooltip.
    if (period < firstPeriod || period > lastPeriod) return { level: 0 };
    const day = usageByPeriod.get(period);
    const tokens = day?.totalTokens ?? 0;
    return {
      level: usageLevel(tokens, tokenThresholds),
      tip: tokens
        ? `${dayLabel(period)}\n${formatCompact(tokens)} tokens · ${formatCost(day?.totalCost ?? 0)}`
        : `${dayLabel(period)}\nNo usage`,
    };
  }),
}));

// Weekly totals, then running totals. Both are drawn bottom-up as a column of
// GRID_ROWS dots, like the daily grid turned into a bar chart.
const weekStats = calendarWeeks.map((week) => {
  const inSpan = week.filter((period) => period >= firstPeriod && period <= lastPeriod);
  const tokens = inSpan.reduce((sum, period) => sum + (usageByPeriod.get(period)?.totalTokens ?? 0), 0);
  const cost = inSpan.reduce((sum, period) => sum + (usageByPeriod.get(period)?.totalCost ?? 0), 0);
  return { start: week[0], tracked: inSpan.length > 0, tokens, cost };
});
const maxWeekTokens = Math.max(...weekStats.map((week) => week.tokens), 1);
const allTokens = totals.totalTokens || 1;

/** Dots filled in a column, 0 for none and at least 1 for any usage at all. */
const dotsFor = (fraction: number) =>
  fraction <= 0 ? 0 : Math.min(GRID_ROWS, Math.max(1, Math.ceil(fraction * GRID_ROWS)));

/** Shade follows the same fraction, with the very top step reserved for the peak. */
const levelFor = (fraction: number) =>
  fraction <= 0 ? 0 : Math.min(5, Math.max(1, Math.ceil(fraction * 5)));

const stackedColumn = (filled: number, level: number, tip: string | undefined): DotColumn => ({
  label: "",
  tip,
  // Rows run top to bottom, so the filled dots are the last `filled` ones.
  dots: Array.from({ length: GRID_ROWS }, (_, row) => ({
    level: GRID_ROWS - row <= filled ? level : 0,
  })),
});

const weeklyColumns = weekStats.map((week) =>
  stackedColumn(
    dotsFor(Math.sqrt(week.tokens / maxWeekTokens)),
    levelFor(week.tokens / maxWeekTokens),
    week.tracked
      ? `Week of ${dayLabel(week.start)}\n${formatCompact(week.tokens)} tokens · ${formatCost(week.cost)}`
      : undefined,
  ),
);

let runningTokens = 0;
const cumulativeColumns = weekStats.map((week) => {
  runningTokens += week.tokens;
  return stackedColumn(
    dotsFor(runningTokens / allTokens),
    levelFor(runningTokens / allTokens),
    week.tracked
      ? `Through week of ${dayLabel(week.start)}\n${formatCompact(runningTokens)} tokens`
      : undefined,
  );
});

// Month labels sit under the week that contains the 1st. The first column is
// labelled too unless the next month starts right behind it and would overlap.
const monthName = (period: string) =>
  new Date(`${period}T00:00:00Z`).toLocaleDateString("en-US", { month: "short", timeZone: "UTC" });
const weekMonths = calendarWeeks.map((week, index) => {
  const firstOfMonth = week.find((period) => period.endsWith("-01"));
  if (firstOfMonth) return monthName(firstOfMonth);
  if (index !== 0) return "";
  const nextStart = calendarWeeks.findIndex((later) => later.some((period) => period.endsWith("-01")));
  return nextStart > 2 ? monthName(week[0]) : "";
});

const activityViews = [
  { id: "daily", label: "Daily", columns: dailyColumns },
  { id: "weekly", label: "Weekly", columns: weeklyColumns },
  { id: "cumulative", label: "Cumulative", columns: cumulativeColumns },
];

// Longest run of consecutive days with any usage.
const longestStreak = (() => {
  const active = days.filter((day) => day.totalTokens > 0).map((day) => day.period);
  let best = 0;
  let run = 0;
  let previous = 0;
  for (const period of active) {
    const time = Date.parse(`${period}T00:00:00Z`);
    run = previous && time - previous === 86_400_000 ? run + 1 : 1;
    best = Math.max(best, run);
    previous = time;
  }
  return best;
})();

// Level 0 is an unlit dot; 1–5 run from dim amber up to a pale peak.
const intensityClasses = [
  "bg-[#1b1b1e]",
  "bg-[#713f12]",
  "bg-[#a16207]",
  "bg-[#ca8a04]",
  "bg-[#eab308]",
  "bg-[#fde68a]",
] as const;

// --- Models ---------------------------------------------------------------
// Token volume and spend rank very differently, so the table folds both into
// one readable row per model rather than two competing bar columns.
// The library returns models ranked by token volume. The table is presented by
// spend instead, because that is what the cost bars and the callout below it
// describe, and the two rankings disagree sharply.
const paidModels = models
  .filter((model) => model.cost > 0)
  .sort((a, b) => b.cost - a.cost);
const freeModels = models.filter((model) => model.cost === 0);
const freeTokens = freeModels.reduce((sum, model) => sum + model.totalTokens, 0);

// Long tail of paid models stays collapsed behind a button.
const INITIAL_MODELS = 12;
const modelRows = paidModels.map((model) => ({
  ...model,
  displayTokens: formatCompact(model.totalTokens),
  displayCost: formatCost(model.cost),
  costShareLabel: formatPercent(model.costShare, 1),
  tokenShareLabel: formatPercent(model.tokenShare, 1),
  rate: formatRate(model.costPerMillion),
  costBar: model.costShare * 100,
}));

const freeModelRows = freeModels.map((model) => ({
  ...model,
  displayTokens: formatCompact(model.totalTokens),
  tokenShareLabel: formatPercent(model.tokenShare, 1),
  rate: formatRate(model.costPerMillion),
}));

const pageDescription =
  "AI coding token usage across models, agents and token types, with daily volume and blended cost rates.";
---

<Layout
  title="Token usage — Thinh's Corner"
  description={pageDescription}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "Dataset",
    name: "AI coding token usage",
    description: pageDescription,
    temporalCoverage: `${firstPeriod}/${lastPeriod}`,
    url: new URL("/data/token-usage", Astro.site).toString(),
  }}
>
  <Container>
    <div class="collection-page">
      <DataHeader title="Token usage" source="ccusage">
        Every token my coding agents have processed, by day, model, agent and token
        type, including how much of it was cheap cache traffic rather than generated
        output.
        <Fragment slot="meta">
          <span>{formatDay(firstPeriod, true)} – {formatDay(lastPeriod, true)}</span>
          <span class={isStale ? "text-[#ca8a04]" : undefined}>{freshnessCopy}</span>
        </Fragment>
      </DataHeader>

      <!-- Headline stats -->
      <section class="data-section">
        <dl class="data-stats" data-cols="3">
          {
            statCells.map((cell) => (
              <div class="data-stat">
                <dt class="data-stat-label">{cell.label}</dt>
                <dd class="data-stat-value">{cell.value}</dd>
                <dd class="data-stat-note">{cell.detail}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <!--
        Daily use by model, toggleable between cost and tokens.

        CSS-only toggle: the radio inputs are the first children of the flex
        wrapper, so every element that reacts to them (titles, toggle labels,
        panels) is a following sibling and can use peer-checked. No JS, and it
        still works with scripting disabled.
      -->
      <section class="data-section">
        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-2 border-t border-[#1f1f23] pt-4">
          <input
            id="stack-metric-cost"
            type="radio"
            name="stack-metric"
            class="peer/cost sr-only"
            checked
          />
          <input
            id="stack-metric-tokens"
            type="radio"
            name="stack-metric"
            class="peer/tokens sr-only"
          />

          <h2
            class="data-h2 hidden flex-1 peer-checked/cost:flex"
          >
            Daily spend by model
          </h2>
          <h2
            class="data-h2 hidden flex-1 peer-checked/tokens:flex"
          >
            Daily tokens by model
          </h2>

          <label
            for="stack-metric-cost"
            class="data-tab peer-checked/cost:border-[#eab308] peer-checked/cost:text-zinc-100"
          >
            Cost
          </label>
          <label
            for="stack-metric-tokens"
            class="data-tab ml-1.5 peer-checked/tokens:border-[#eab308] peer-checked/tokens:text-zinc-100"
          >
            Tokens
          </label>

          <div class="mt-3 hidden basis-full peer-checked/cost:block">
            <div>
              <ModelStackChart
                metric="cost"
                series={costStack.series}
                days={costStack.days}
                maxDayValue={costStack.maxDayValue}
                formatCost={formatCost}
                formatCompact={formatCompact}
                formatDay={formatDay}
              />
              <dl class="mt-4 flex flex-wrap gap-x-6 gap-y-1 text-sm">
                <div class="flex items-baseline gap-2">
                  <dt class="text-zinc-500">Priciest day</dt>
                  <dd class="text-zinc-400">
                    {formatDay(priciestDay.period, true)} · {formatCost(priciestDay.totalCost)}
                  </dd>
                </div>
                <div class="flex items-baseline gap-2">
                  <dt class="text-zinc-500">Days</dt>
                  <dd class="text-zinc-400">{activeDayCount} with usage</dd>
                </div>
              </dl>
            </div>
          </div>

          <div class="mt-3 hidden basis-full peer-checked/tokens:block">
            <div>
              <ModelStackChart
                metric="tokens"
                series={tokenStack.series}
                days={tokenStack.days}
                maxDayValue={tokenStack.maxDayValue}
                formatCost={formatCost}
                formatCompact={formatCompact}
                formatDay={formatDay}
              />
              <dl class="mt-4 flex flex-wrap gap-x-6 gap-y-1 text-sm">
                <div class="flex items-baseline gap-2">
                  <dt class="text-zinc-500">Busiest day</dt>
                  <dd class="text-zinc-400">
                    {formatDay(peakDay.period, true)} · {formatCompact(peakDay.totalTokens)} tokens
                  </dd>
                </div>
                <div class="flex items-baseline gap-2">
                  <dt class="text-zinc-500">Median day</dt>
                  <dd class="text-zinc-400">{formatCompact(medianTokensPerDay)} tokens</dd>
                </div>
              </dl>
            </div>
          </div>
        </div>
      </section>

      <!-- Token mix -->
      <section class="data-section">
        <div class="data-section-heading">
          <h2>Token mix</h2>
          <span class="data-section-note">{formatCost(totals.totalCost)} total</span>
        </div>

        <div>
          <!--
            One bar, as a true 100% stack: flex-grow is the raw token count, so
            segment widths are exact shares. Cache write is 0.01% of the total and
            would round to nothing, so each segment carries a 2px floor — about
            0.6% of the bar, against exact figures in the legend below.
          -->
          <div
            class="flex h-4 w-full gap-0.5 overflow-hidden rounded-full"
            role="img"
            aria-label={`Token mix: ${mixRows
              .map((row) => `${row.label} ${row.shareLabel}`)
              .join(", ")}`}
          >
            {
              mixRows.map((row) => (
                <div
                  class="min-w-[2px] transition-[filter] hover:brightness-125"
                  style={`flex:${row.value} 1 0%;background:${row.color}`}
                  title={`${row.label}: ${row.displayValue} tokens · ${row.shareLabel} · ${row.displayCost}`}
                />
              ))
            }
          </div>

          <ul class="mt-5 grid grid-cols-1 gap-x-10 gap-y-2.5 text-sm sm:grid-cols-2">
            {
              mixRows.map((row) => (
                <li class="flex items-center gap-3">
                  <span
                    class="size-2.5 shrink-0 rounded-full"
                    style={`background:${row.color}`}
                    aria-hidden="true"
                  />
                  <span class="min-w-0 flex-1 truncate text-zinc-200">{row.label}</span>
                  <span class="data-figure shrink-0">
                    {row.shareLabel} · {row.compactValue} · {row.displayCost}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- Agents -->
      <section class="data-section">
        <div class="data-section-heading">
          <h2>Agents</h2>
          <span class="data-section-note">By tokens</span>
        </div>

        <div class="grid grid-cols-1 gap-x-10 gap-y-7 sm:grid-cols-2">
          {
            agents.map((agent) => (
              <div>
                <div class="flex items-baseline justify-between gap-2">
                  <p class="font-medium text-zinc-200">{agent.agent}</p>
                  <span class="data-figure text-zinc-300">
                    {formatPercent(agent.tokenShare, 1)}
                  </span>
                </div>
                <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-[#1f1f23]">
                  <div class="h-full min-w-[2px] rounded-full bg-[#a78bfa]" style={`width:${agent.tokenShare * 100}%`} />
                </div>
                <p class="mt-2 text-sm text-zinc-500">
                  {formatCompact(agent.totalTokens)} tokens · {formatCost(agent.totalCost)} ·{" "}
                  {formatRate(agent.costPerMillion)}/M · {agent.activeDays}{" "}
                  {agent.activeDays === 1 ? "day" : "days"}
                </p>
              </div>
            ))
          }
        </div>
      </section>

      <!--
        Activity grid, switchable between daily, weekly and cumulative views.
        Same CSS-only radio toggle as the daily spend chart above: no JS needed to
        switch views (JS only drives the hover tooltips).
      -->
      <section class="data-section">
        <div class="flex flex-wrap items-baseline gap-y-2 border-t border-[#1f1f23] pt-4">
          {
            activityViews.map((view, index) => (
              <input
                id={`activity-${view.id}`}
                type="radio"
                name="activity-view"
                class={`peer/${view.id} sr-only`}
                checked={index === 0}
              />
            ))
          }

          <h2 class="data-h2 mr-3 flex-1">Active days</h2>

          <!-- Labels are direct siblings of the radios: peer-checked cannot reach a label
               nested inside a wrapper div. -->
          {
            activityViews.map((view, index) => (
              <label
                for={`activity-${view.id}`}
                class:list={[
                  "data-tab",
                  index > 0 && "ml-[1.125rem]",
                  view.id === "daily" && "peer-checked/daily:border-[#eab308] peer-checked/daily:text-zinc-100",
                  view.id === "weekly" && "peer-checked/weekly:border-[#eab308] peer-checked/weekly:text-zinc-100",
                  view.id === "cumulative" && "peer-checked/cumulative:border-[#eab308] peer-checked/cumulative:text-zinc-100",
                ]}
              >
                {view.label}
              </label>
            ))
          }

          {
            activityViews.map((view) => (
              <div
                class:list={[
                  "mt-4 hidden min-w-0 basis-full",
                  view.id === "daily" && "peer-checked/daily:block",
                  view.id === "weekly" && "peer-checked/weekly:block",
                  view.id === "cumulative" && "peer-checked/cumulative:block",
                ]}
              >
                <div>
                  <!-- Narrow screens scroll sideways rather than shrinking dots to specks;
                       the script parks the scroll position on the latest weeks. -->
                  <div class="-mx-1 overflow-x-auto overflow-y-hidden px-1 pb-1" data-activity-scroll>
                    <div class="min-w-[36rem]" role="group" aria-label={`${view.label} token activity`}>
                      <div class="flex gap-[3px]">
                        {view.columns.map((column) => (
                          <div
                            class:list={[
                              "flex min-w-0 flex-1 flex-col gap-[3px]",
                              column.tip && view.id !== "daily" && "group/column cursor-help",
                            ]}
                            tabindex={column.tip && view.id !== "daily" ? 0 : undefined}
                            role={column.tip && view.id !== "daily" ? "img" : undefined}
                            aria-label={column.tip?.replace("\n", ": ")}
                            data-daily-tooltip={view.id !== "daily" ? column.tip : undefined}
                          >
                            {column.dots.map((dot) => (
                              <span
                                class:list={[
                                  "activity-dot aspect-square w-full transition-[filter,box-shadow]",
                                  intensityClasses[dot.level],
                                  dot.tip &&
                                    "cursor-help hover:brightness-125 hover:shadow-[0_0_0_1px_rgb(244_244_245/0.7)] focus-visible:shadow-[0_0_0_1px_rgb(244_244_245)]",
                                  column.tip &&
                                    view.id !== "daily" &&
                                    "group-hover/column:brightness-125 group-focus-visible/column:brightness-125",
                                ]}
                                role={dot.tip ? "img" : undefined}
                                tabindex={dot.tip && dot.level > 0 ? 0 : undefined}
                                aria-label={dot.tip?.replace("\n", ": ")}
                                data-daily-tooltip={dot.tip}
                                data-lit={dot.level > 0 ? "" : undefined}
                              />
                            ))}
                          </div>
                        ))}
                      </div>

                      <div class="data-figure mt-2 flex gap-[3px] text-xs" aria-hidden="true">
                        {weekMonths.map((label) => (
                          <div class="relative h-3.5 min-w-0 flex-1">
                            <span class="absolute left-0 top-0 whitespace-nowrap leading-[0.875rem]">{label}</span>
                          </div>
                        ))}
                      </div>
                    </div>
                  </div>

                  <div class="mt-4 flex flex-wrap items-center justify-between gap-x-6 gap-y-2 text-sm text-zinc-500">
                    {view.id === "daily" && (
                      <dl class="flex flex-wrap gap-x-6 gap-y-1">
                        <div class="flex items-baseline gap-2">
                          <dt class="text-zinc-500">Busiest day</dt>
                          <dd class="text-zinc-400">
                            {formatDay(peakDay.period)} · {formatCompact(peakDay.totalTokens)}
                          </dd>
                        </div>
                        <div class="flex items-baseline gap-2">
                          <dt class="text-zinc-500">Longest streak</dt>
                          <dd class="text-zinc-400">{longestStreak} days</dd>
                        </div>
                      </dl>
                    )}
                    {view.id === "weekly" && (
                      <p>
                        Dots per week scale with the square root of tokens, so quiet weeks stay
                        visible next to the {formatCompact(maxWeekTokens)} peak.
                      </p>
                    )}
                    {view.id === "cumulative" && (
                      <p>
                        Running total of {formatCompact(totals.totalTokens)} tokens, filling toward the
                        latest week.
                      </p>
                    )}
                    <span class="flex items-center gap-1.5 text-xs" aria-hidden="true">
                      Less
                      {[0, 1, 2, 3, 4, 5].map((level) => (
                        <span class:list={["activity-dot size-2.5 shrink-0", intensityClasses[level]]} />
                      ))}
                      More
                    </span>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <div
        id="daily-usage-tooltip"
        role="tooltip"
        class="pointer-events-none fixed z-50 hidden whitespace-pre rounded-surface border border-[#3f3f46] bg-[#18181b]/95 px-3 py-2 text-xs leading-snug text-zinc-200 shadow-lg"
      >
      </div>

      <!-- Models -->
      <section class="data-section">
        <div class="data-section-heading">
          <h2>Models</h2>
          <span class="data-section-note">
            {models.length} models, by spend
          </span>
        </div>

        <div>
          <table class="w-full table-fixed border-collapse text-left">
            <thead>
              <tr class="border-b border-[#1f1f23] text-xs text-zinc-500">
                <th scope="col" class="w-[34%] pb-2.5 pr-2.5 font-normal">Model</th>
                <th
                  scope="col"
                  class="w-[18%] px-2.5 pb-2.5 text-right font-normal"
                  title="Tokens processed, and share of all tokens"
                >
                  Tokens
                </th>
                <th
                  scope="col"
                  class="w-[20%] px-2.5 pb-2.5 text-right font-normal"
                  title="Estimated cost, and share of total spend"
                >
                  Cost
                </th>
                <th
                  scope="col"
                  class="w-[16%] px-2.5 pb-2.5 text-right font-normal"
                  title="Blended cost per million tokens"
                >
                  Rate
                </th>
                <th scope="col" class="w-[12%] pb-2.5 pl-2.5 text-right font-normal">Days</th>
              </tr>
            </thead>
            <tbody>
              {
                modelRows.map((model, index) => (
                  <tr
                    class:list={[
                      "border-b border-[#1f1f23] transition-colors last:border-b-0",
                      index >= INITIAL_MODELS && "hidden",
                    ]}
                    data-extra-model={index >= INITIAL_MODELS ? "" : undefined}
                  >
                    <th scope="row" class="py-3 pr-2.5 text-left font-normal" title={model.modelName}>
                      <span class="block truncate text-sm text-zinc-200">
                        {model.modelName}
                      </span>
                      <span class="mt-2 block h-1 overflow-hidden rounded-full bg-[#1f1f23]">
                        <span
                          class="block h-full rounded-full bg-[#eab308]"
                          style={`width:${model.costBar}%`}
                        />
                      </span>
                    </th>
                    <td class="data-figure whitespace-nowrap px-2.5 py-3 text-right text-zinc-300">
                      {model.displayTokens}
                      <span class="block text-xs text-zinc-500">
                        {model.tokenShareLabel}
                      </span>
                    </td>
                    <td class="data-figure whitespace-nowrap px-2.5 py-3 text-right text-zinc-200">
                      {model.displayCost}
                      <span class="block text-xs text-zinc-500">
                        {model.costShareLabel}
                      </span>
                    </td>
                    <td class="data-figure whitespace-nowrap px-2.5 py-3 text-right">
                      {model.rate}
                    </td>
                    <td class="data-figure whitespace-nowrap py-3 pl-2.5 text-right">
                      {model.activeDays}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>

          {
            modelRows.length > INITIAL_MODELS && (
              <button
                type="button"
                id="models-show-all"
                class="data-show-more"
              >
                Show {modelRows.length - INITIAL_MODELS} more paid models ↓
              </button>
            )
          }

          {
            freeModelRows.length > 0 && (
              <details class="mt-4">
                <summary class="cursor-pointer text-sm text-zinc-500 transition-colors hover:text-zinc-200">
                  {freeModelRows.length} free-tier models, {formatCompact(freeTokens)} tokens at no cost
                </summary>
                <table class="w-full table-fixed border-collapse text-left">
                  <tbody>
                    {freeModelRows.map((model) => (
                      <tr class="border-b border-[#1f1f23] last:border-b-0">
                        <th
                          scope="row"
                          class="w-[42%] py-2.5 pr-2.5 text-left text-sm font-normal text-zinc-400"
                          title={model.modelName}
                        >
                          <span class="block truncate">{model.modelName}</span>
                        </th>
                        <td class="data-figure w-[16%] whitespace-nowrap p-2.5 text-right">
                          {model.displayTokens}
                        </td>
                        <td class="data-figure w-[18%] p-2.5 text-right text-[#4ade80]">
                          free
                        </td>
                        <td class="data-figure w-[16%] p-2.5 text-right">
                          —
                        </td>
                        <td class="data-figure w-[8%] py-2.5 pl-2.5 text-right">
                          {model.activeDays}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </details>
            )
          }
        </div>
      </section>

      <p class="mb-8 border-t border-[#1f1f23] pt-4 text-sm text-zinc-500">
        Counted by ccusage through {latestDay ? formatDay(latestDay.period, true) : "—"},{" "}
        <span class={isStale ? "text-[#ca8a04]" : undefined}>{freshnessCopy}</span>.
      </p>
    </div>
  </Container>

  <script>
    function initModelsShowAll() {
      const button = document.getElementById("models-show-all");
      if (!button || button.dataset.initialized === "true") return;
      button.dataset.initialized = "true";
      button.addEventListener("click", () => {
        document
          .querySelectorAll("[data-extra-model]")
          .forEach((row) => row.classList.remove("hidden"));
        button.remove();
      });
    }

    function initDailyUsageTooltips() {
      const tooltip = document.getElementById("daily-usage-tooltip");
      const cells = document.querySelectorAll<HTMLElement>("[data-daily-tooltip]");
      if (!tooltip || cells.length === 0 || tooltip.dataset.initialized === "true") return;

      tooltip.dataset.initialized = "true";
      let activeCell: HTMLElement | null = null;

      const hideTooltip = () => {
        tooltip.classList.add("hidden");
        activeCell = null;
      };

      const showTooltip = (cell: HTMLElement) => {
        const text = cell.dataset.dailyTooltip;
        if (!text) return;

        tooltip.textContent = text;
        tooltip.classList.remove("hidden");
        // Stacked columns anchor to their topmost lit dot, so the tooltip hugs the bar.
        const cellRect = (cell.querySelector("[data-lit]") ?? cell).getBoundingClientRect();
        const tooltipRect = tooltip.getBoundingClientRect();
        const margin = 8;
        const left = Math.min(
          Math.max(cellRect.left + cellRect.width / 2 - tooltipRect.width / 2, margin),
          window.innerWidth - tooltipRect.width - margin,
        );
        const above = cellRect.top - tooltipRect.height - margin;
        tooltip.style.left = `${left}px`;
        tooltip.style.top = `${above >= margin ? above : cellRect.bottom + margin}px`;
        activeCell = cell;
      };

      cells.forEach((cell) => {
        cell.addEventListener("pointerenter", () => showTooltip(cell));
        cell.addEventListener("pointerleave", () => {
          if (document.activeElement !== cell) hideTooltip();
        });
        cell.addEventListener("focus", () => showTooltip(cell));
        cell.addEventListener("blur", hideTooltip);
      });

      window.addEventListener(
        "scroll",
        () => {
          if (activeCell) showTooltip(activeCell);
        },
        { passive: true },
      );
      window.addEventListener("resize", () => {
        if (activeCell) showTooltip(activeCell);
      });
    }

    // On narrow screens the activity grid scrolls sideways; start at the latest weeks.
    function initActivityScroll() {
      document.querySelectorAll<HTMLElement>("[data-activity-scroll]").forEach((el) => {
        el.scrollLeft = el.scrollWidth;
      });
      // Hidden panels have no width yet, so park them when their tab is opened.
      document.querySelectorAll<HTMLInputElement>('input[name="activity-view"]').forEach((radio) => {
        radio.addEventListener("change", () => {
          document.querySelectorAll<HTMLElement>("[data-activity-scroll]").forEach((el) => {
            el.scrollLeft = el.scrollWidth;
          });
        });
      });
    }

    document.addEventListener("astro:page-load", () => {
      initActivityScroll();
      initDailyUsageTooltips();
      initModelsShowAll();
    });
  </script>
</Layout>
