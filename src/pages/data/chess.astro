---
export const prerender = false;
import Container from "@/components/Container.astro";
import Layout from "@/layouts/Layout.astro";
import DataHeader from "@/components/data/DataHeader.astro";
import { emptyChessOverview, getChessOverview } from "@/lib/chess";
import type { GameOutcome, HistoryPoint } from "@/lib/chess";
import { CHESS_PROFILE_URL, CHESS_USERNAME } from "../../../data/consts";
import { format, formatDistanceToNow } from "date-fns";
import { env } from "cloudflare:workers";

// Chess.com outages (with nothing cached yet) render a notice instead of a 500.
let data;
let unavailable = false;
try {
  data = await getChessOverview(CHESS_USERNAME, env.CACHE);
} catch (err) {
  console.error("[Chess] Overview unavailable:", err);
  data = emptyChessOverview(CHESS_USERNAME);
  unavailable = true;
}
const now = new Date();

Astro.response.headers.set(
  "Cache-Control",
  unavailable
    ? "public, s-maxage=60"
    : "public, s-maxage=600, stale-while-revalidate=300",
);

// --- Rating cards -----------------------------------------------------------
const statViews = data.stats
  .filter((s) => s.key !== "chess_bullet")
  .map((s) => {
  const total = s.win + s.loss + s.draw;
  return {
    ...s,
    total,
    winPct: total > 0 ? (s.win / total) * 100 : 0,
    drawPct: total > 0 ? (s.draw / total) * 100 : 0,
    lossPct: total > 0 ? (s.loss / total) * 100 : 0,
  };
});

// --- Rating history chart (inline SVG, no client deps) ----------------------
const SERIES_META = [
  { key: "rapid", label: "Rapid", color: "#eab308" },
  { key: "blitz", label: "Blitz", color: "#38bdf8" },
] as const;

// One point per day — the last game played that day — so sessions with many
// quick games don't pile up on a single x position.
const dailyPoints = (points: HistoryPoint[]): HistoryPoint[] => {
  const byDay = new Map<number, HistoryPoint>();
  for (const p of [...points].sort((a, b) => a.t - b.t)) {
    const d = new Date(p.t);
    byDay.set(
      Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate()),
      p,
    );
  }
  return [...byDay.values()];
};

const chartSeries = SERIES_META.map((meta) => ({
  ...meta,
  points: dailyPoints(data.history[meta.key] ?? []),
})).filter((series) => series.points.length > 0);

const allPoints = chartSeries.flatMap((s) => s.points);
const hasChart = allPoints.length >= 2;

const W = 720;
const H = 260;
const PAD = { l: 44, r: 14, t: 18, b: 30 };

// Round the y-range out to a "nice" step so gridlines land on round ratings.
let rMin = Math.min(...allPoints.map((p) => p.r));
let rMax = Math.max(...allPoints.map((p) => p.r));
if (!Number.isFinite(rMin)) rMin = 800;
if (!Number.isFinite(rMax)) rMax = 1600;
const yStep =
  [25, 50, 100, 200, 250, 500].find((step) => (rMax - rMin + 40) / step <= 5) ??
  1000;
const yLo = Math.floor((rMin - 20) / yStep) * yStep;
const yHi = Math.max(Math.ceil((rMax + 20) / yStep) * yStep, yLo + yStep * 2);

let tMin = Math.min(...allPoints.map((p) => p.t));
let tMax = Math.max(...allPoints.map((p) => p.t));
if (!Number.isFinite(tMin)) tMin = Date.now() - 86400000;
if (!Number.isFinite(tMax)) tMax = Date.now();
if (tMax === tMin) {
  tMin -= 43200000;
  tMax += 43200000;
}

const x = (t: number) =>
  PAD.l + ((t - tMin) / (tMax - tMin)) * (W - PAD.l - PAD.r);
const y = (r: number) =>
  PAD.t + (1 - (r - yLo) / (yHi - yLo)) * (H - PAD.t - PAD.b);

const yTicks = Array.from(
  { length: Math.round((yHi - yLo) / yStep) + 1 },
  (_, i) => yLo + yStep * i,
);
const xTicks = Array.from({ length: 4 }, (_, i) => tMin + ((tMax - tMin) / 3) * i);

const seriesViews = chartSeries.map((s) => ({
  ...s,
  pointsAttr: s.points
    .map((p) => `${x(p.t).toFixed(1)},${y(p.r).toFixed(1)}`)
    .join(" "),
}));

// --- Openings bars ----------------------------------------------------------
const maxOpeningCount = data.openings[0]?.count ?? 1;

// --- Recent games helpers ---------------------------------------------------
const outcomeStyles = {
  win: { text: "Won", class: "text-[#4ade80]" },
  loss: { text: "Lost", class: "text-[#f87171]" },
  draw: { text: "Draw", class: "text-zinc-400" },
} as const;

const formatDelta = (delta: number) =>
  `${delta > 0 ? "+" : ""}${delta}`;

// --- Form tiles --------------------------------------------------------------
const streakStyles = {
  win: { class: "text-[#4ade80]" },
  loss: { class: "text-[#f87171]" },
  draw: { class: "text-zinc-300" },
} as const satisfies Record<GameOutcome, { class: string }>;

const streakNoun = { win: "win", loss: "loss", draw: "draw" } as const;
const streakPlural = { win: "wins", loss: "losses", draw: "draws" } as const;

const hasGames = data.gamesFetched > 0;
const pageDescription =
  "Chess analytics from chess.com: ratings, history, openings and recent games.";

// --- Performance by colour ----------------------------------------------------
const perfViews = [
  {
    side: "white" as const,
    label: "As White",
    swatchClass: "bg-white",
  },
  {
    side: "black" as const,
    label: "As Black",
    swatchClass: "border border-zinc-500 bg-black",
  },
].map(({ side, label, swatchClass }) => {
  const perf = data.byColor[side];
  return {
    side,
    label,
    swatchClass,
    ...perf,
    winPct: perf.games > 0 ? (perf.win / perf.games) * 100 : 0,
    drawPct: perf.games > 0 ? (perf.draw / perf.games) * 100 : 0,
    lossPct: perf.games > 0 ? (perf.loss / perf.games) * 100 : 0,
  };
});
---

<Layout
  title="Chess — Thinh's Corner"
  description={pageDescription}
  image="/og/chess.jpg"
  structuredData={{
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Chess",
    description: pageDescription,
    url: new URL("/data/chess", Astro.site).toString(),
  }}
>
  <Container>
    <div class="collection-page">
      <DataHeader title="Chess" source="Chess.com" sourceHref={CHESS_PROFILE_URL} updated={unavailable ? undefined : now}>
        My rated games from the last {data.monthsCovered} months: ratings, form,
        openings and recent results, synced from{" "}
        <a href={CHESS_PROFILE_URL} class="text-link">chess.com</a>.
      </DataHeader>

      {
        unavailable && (
          <div class="data-section data-notice">
            <p>Chess.com isn’t responding right now.</p>
            <p>
              There’s nothing to show yet. Try again in a few minutes, or see the{" "}
              <a href={CHESS_PROFILE_URL} class="text-link">profile on chess.com</a>.
            </p>
          </div>
        )
      }

      {/* Everything below needs data; hidden during an outage. */}
      <!-- Profile / Player Card -->
      {!unavailable && (
      <>
      <section class="data-section">
        <div class="flex items-center gap-4">
          {
            data.profile.avatar ? (
              <img
                src={data.profile.avatar}
                alt=""
                width="56"
                height="56"
                loading="lazy"
                decoding="async"
                class="size-14 shrink-0 rounded-full object-cover"
              />
            ) : (
              <div class="size-14 shrink-0 rounded-full bg-zinc-900" />
            )
          }
          <div class="min-w-0">
            <h2 class="truncate text-lg font-medium tracking-tight text-zinc-100">
              {data.profile.name}
            </h2>
            <p class="text-sm text-zinc-500">
              <a
                href={CHESS_PROFILE_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="transition-colors hover:text-[#eab308]"
              >
                @{data.profile.username}
              </a>
              {data.profile.league && <span> · {data.profile.league} league</span>}
              <span> · playing since {format(data.profile.joined * 1000, "yyyy")}</span>
            </p>
          </div>
        </div>
      </section>

      <!-- Ratings & form -->
      {
        (statViews.length > 0 || hasGames) && (
          <section class="data-section">
            <div class="data-section-heading">
              <h2>Ratings and form</h2>
              {data.gamesFetched > 0 && (
                <span class="data-section-note">
                  {data.gamesFetched.toLocaleString()} rated games in {data.monthsCovered} months
                </span>
              )}
            </div>
            <dl class="data-stats" data-cols="3">
              {statViews.map((stat) => (
                <div class="data-stat">
                  <dt class="data-stat-label">{stat.label} rating</dt>
                  <dd class="data-stat-value">{stat.rating}</dd>
                  <dd class="order-3 mt-3">
                    <span class="record-bar">
                      <span class="bg-[#4ade80]/80" style={`width:${stat.winPct}%`} />
                      <span class="bg-zinc-600" style={`width:${stat.drawPct}%`} />
                      <span class="bg-[#f87171]/80" style={`width:${stat.lossPct}%`} />
                    </span>
                    <span class="data-figure mt-1.5 block">
                      <span class="text-[#4ade80]">{stat.win}W</span>{" "}
                      <span>{stat.draw}D</span>{" "}
                      <span class="text-[#f87171]">{stat.loss}L</span>
                      {stat.best && <span> · peak {stat.best}</span>}
                    </span>
                  </dd>
                </div>
              ))}
              {hasGames && (
                <>
                  <div class="data-stat">
                    <dt class="data-stat-label">Rating change</dt>
                    <dd
                      class:list={[
                        "data-stat-value",
                        data.ratingChange > 0 && "text-[#4ade80]",
                        data.ratingChange < 0 && "text-[#f87171]",
                      ]}
                    >
                      {formatDelta(data.ratingChange)}
                    </dd>
                    <dd class="data-stat-note">net points in this window</dd>
                  </div>
                  <div class="data-stat">
                    <dt class="data-stat-label">Current streak</dt>
                    <dd
                      class:list={[
                        "data-stat-value",
                        data.currentStreak && streakStyles[data.currentStreak.outcome].class,
                      ]}
                    >
                      {data.currentStreak
                        ? `${data.currentStreak.length} ${(data.currentStreak.length === 1 ? streakNoun : streakPlural)[data.currentStreak.outcome]}`
                        : "—"}
                    </dd>
                    <dd class="data-stat-note">best run: {data.bestWinStreak} wins</dd>
                  </div>
                  <div class="data-stat">
                    <dt class="data-stat-label">Average accuracy</dt>
                    <dd class="data-stat-value">
                      {data.avgAccuracy !== undefined ? `${data.avgAccuracy}%` : "—"}
                    </dd>
                    <dd class="data-stat-note">
                      opponents average {data.avgOpponentRating || "—"}
                    </dd>
                  </div>
                </>
              )}
            </dl>
          </section>
        )
      }

      <!-- Performance by colour -->
      {
        hasGames && (
          <section class="data-section">
            <div class="data-section-heading">
              <h2>By colour</h2>
            </div>
            <div class="grid gap-x-10 gap-y-8 md:grid-cols-2">
              {perfViews.map((perf) => (
                <div>
                  <div class="flex items-baseline justify-between gap-3">
                    <p class="flex items-center gap-2.5 text-zinc-300">
                      <span class:list={["size-3 shrink-0 rounded-full", perf.swatchClass]} />
                      {perf.label}
                    </p>
                    <span class="data-section-note shrink-0">
                      {perf.games} {perf.games === 1 ? "game" : "games"}
                    </span>
                  </div>
                  <p class="mt-2 text-2xl font-semibold tracking-tight">
                    <span class="text-[#4ade80]">{perf.win}W</span>{" "}
                    <span class="text-zinc-500">{perf.draw}D</span>{" "}
                    <span class="text-[#f87171]">{perf.loss}L</span>
                  </p>
                  <span class="record-bar mt-3">
                    <span class="bg-[#4ade80]/80" style={`width:${perf.winPct}%`} />
                    <span class="bg-zinc-600" style={`width:${perf.drawPct}%`} />
                    <span class="bg-[#f87171]/80" style={`width:${perf.lossPct}%`} />
                  </span>
                  <p class="mt-2 text-sm text-zinc-500">
                    Won {Math.round(perf.winPct)}% against an average rating of {perf.avgOpponentRating || "—"}
                    {perf.avgAccuracy !== undefined && <span>, {perf.avgAccuracy}% accuracy</span>}
                  </p>
                </div>
              ))}
            </div>
          </section>
        )
      }

      <!-- Rating history chart -->
      <section class="data-section">
        <div class="data-section-heading">
          <h2>Rating history</h2>
          {
            hasChart && (
              <div class="flex flex-wrap gap-4" role="group" aria-label="Toggle time classes">
                {seriesViews.map((series) => (
                  <button
                    type="button"
                    data-series-toggle={series.key}
                    aria-pressed="true"
                    class="flex items-center gap-2 text-sm text-zinc-300 transition-opacity"
                  >
                    <span class="size-2 rounded-full" style={`background:${series.color}`} />
                    {series.label}
                  </button>
                ))}
              </div>
            )
          }
        </div>

        {
          hasChart ? (
            <svg
              viewBox={`0 0 ${W} ${H}`}
              class="w-full"
              role="img"
              aria-label="Daily rating history per time class"
              preserveAspectRatio="xMidYMid meet"
            >
              {yTicks.map((tick) => (
                <g>
                  <line
                    x1={PAD.l}
                    x2={W - PAD.r}
                    y1={y(tick)}
                    y2={y(tick)}
                    stroke="#1f1f23"
                    stroke-width="1"
                  />
                  <text
                    x={PAD.l - 8}
                    y={y(tick) + 3}
                    text-anchor="end"
                    fill="#8f8f98"
                    font-size="10"
                    style="font-family: var(--font-mono)"
                  >
                    {Math.round(tick)}
                  </text>
                </g>
              ))}

              {xTicks.map((tick, i) => (
                <text
                  x={Math.min(Math.max(x(tick), PAD.l), W - PAD.r)}
                  y={H - 8}
                  text-anchor={i === 0 ? "start" : i === xTicks.length - 1 ? "end" : "middle"}
                  fill="#8f8f98"
                  font-size="10"
                  style="font-family: var(--font-mono)"
                >
                  {format(tick, "MMM d")}
                </text>
              ))}

              {seriesViews.map((series) => (
                <g data-series={series.key}>
                  {series.points.length === 1 ? (
                    <circle
                      cx={x(series.points[0].t)}
                      cy={y(series.points[0].r)}
                      r="3"
                      fill={series.color}
                    />
                  ) : (
                    <>
                      <polyline
                        points={series.pointsAttr}
                        fill="none"
                        stroke={series.color}
                        stroke-width="1.75"
                        stroke-linejoin="round"
                        stroke-linecap="round"
                      />
                      <circle
                        cx={x(series.points[series.points.length - 1].t)}
                        cy={y(series.points[series.points.length - 1].r)}
                        r="3"
                        fill={series.color}
                      />
                    </>
                  )}
                </g>
              ))}
            </svg>
          ) : (
            <p class="text-sm text-zinc-500">
              Not enough rated games in the window to draw a chart yet.
            </p>
          )
        }
      </section>

      <!-- Most played openings -->
      {
        data.openings.length > 0 && (
          <section class="data-section">
            <div class="data-section-heading">
              <h2>Most played openings</h2>
              <span class="data-section-note">games</span>
            </div>
            <ol class="space-y-3">
              {data.openings.map((opening) => (
                <li class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-4 gap-y-1.5 sm:grid-cols-[minmax(0,15rem)_minmax(0,1fr)_2rem]">
                  <span class="truncate text-sm text-zinc-200">{opening.name}</span>
                  <span class="data-figure text-right sm:order-3">{opening.count}</span>
                  <span class="col-span-2 block h-1.5 overflow-hidden rounded-full bg-[#1f1f23] sm:col-span-1">
                    <span
                      class="block h-full rounded-full bg-[#eab308]/85"
                      style={`width:${(opening.count / maxOpeningCount) * 100}%`}
                    />
                  </span>
                </li>
              ))}
            </ol>
          </section>
        )
      }

      <!-- Recent games -->
      <section class="data-section">
        <div class="data-section-heading">
          <h2>Recent games</h2>
          <span class="data-section-note">Last {data.recent.length}</span>
        </div>
        {
          data.recent.length === 0 ? (
            <p class="text-sm text-zinc-500">No rated games found in the window.</p>
          ) : (
            <div class="[&>a:last-child]:border-b-0">
              {data.recent.map((game) => (
                <a
                  href={game.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="data-row group flex items-center gap-3 py-3 sm:gap-4"
                >
                  <span
                    class:list={[
                      "w-10 shrink-0 text-sm font-medium",
                      outcomeStyles[game.outcome].class,
                    ]}
                  >
                    {outcomeStyles[game.outcome].text}
                  </span>
                  <span
                    class:list={[
                      "size-3 shrink-0 rounded-full",
                      game.color === "white" ? "bg-white" : "border border-zinc-500 bg-black",
                    ]}
                    title={`Played ${game.color}`}
                  />
                  <div class="min-w-0 flex-1">
                    <p class="truncate text-zinc-200 transition-colors group-hover:text-[#eab308]">
                      <span class="font-medium">{game.opponent}</span>
                      <span class="data-figure ml-2">{game.opponentRating}</span>
                    </p>
                    <p class="truncate text-sm text-zinc-500">
                      {game.opening ?? game.timeClass}
                    </p>
                  </div>
                  <div class="hidden shrink-0 text-right sm:block">
                    <p class="text-sm capitalize text-zinc-400">{game.timeClass}</p>
                    <p class="data-figure">
                      {formatDistanceToNow(new Date(game.endTime), { addSuffix: true })}
                    </p>
                  </div>
                  {
                    game.delta !== null && (
                      <span
                        class:list={[
                          "data-figure w-9 shrink-0 text-right",
                          game.delta > 0 ? "text-[#4ade80]" : game.delta < 0 ? "text-[#f87171]" : "",
                        ]}
                      >
                        {formatDelta(game.delta)}
                      </span>
                    )
                  }
                  <span class="sr-only">(opens in new tab)</span>
                </a>
              ))}
            </div>
          )
        }
      </section>
      </>
      )}

    </div>
  </Container>

  <script>
    function initChessToggles() {
      document
        .querySelectorAll<HTMLButtonElement>("[data-series-toggle]")
        .forEach((btn) => {
          if (btn.dataset.toggleInitialized === "true") return;
          btn.dataset.toggleInitialized = "true";

          btn.addEventListener("click", () => {
            const key = btn.dataset.seriesToggle;
            if (!key) return;

            const isOn = btn.getAttribute("aria-pressed") === "true";
            btn.setAttribute("aria-pressed", String(!isOn));
            btn.classList.toggle("opacity-40", isOn);

            document
              .querySelectorAll(`[data-series="${key}"]`)
              .forEach((el) => el.classList.toggle("hidden", isOn));
          });
        });
    }

    document.addEventListener("astro:page-load", () => {
      initChessToggles();
    });
  </script>
</Layout>
