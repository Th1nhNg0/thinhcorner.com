---
import Container from "@/components/Container.astro";
import Layout from "@/layouts/Layout.astro";
import BookIcon from "@/assets/icons/book-bookmark-bold.svg";
import MusicIcon from "@/assets/icons/music-note-bold.svg";
import ChessIcon from "@/assets/icons/chess-com.svg";
import SteamIcon from "@/assets/icons/steam.svg";
import ChartIcon from "@/assets/icons/chart-bar.svg";

// One entry per analysis — add new ones here and they show up automatically.
// Icons are .svg files in src/assets/icons, imported as Astro components and
// rendered with fill=currentColor so they inherit the card styling.
// Books & Music use the Solar set (https://icones.js.org/collection/solar,
// CC BY 4.0); Steam & Chess use simple-icons brand marks (CC0) for accuracy.
const pageDescription =
  "Production data views for what I play, read, listen to and measure across the services I use.";

const analyses = [
  {
    href: "/data/books",
    Icon: BookIcon,
    title: "Books",
    source: "goodreads",
    description:
      "Production reading analytics with yearly trends and ratings.",
  },
  {
    href: "/data/music",
    Icon: MusicIcon,
    title: "Music",
    source: "spotify",
    description:
      "Production listening analytics for recent tracks, top songs and artists.",
  },
  {
    href: "/data/chess",
    Icon: ChessIcon,
    title: "Chess",
    source: "chess.com",
    description:
      "Production chess analytics for ratings, history, openings and recent games.",
  },
  {
    href: "/data/steam",
    Icon: SteamIcon,
    title: "Steam",
    source: "steam web api",
    description:
      "Production analytics for library size, playtime and recent activity.",
  },
  {
    href: "/data/token-usage",
    Icon: ChartIcon,
    title: "Token usage",
    source: "ccusage",
    description:
      "Production analytics for daily token volume, token mix, agent usage and model distribution.",
  },
];
---

<Layout
  title="Data — Thinh's Corner"
  description={pageDescription}
  image="/og/data.jpg"
  structuredData={{
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Data",
    description: pageDescription,
    url: new URL("/data", Astro.site).toString(),
  }}
>
  <Container>
    <div class="collection-page">
      <header class="page-header">
        <h1 class="page-title">Data</h1>
        <p class="page-intro">
          Production views sourced from the services I use.
        </p>
      </header>

      <section class="mb-8">
        <div class="grid grid-cols-1 gap-px border border-[#27272a] bg-[#27272a] md:grid-cols-2">
          {
            analyses.map(({ href, Icon, title, source, description }) => (
              <a
                href={href}
                class="group flex flex-col justify-between bg-[#0c0c0d] p-4 transition-colors hover:bg-[#111113]"
              >
                <div class="flex items-start justify-between gap-3">
                  <span
                    class="flex size-9 items-center justify-center border border-[#27272a] text-zinc-500 transition-colors group-hover:text-[#eab308]"
                    aria-hidden="true"
                  >
                    <Icon class="size-5" />
                  </span>
                  <span class="font-mono text-sm text-zinc-700 transition-colors group-hover:text-[#eab308]">
                    →
                  </span>
                </div>
                <h2 class="mt-3 text-base font-medium text-zinc-200 transition-colors group-hover:text-[#eab308]">
                  {title}
                </h2>
                <p class="mt-1 text-sm leading-relaxed text-zinc-500">
                  {description}
                </p>
                <p class="mt-2 font-mono text-xs uppercase tracking-wide text-zinc-700">
                  {source}
                </p>
              </a>
            ))
          }
        </div>
      </section>
    </div>
  </Container>
</Layout>
