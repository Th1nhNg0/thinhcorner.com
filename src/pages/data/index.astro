---
import Container from "@/components/Container.astro";
import Layout from "@/layouts/Layout.astro";
import { analyses } from "@/data/analyses";

const pageDescription =
  "Live views of what I read, listen to, play and build with, pulled from the services I use.";
---

<Layout
  title="Data — Thinh's Corner"
  description={pageDescription}
  image="/og/data.jpg"
  structuredData={{
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Data",
    description: pageDescription,
    url: new URL("/data", Astro.site).toString(),
  }}
>
  <Container>
    <header class="page-header">
      <h1 class="page-title">Data</h1>
      <p class="page-intro">
        Live views of what I read, listen to, play and build with, pulled from the services I use
        and refreshed every few minutes.
      </p>
    </header>

    <ul class="grid grid-cols-1 gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {
        analyses.map(({ href, title, source, description, cover }, i) => (
          <li>
            <a href={href} class="cover-card group block">
              <span class="cover-frame">
                <img
                  src={cover.src}
                  width={cover.width}
                  height={cover.height}
                  alt=""
                  loading={i < 3 ? "eager" : "lazy"}
                  fetchpriority={i === 0 ? "high" : undefined}
                  decoding="async"
                />
              </span>
              <span class="mt-3 flex items-baseline justify-between gap-3">
                <span class="text-base font-medium text-zinc-100 transition-colors group-hover:text-[#eab308]">
                  {title}
                </span>
                <span class="shrink-0 font-mono text-xs text-zinc-600">{source}</span>
              </span>
              <span class="mt-1 block text-sm leading-relaxed text-zinc-500">{description}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </Container>
</Layout>
