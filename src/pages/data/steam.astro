---
export const prerender = false;
import Container from "@/components/Container.astro";
import Layout from "@/layouts/Layout.astro";
import DataHeader from "@/components/data/DataHeader.astro";
import SectionHeading from "@/components/data/SectionHeading.astro";
import StatGrid from "@/components/data/StatGrid.astro";
import { getSteamOverview } from "@/lib/steam";
import { STEAM_PROFILE_URL, STEAM_VANITY_ID } from "../../../data/consts";
import { format, formatDistanceToNow } from "date-fns";
import { env } from "cloudflare:workers";

const data = await getSteamOverview(env, env.CACHE, STEAM_VANITY_ID);
const now = new Date();

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=600, stale-while-revalidate=300",
);

const allGames = data?.allGames ?? [];
const recentGames = data?.recent ?? [];

const INITIAL_GAMES = 24;

const statCells = data
  ? [
      {
        label: "Games owned",
        value: (data.totals?.games ?? allGames.length).toLocaleString(),
        note: `${(data.totals?.unplayed ?? 0).toLocaleString()} under 1 h`,
      },
      {
        label: "Hours played",
        value: (data.totals?.hours ?? 0).toLocaleString(),
        note: `~${Math.round((data.totals?.hours ?? 0) / 24).toLocaleString()} days`,
      },
      {
        label: "Average per game",
        value: `${(data.totals?.avgHours ?? 0).toLocaleString()} h`,
        note: "mean playtime",
      },
      {
        label: "Typical game",
        value: `${(data.totals?.medianHours ?? 0).toLocaleString()} h`,
        note: "median playtime",
      },
    ]
  : [];

// Share of lifetime hours: the top games plus everything else.
const SHARE_COLORS = ["#eab308", "#38bdf8", "#a78bfa", "#4ade80", "#fb7185"];
const hourShares = (data?.hourShares ?? []).map((share, i) => ({
  ...share,
  color: SHARE_COLORS[i % SHARE_COLORS.length],
}));
const otherSharePct =
  Math.round(
    Math.max(0, 100 - hourShares.reduce((sum, share) => sum + share.pct, 0)) * 10,
  ) / 10;
const otherHours = Math.max(
  0,
  Math.round(
    ((data?.totals?.hours ?? 0) -
      hourShares.reduce((sum, share) => sum + share.hours, 0)) *
      10,
  ) / 10,
);

const tiers = data?.tiers ?? [];
const maxTier = Math.max(...tiers.map((tier) => tier.count), 1);

const pageDescription =
  "Steam analytics: library size, playtime, recent activity and full games list.";
---

<Layout
  title="Steam — Thinh's Corner"
  description={pageDescription}
  image="/og/steam.jpg"
  structuredData={{
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Steam",
    description: pageDescription,
    url: new URL("/data/steam", Astro.site).toString(),
  }}
>
  <Container>
    <div class="collection-page">
      <DataHeader
        title="Steam"
        source={data ? "Steam Web API" : undefined}
        sourceHref={STEAM_PROFILE_URL}
        updated={data ? now : undefined}
      >
        My library and where the hours actually went, synced from my{" "}
        <a href={STEAM_PROFILE_URL} class="text-link">Steam profile</a>.
      </DataHeader>

      {
        !data ? (
          <section class="data-section">
            <div class="data-notice">
              <p>
                This view needs a Steam API key.
              </p>
              <p>
                1 · Grab a free key at{" "}
                <a
                  href="https://steamcommunity.com/dev/apikey"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-link"
                >
                  steamcommunity.com/dev/apikey
                </a>
              </p>
              <p>
                2 · Local dev → add{" "}
                <span class="text-zinc-200">STEAM_API_KEY=…</span> to{" "}
                <span class="text-zinc-200">.dev.vars</span>, restart dev server
              </p>
              <p>
                3 · Production →{" "}
                <span class="text-zinc-200">
                  bunx wrangler secret put STEAM_API_KEY
                </span>{" "}
                and redeploy
              </p>
            </div>
          </section>
        ) : (
          <>
            <!-- Profile -->
            <section class="data-section">
              <div class="flex items-center gap-4">
                {
                  data.profile.avatarUrl ? (
                    <img
                      src={data.profile.avatarUrl}
                      alt=""
                      width="64"
                      height="64"
                      loading="lazy"
                      decoding="async"
                      class="size-14 shrink-0 rounded-full object-cover"
                    />
                  ) : (
                    <div class="size-14 shrink-0 rounded-full bg-zinc-900" />
                  )
                }
                <div class="min-w-0 flex-1">
                  <h2 class="truncate text-lg font-medium tracking-tight text-zinc-100">
                    {data.profile.personaName}
                  </h2>
                  <p class="text-sm text-zinc-500">
                    <a
                      href={STEAM_PROFILE_URL}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="transition-colors hover:text-[#eab308]"
                    >
                      @{STEAM_VANITY_ID}
                    </a>
                    {
                      data.profile.memberSince && !isNaN(new Date(data.profile.memberSince).getTime()) && (
                        <span> · on Steam since {format(new Date(data.profile.memberSince), "yyyy")}</span>
                      )
                    }
                  </p>
                </div>
              </div>
            </section>

            <!-- Totals -->
            <section class="data-section">
              <StatGrid stats={statCells} />
            </section>

            <!-- Recent -->
            <section class="data-section">
              <SectionHeading
                title="Played recently"
                note="Last 2 weeks"
              />
              {
                recentGames.length === 0 ? (
                  <p class="text-sm text-zinc-500">Nothing played in the last two weeks.</p>
                ) : (
                  <ul class="[&>li:last-child>a]:border-b-0">
                    {recentGames.map((game) => (
                      <li>
                        <a
                          href={`https://store.steampowered.com/app/${game.appId}`}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="data-row group flex items-center gap-4 py-3"
                        >
                          <span class="relative aspect-[460/215] w-24 shrink-0 overflow-hidden rounded-surface bg-zinc-900 sm:w-32">
                            <img
                              src={game.headerUrl || `https://cdn.cloudflare.steamstatic.com/steam/apps/${game.appId}/header.jpg`}
                              data-fallback={game.iconUrl || `https://cdn.cloudflare.steamstatic.com/steam/apps/${game.appId}/capsule_184x69.jpg`}
                              alt=""
                              width="460"
                              height="215"
                              loading="lazy"
                              decoding="async"
                              class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                            />
                          </span>
                          <span class="min-w-0 flex-1">
                            <span class="block truncate font-medium text-zinc-200 transition-colors group-hover:text-[#eab308]">
                              {game.name}
                            </span>
                            <span class="block truncate text-sm text-zinc-500">
                              {game.lastPlayed
                                ? `played ${formatDistanceToNow(new Date(game.lastPlayed), { addSuffix: true })}`
                                : "recent session"}
                              {" · "}
                              {(game.hoursTotal ?? 0).toLocaleString()} h total
                            </span>
                          </span>
                          <span class="shrink-0 whitespace-nowrap text-right text-lg font-medium tracking-tight text-[#eab308]">
                            +{(game.hoursLastTwoWeeks ?? 0).toLocaleString()} h
                          </span>
                          <span class="sr-only">(opens in new tab)</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                )
              }
            </section>

            <!-- Where the hours went + playtime spread -->
            {
              (hourShares.length > 0 || tiers.length > 0) && (
                <section class="data-section grid grid-cols-1 gap-x-10 gap-y-12 md:grid-cols-2">
                  {hourShares.length > 0 && (
                    <div>
                      <SectionHeading
                        title="Where the hours went"
                        note={`Top ${hourShares.length} take ${data.topSharePct}%`}
                      />
                      <div class="data-panel">
                        <div class="flex h-3 w-full gap-0.5 overflow-hidden rounded-full">
                          {hourShares.map((share) => (
                            <span
                              class="h-full"
                              style={`width:${share.pct}%;background:${share.color}`}
                              title={`${share.name}: ${share.pct}%`}
                            />
                          ))}
                          <span
                            class="h-full bg-zinc-700"
                            style={`width:${otherSharePct}%`}
                            title={`Everything else: ${otherSharePct}%`}
                          />
                        </div>
                        <ul class="mt-5 space-y-2.5">
                          {hourShares.map((share) => (
                            <li class="flex items-center gap-3 text-sm">
                              <span class="size-2.5 shrink-0 rounded-full" style={`background:${share.color}`} aria-hidden="true" />
                              <span class="min-w-0 flex-1 truncate text-zinc-200">{share.name}</span>
                              <span class="data-figure whitespace-nowrap">
                                {share.hours.toLocaleString()} h
                              </span>
                              <span class="data-figure w-11 text-right text-zinc-300">{share.pct}%</span>
                            </li>
                          ))}
                          <li class="flex items-center gap-3 text-sm">
                            <span class="size-2.5 shrink-0 rounded-full bg-zinc-700" aria-hidden="true" />
                            <span class="min-w-0 flex-1 truncate text-zinc-500">
                              Everything else ({Math.max(allGames.length - hourShares.length, 0)} games)
                            </span>
                            <span class="data-figure whitespace-nowrap">
                              {otherHours.toLocaleString()} h
                            </span>
                            <span class="data-figure w-11 text-right">{otherSharePct}%</span>
                          </li>
                        </ul>
                      </div>
                    </div>
                  )}
                  {tiers.length > 0 && (
                    <div>
                      <SectionHeading title="Playtime spread" note="Games by lifetime hours" />
                      <div class="data-panel">
                        <div class="flex h-40 items-end gap-3 border-b border-[#1f1f23]">
                          {tiers.map((tier) => (
                            <div
                              class="group flex h-full flex-1 flex-col items-center justify-end gap-1"
                              title={`${tier.label}: ${tier.count} games`}
                            >
                              <span class="data-figure transition-colors group-hover:text-[#eab308]">
                                {tier.count}
                              </span>
                              <div
                                class="w-full rounded-t-sm bg-[#eab308]/70 transition-colors group-hover:bg-[#eab308]"
                                style={`height:${Math.max((tier.count / maxTier) * 82, tier.count ? 3 : 1)}%`}
                              />
                            </div>
                          ))}
                        </div>
                        <div class="mt-2 flex gap-3">
                          {tiers.map((tier) => (
                            <span class="data-figure flex-1 text-center">
                              {tier.label.replace("Under ", "<")}
                            </span>
                          ))}
                        </div>
                      </div>
                    </div>
                  )}
                </section>
              )
            }

            <!-- All games -->
            {
              allGames.length > 0 && (
                <section class="data-section" id="steam-all-games">
                  <SectionHeading title="Library">
                    <span id="steam-count-display" class="data-section-note">
                      {allGames.length} games
                    </span>
                  </SectionHeading>

                  <!-- Search and filter controls -->
                  <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
                    <div class="relative flex-1">
                      <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center text-zinc-500">
                        <svg
                          class="size-4"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <circle cx="11" cy="11" r="8" />
                          <path d="m21 21-4.3-4.3" />
                        </svg>
                      </div>
                      <input
                        type="text"
                        id="steam-search-input"
                        placeholder="Search games"
                        class="h-9 w-full border-b border-[#27272a] bg-transparent pl-7 pr-8 text-sm text-zinc-200 transition-colors placeholder:text-zinc-600 focus:border-[#eab308] focus:outline-none"
                        autocomplete="off"
                        spellcheck="false"
                      />
                      <button
                        type="button"
                        id="steam-search-clear"
                        class="absolute inset-y-0 right-0 hidden items-center pr-1 text-sm text-zinc-500 hover:text-zinc-200"
                        aria-label="Clear search"
                      >
                        ✕
                      </button>
                    </div>

                    <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
                      <!-- Filter status -->
                      <div class="segmented" role="group" aria-label="Filter games">
                        <button
                          type="button"
                          data-filter="all"
                          class="steam-filter-btn"
                          aria-pressed="true"
                        >
                          All
                        </button>
                        <button
                          type="button"
                          data-filter="played"
                          class="steam-filter-btn"
                          aria-pressed="false"
                        >
                          Played
                        </button>
                        <button
                          type="button"
                          data-filter="unplayed"
                          class="steam-filter-btn"
                          aria-pressed="false"
                        >
                          Unplayed
                        </button>
                      </div>

                      <!-- Sort dropdown -->
                      <div>
                        <select
                          id="steam-sort-select"
                          class="h-9 cursor-pointer rounded-surface border border-[#27272a] bg-[#0c0c0d] px-2.5 text-sm text-zinc-300 focus:border-[#eab308] focus:outline-none"
                          aria-label="Sort games"
                        >
                          <option value="hours-desc">Most played</option>
                          <option value="hours-asc">Least played</option>
                          <option value="name-asc">Title A to Z</option>
                          <option value="name-desc">Title Z to A</option>
                          <option value="recent-desc">Recently played</option>
                        </select>
                      </div>
                    </div>
                  </div>

                  <!-- Games grid -->
                  <div
                    id="steam-games-list"
                    class="grid grid-cols-2 gap-x-5 gap-y-7 md:grid-cols-4"
                  >
                    {allGames.map((game, index) => (
                      <a
                        href={`https://store.steampowered.com/app/${game.appId}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class:list={[
                          "steam-game-item group flex min-w-0 flex-col justify-between",
                          index >= INITIAL_GAMES && "hidden",
                        ]}
                        data-name={game.name.toLowerCase()}
                        data-hours={game.hours ?? 0}
                        data-last-played={game.lastPlayed ?? 0}
                        data-default-order={index}
                      >
                        <div>
                          <div class="relative mb-2.5 aspect-[460/215] w-full overflow-hidden rounded-surface bg-zinc-900">
                            <img
                              src={game.headerUrl || `https://cdn.cloudflare.steamstatic.com/steam/apps/${game.appId}/header.jpg`}
                              data-fallback={game.iconUrl || `https://cdn.cloudflare.steamstatic.com/steam/apps/${game.appId}/capsule_184x69.jpg`}
                              alt={game.name}
                              width="460"
                              height="215"
                              loading="lazy"
                              decoding="async"
                              class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                            />
                            {game.hoursLastTwoWeeks !== undefined &&
                              game.hoursLastTwoWeeks > 0 && (
                                <span class="absolute bottom-1.5 right-1.5 rounded-sm bg-black/80 px-1.5 py-0.5 font-mono text-xs text-[#eab308]">
                                  +{game.hoursLastTwoWeeks} h
                                </span>
                              )}
                          </div>
                          <p class="truncate text-sm font-medium text-zinc-200 transition-colors group-hover:text-[#eab308]">
                            {game.name}
                          </p>
                        </div>
                        <div class="mt-0.5 flex items-baseline justify-between gap-2">
                          <p
                            class:list={[
                              "data-figure shrink-0 whitespace-nowrap",
                              (game.hours ?? 0) > 0 && "text-[#eab308]",
                            ]}
                          >
                            {(game.hours ?? 0) > 0
                              ? `${(game.hours ?? 0).toLocaleString()} h`
                              : "0 h"}
                          </p>
                          {game.lastPlayed ? (
                            <p class="truncate text-xs text-zinc-500">
                              {formatDistanceToNow(new Date(game.lastPlayed), {
                                addSuffix: true,
                              })}
                            </p>
                          ) : (
                            <p class="text-xs text-zinc-500">Unplayed</p>
                          )}
                        </div>
                      </a>
                    ))}
                  </div>

                  {allGames.length > INITIAL_GAMES && (
                    <button type="button" id="steam-show-all" class="data-show-more">
                      Show all {allGames.length} games ↓
                    </button>
                  )}

                  <div
                    id="steam-no-results"
                    class="hidden py-6 text-sm text-zinc-500"
                  >
                    No games match your search or filter.
                  </div>
                </section>
              )
            }
          </>
        )
      }

    </div>
  </Container>

  <script>
    function initSteamLibrary() {
      const searchInput = document.getElementById(
        "steam-search-input",
      ) as HTMLInputElement | null;
      const clearBtn = document.getElementById(
        "steam-search-clear",
      ) as HTMLButtonElement | null;
      const countEl = document.getElementById("steam-count-display");
      const noResultsEl = document.getElementById("steam-no-results");
      const listContainer = document.getElementById("steam-games-list");
      const filterBtns =
        document.querySelectorAll<HTMLButtonElement>(".steam-filter-btn");
      const sortSelect = document.getElementById(
        "steam-sort-select",
      ) as HTMLSelectElement | null;

      if (!listContainer || !searchInput) return;
      if (searchInput.dataset.initialized === "true") return;
      searchInput.dataset.initialized = "true";

      const rows = Array.from(
        listContainer.querySelectorAll<HTMLElement>(".steam-game-item"),
      );
      const totalCount = rows.length;
      const showAllBtn = document.getElementById("steam-show-all");
      const initialCount = 24;
      let currentFilter = "all";
      let expanded = false;

      function applyFilterAndSearch() {
        const query = (searchInput?.value ?? "").trim().toLowerCase();

        if (clearBtn) {
          if (query.length > 0) {
            clearBtn.classList.remove("hidden");
            clearBtn.classList.add("flex");
          } else {
            clearBtn.classList.add("hidden");
            clearBtn.classList.remove("flex");
          }
        }

        let matchCount = 0;
        // Collapse to the first rows (in current sort order) until the reader
        // expands the list or narrows it with search or a filter.
        const collapsed = !expanded && query === "" && currentFilter === "all";
        const ordered = Array.from(
          listContainer!.querySelectorAll<HTMLElement>(".steam-game-item"),
        );

        ordered.forEach((row) => {
          const name = row.dataset.name || "";
          const hours = parseFloat(row.dataset.hours || "0");

          const matchesSearch = query === "" || name.includes(query);

          let matchesFilter = true;
          if (currentFilter === "played") {
            matchesFilter = hours > 0;
          } else if (currentFilter === "unplayed") {
            matchesFilter = hours === 0;
          }

          const matches = matchesSearch && matchesFilter;
          const visible = matches && (!collapsed || matchCount < initialCount);
          row.classList.toggle("hidden", !visible);
          if (matches) {
            matchCount++;
          }
        });

        showAllBtn?.classList.toggle("hidden", !collapsed);

        if (countEl) {
          if (query || currentFilter !== "all") {
            countEl.textContent = `${matchCount} of ${totalCount} games`;
          } else {
            countEl.textContent = `${totalCount} games`;
          }
        }

        if (noResultsEl) {
          if (matchCount === 0) {
            noResultsEl.classList.remove("hidden");
          } else {
            noResultsEl.classList.add("hidden");
          }
        }
      }

      function applySort() {
        const sortValue = sortSelect?.value || "hours-desc";

        const sortedRows = [...rows].sort((a, b) => {
          const hoursA = parseFloat(a.dataset.hours || "0");
          const hoursB = parseFloat(b.dataset.hours || "0");
          const nameA = a.dataset.name || "";
          const nameB = b.dataset.name || "";
          const playedA = parseInt(a.dataset.lastPlayed || "0", 10);
          const playedB = parseInt(b.dataset.lastPlayed || "0", 10);

          switch (sortValue) {
            case "hours-desc":
              return hoursB - hoursA || nameA.localeCompare(nameB);
            case "hours-asc":
              return hoursA - hoursB || nameA.localeCompare(nameB);
            case "name-asc":
              return nameA.localeCompare(nameB);
            case "name-desc":
              return nameB.localeCompare(nameA);
            case "recent-desc":
              return playedB - playedA || hoursB - hoursA;
            default:
              return 0;
          }
        });

        sortedRows.forEach((row) => {
          listContainer?.appendChild(row);
        });

        applyFilterAndSearch();
      }

      searchInput.addEventListener("input", applyFilterAndSearch);

      showAllBtn?.addEventListener("click", () => {
        expanded = true;
        applyFilterAndSearch();
      });

      clearBtn?.addEventListener("click", () => {
        if (searchInput) {
          searchInput.value = "";
          searchInput.focus();
        }
        applyFilterAndSearch();
      });

      filterBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          currentFilter = btn.dataset.filter || "all";
          filterBtns.forEach((b) => {
            const active = b === btn;
            b.setAttribute("aria-pressed", String(active));
          });
          applyFilterAndSearch();
        });
      });

      sortSelect?.addEventListener("change", applySort);
    }

    function initImageFallbacks() {
      window.addEventListener(
        "error",
        (e) => {
          const target = e.target as HTMLElement | null;
          if (target instanceof HTMLImageElement && target.dataset.fallback) {
            if (target.src !== target.dataset.fallback) {
              target.src = target.dataset.fallback;
              target.classList.remove("object-cover");
              target.classList.add("object-contain", "p-3", "bg-zinc-900/80");
            } else {
              target.style.opacity = "0.2";
            }
          }
        },
        true,
      );
    }

    document.addEventListener("astro:page-load", () => {
      initImageFallbacks();
      initSteamLibrary();
    });
  </script>
</Layout>
