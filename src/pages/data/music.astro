---
export const prerender = false;
import Container from "@/components/Container.astro";
import Layout from "@/layouts/Layout.astro";
import DataHeader from "@/components/data/DataHeader.astro";
import SectionHeading from "@/components/data/SectionHeading.astro";
import {
  getRecentlyPlayed,
  getTopArtists,
  getTopTracks,
  isSpotifyConfigured,
} from "@/lib/spotify";
import type {
  RecentlyPlayedTrack,
  TopArtist,
  TopTrack,
} from "@/lib/spotify";
import { SOCIAL_MEDIA } from "../../../data/consts";
import { formatDistanceToNow } from "date-fns";
import { env } from "cloudflare:workers";

// Skip all Spotify API calls when credentials are missing; the page renders a
// setup notice instead.
const configured = isSpotifyConfigured(env);

let recentlyPlayed: RecentlyPlayedTrack[] = [];
let topTracksShort: TopTrack[] = [];
let topTracksMedium: TopTrack[] = [];
let topTracksLong: TopTrack[] = [];
let topArtistsShort: TopArtist[] = [];
let topArtistsMedium: TopArtist[] = [];
let topArtistsLong: TopArtist[] = [];

if (configured) {
  [
    recentlyPlayed,
    topTracksShort,
    topTracksMedium,
    topTracksLong,
    topArtistsShort,
    topArtistsMedium,
    topArtistsLong,
  ] = await Promise.all([
    getRecentlyPlayed(env, env.CACHE),
    getTopTracks(env, env.CACHE, "short_term"),
    getTopTracks(env, env.CACHE, "medium_term"),
    getTopTracks(env, env.CACHE, "long_term"),
    getTopArtists(env, env.CACHE, "short_term"),
    getTopArtists(env, env.CACHE, "medium_term"),
    getTopArtists(env, env.CACHE, "long_term"),
  ]);
}

const tracksByRange = {
  short_term: topTracksShort,
  medium_term: topTracksMedium,
  long_term: topTracksLong,
};

const artistsByRange = {
  short_term: topArtistsShort,
  medium_term: topArtistsMedium,
  long_term: topArtistsLong,
};

const timeRanges = [
  { key: "short_term", label: "4 Weeks" },
  { key: "medium_term", label: "6 Months" },
  { key: "long_term", label: "All Time" },
] as const;

const now = new Date();

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=600, stale-while-revalidate=300",
);

const pageDescription =
  "Listening analytics from Spotify: recent tracks, top songs and artists.";
---

<Layout
  title="Music — Thinh's Corner"
  description={pageDescription}
  image="/og/music.jpg"
  structuredData={{
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Music",
    description: pageDescription,
    url: new URL("/data/music", Astro.site).toString(),
  }}
>
  <Container>
    <div class="collection-page">
      <DataHeader title="Music" source="spotify" sourceHref={SOCIAL_MEDIA.spotify} updated={now}>
        What I have been listening to lately, and the tracks and artists I keep
        coming back to, from my{" "}
        <a href={SOCIAL_MEDIA.spotify} class="text-link">Spotify profile</a>.
      </DataHeader>

      {
        !configured && (
          <section class="data-section">
            <div class="space-y-2 border border-[#27272a] bg-[#0c0c0d] p-6 font-mono text-xs leading-relaxed text-zinc-400">
              <p class="text-[#eab308]">
                This view needs a Spotify connection.
              </p>
              <p>
                1 · Create an app at{" "}
                <a
                  href="https://developer.spotify.com/dashboard"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-link"
                >
                  developer.spotify.com/dashboard
                </a>{" "}
                and generate a refresh token
              </p>
              <p>
                2 · Local dev → set{" "}
                <span class="text-zinc-200">SPOTIFY_CLIENT_ID</span>,{" "}
                <span class="text-zinc-200">SPOTIFY_CLIENT_SECRET</span> and{" "}
                <span class="text-zinc-200">SPOTIFY_REFRESH_TOKEN</span> in{" "}
                <span class="text-zinc-200">.dev.vars</span>, then restart the
                server
              </p>
              <p>
                3 · Production →{" "}
                <span class="text-zinc-200">
                  bunx wrangler secret put SPOTIFY_CLIENT_ID
                </span>{" "}
                (and the other two)
              </p>
            </div>
          </section>
        )
      }

      {
        configured && (
          <>
      <section class="data-section">
        <SectionHeading title="Recently played" note={`${recentlyPlayed.length} tracks`} />
        <ol class="border-t border-[#27272a]">
          {
            recentlyPlayed.map((track) => (
              <li>
                <a
                  href={track.songUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="compact-row group flex items-center gap-3 border-b border-[#27272a] px-2 py-2.5"
                >
                  <img
                    src={track.imageUrl}
                    alt=""
                    width="64"
                    height="64"
                    loading="lazy"
                    decoding="async"
                    class="size-11 shrink-0 border border-[#27272a] object-cover"
                  />
                  <span class="min-w-0 flex-1">
                    <span class="block truncate text-sm font-medium text-zinc-200 transition-colors group-hover:text-[#eab308]">
                      {track.title}
                    </span>
                    <span class="block truncate text-xs text-zinc-500">
                      {track.artist}
                    </span>
                  </span>
                  <time
                    datetime={track.played_at}
                    class="shrink-0 font-mono text-[11px] text-zinc-600"
                  >
                    {formatDistanceToNow(new Date(track.played_at), {
                      addSuffix: true,
                    })}
                  </time>
                  <span class="sr-only">(opens in new tab)</span>
                </a>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="data-section">
        <SectionHeading title="Top tracks">
          <div class="segmented" role="group" aria-label="Top tracks time range">
            {
              timeRanges.map((range, i) => (
                <button
                  type="button"
                  data-range-group="tracks"
                  data-range={range.key}
                  aria-pressed={i === 0 ? "true" : "false"}
                >
                  {range.label}
                </button>
              ))
            }
          </div>
        </SectionHeading>
        {
          timeRanges.map((range, i) => (
            <ol
              id={`tracks-${range.key}`}
              class:list={[
                "grid-cols-3 border-l border-t border-[#27272a] md:grid-cols-5",
                i === 0 ? "grid" : "hidden",
              ]}
            >
              {tracksByRange[range.key].map((track, index) => (
                <li class="border-b border-r border-[#27272a] last:hidden md:last:block">
                  <a
                    href={track.songUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="compact-row group block h-full p-2"
                  >
                    <span class="relative mb-2 block aspect-square overflow-hidden">
                      <img
                        src={track.imageUrl}
                        alt=""
                        width="300"
                        height="300"
                        loading="lazy"
                        decoding="async"
                        class="h-full w-full border border-[#27272a] object-cover transition-transform duration-300 group-hover:scale-[1.03]"
                      />
                      <span class="absolute left-0 top-0 bg-[#0c0c0d]/90 px-1.5 py-0.5 font-mono text-[11px] text-zinc-300 group-hover:text-[#eab308]">
                        {String(index + 1).padStart(2, "0")}
                      </span>
                    </span>
                    <span class="block truncate text-xs font-medium text-zinc-200 transition-colors group-hover:text-[#eab308]">
                      {track.title}
                    </span>
                    <span class="block truncate text-xs text-zinc-500">
                      {track.artist}
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          ))
        }
      </section>

      <section class="data-section">
        <SectionHeading title="Top artists">
          <div class="segmented" role="group" aria-label="Top artists time range">
            {
              timeRanges.map((range, i) => (
                <button
                  type="button"
                  data-range-group="artists"
                  data-range={range.key}
                  aria-pressed={i === 0 ? "true" : "false"}
                >
                  {range.label}
                </button>
              ))
            }
          </div>
        </SectionHeading>
        {
          timeRanges.map((range, i) => {
            const artists = artistsByRange[range.key];
            // Trim to full rows: 2 columns on mobile, 4 on desktop.
            const mobileCount = artists.length - (artists.length % 2);
            const desktopCount = artists.length - (artists.length % 4);
            return (
              <ol
                id={`artists-${range.key}`}
                class:list={[
                  "grid-cols-2 border-l border-t border-[#27272a] md:grid-cols-4",
                  i === 0 ? "grid" : "hidden",
                ]}
              >
                {artists.map((artist, index) => (
                  <li
                    class:list={[
                      "border-b border-r border-[#27272a]",
                      index < mobileCount ? "block" : "hidden",
                      index < desktopCount ? "md:block" : "md:hidden",
                    ]}
                  >
                    <a
                      href={artist.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="group relative block aspect-square overflow-hidden bg-[#111113]"
                    >
                      {artist.imageUrl ? (
                        <img
                          src={artist.imageUrl}
                          alt=""
                          width="320"
                          height="320"
                          loading="lazy"
                          decoding="async"
                          class="absolute inset-0 h-full w-full object-cover opacity-75 grayscale-[35%] transition duration-300 group-hover:scale-[1.03] group-hover:opacity-95 group-hover:grayscale-0"
                        />
                      ) : (
                        <span class="absolute inset-0 flex items-center justify-center text-4xl font-semibold text-zinc-800">
                          {artist.name.slice(0, 1)}
                        </span>
                      )}
                      <span class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent" />
                      <span class="absolute left-0 top-0 bg-[#0c0c0d]/90 px-1.5 py-0.5 font-mono text-[11px] text-zinc-300 group-hover:text-[#eab308]">
                        {String(index + 1).padStart(2, "0")}
                      </span>
                      <span class="absolute inset-x-0 bottom-0 p-3">
                        <span class="block truncate text-sm font-medium text-white transition-colors group-hover:text-[#eab308]">
                          {artist.name}
                        </span>
                        <span class="mt-0.5 block font-mono text-[11px] text-zinc-400">
                          {new Intl.NumberFormat("en", { notation: "compact" }).format(artist.followers)} followers
                        </span>
                        <span class="mt-1.5 block h-0.5 bg-white/15" title={`Popularity ${artist.popularity}/100`}>
                          <span class="block h-full bg-[#eab308]" style={`width:${artist.popularity}%`} />
                        </span>
                      </span>
                    </a>
                  </li>
                ))}
              </ol>
            );
          })
        }
      </section>

          </>
        )
      }
    </div>
  </Container>

  <script>
    // Each segmented control swaps between `${group}-${range}` panels.
    function initMusicToggles() {
      const buttons = document.querySelectorAll<HTMLButtonElement>(
        "[data-range-group]",
      );
      buttons.forEach((btn) => {
        if (btn.dataset.toggleInitialized === "true") return;
        btn.dataset.toggleInitialized = "true";

        btn.addEventListener("click", () => {
          const group = btn.dataset.rangeGroup;
          document
            .querySelectorAll<HTMLButtonElement>(`[data-range-group="${group}"]`)
            .forEach((other) => {
              const active = other === btn;
              other.setAttribute("aria-pressed", String(active));
              const panel = document.getElementById(`${group}-${other.dataset.range}`);
              panel?.classList.toggle("hidden", !active);
              panel?.classList.toggle("grid", active);
            });
        });
      });
    }

    document.addEventListener("astro:page-load", initMusicToggles);
  </script>
</Layout>
