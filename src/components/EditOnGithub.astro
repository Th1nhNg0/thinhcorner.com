---
import { GITHUB_CONTENT_SOURCE } from "../../data/consts";

const { slug } = Astro.props;
---

<p class="mt-10 mb-4 text-right">
  <a
    href={`${GITHUB_CONTENT_SOURCE}/${slug}`}
    target="_blank"
    rel="noopener noreferrer"
    class="font-mono text-[9px] uppercase tracking-wider text-zinc-600 transition-colors hover:text-[#eab308]"
  >
    Suggest an edit
    <span class="sr-only">(opens in new tab)</span>
  </a>
</p>
