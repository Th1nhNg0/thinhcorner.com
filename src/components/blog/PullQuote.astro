---
interface Props {
  cite?: string;
}

const { cite } = Astro.props;
---

<figure class="not-prose my-8 border-y border-[#27272a] py-5">
  <blockquote class="max-w-2xl text-lg font-medium leading-7 tracking-tight text-zinc-200 md:text-xl">
    <slot />
  </blockquote>
  {cite && <figcaption class="mt-2 font-mono text-[9px] uppercase tracking-wider text-zinc-600">— {cite}</figcaption>}
</figure>
