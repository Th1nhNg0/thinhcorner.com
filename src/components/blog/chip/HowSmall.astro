---
/**
 * "How small is 3nm?" A zoom from a human hair down to a silicon atom.
 * Every object is drawn at its true size relative to the others. The slider
 * moves through them one by one; the camera zooms toward the next object, so
 * the previous one stays visible at the left edge as a huge wall.
 */
type Thing = { key: string; label: string; title: string; body: string };

const things: Thing[] = [
  {
    key: "hair",
    label: "Sợi tóc · 70 µm",
    title: "Sợi tóc người, khoảng 70 micromet",
    body: "Một sợi tóc dày khoảng 70 micromet, tức 70.000 nanomet. Kéo thanh trượt để phóng to dần.",
  },
  {
    key: "rbc",
    label: "Hồng cầu · 7 µm",
    title: "Hồng cầu, khoảng 7 micromet",
    body: "Xếp khoảng mười tế bào hồng cầu cạnh nhau thì bằng bề ngang một sợi tóc. Từ đây trở xuống, mắt thường không còn thấy được.",
  },
  {
    key: "bac",
    label: "E. coli · 2 µm",
    title: "Vi khuẩn E. coli, dài khoảng 2 micromet",
    body: "Một con vi khuẩn E. coli dài khoảng 2 micromet, nhỏ hơn hồng cầu vài lần.",
  },
  {
    key: "duv",
    label: "Bước sóng DUV · 193 nm",
    title: "Bước sóng ánh sáng DUV, 193nm",
    body: "Phần lớn chip trên thế giới được in bằng tia cực tím DUV, bước sóng 193nm, ngắn hơn ánh sáng mắt người nhìn thấy từ hai đến bốn lần.",
  },
  {
    key: "virus",
    label: "Virus cúm · 100 nm",
    title: "Virus cúm, khoảng 100nm",
    body: "Virus cúm có đường kính khoảng 100nm, nhỏ hơn cả bước sóng của ánh sáng DUV.",
  },
  {
    key: "gate",
    label: "Cực cổng chip 3nm · 48 nm",
    title: "Khoảng cách hai cực cổng trên chip 3nm, khoảng 48nm",
    body: "Khoảng cách này chưa bằng một phần tư bước sóng DUV, nên ngành chip mới cần đến EUV.",
  },
  {
    key: "euv",
    label: "Bước sóng EUV · 13,5 nm",
    title: "Bước sóng ánh sáng EUV, 13,5nm",
    body: "Tia cực tím EUV có bước sóng 13,5nm, ngắn hơn DUV 14 lần. Hiện chỉ có máy của ASML dùng được loại ánh sáng này để in chip.",
  },
  {
    key: "dna",
    label: "DNA · 2 nm",
    title: "Chuỗi DNA, rộng khoảng 2nm",
    body: "Một chuỗi DNA rộng khoảng 2nm. Cái tên \"3nm\" nghe như còn to hơn DNA một chút, nhưng đó chỉ là tên gọi.",
  },
  {
    key: "si",
    label: "Nguyên tử silicon · 0,2 nm",
    title: "Nguyên tử silicon, khoảng 0,2nm",
    body: "Một nguyên tử silicon rộng khoảng 0,2nm. Khoảng cách 48nm giữa hai cực cổng chỉ bằng khoảng hai trăm nguyên tử xếp thành hàng.",
  },
];
---

<figure class="not-prose my-8" data-how-small data-things={JSON.stringify(things)}>
  <div class="rounded-surface overflow-hidden border border-(--line) bg-(--surface)">
    <div data-stage class="relative aspect-[4/3] w-full bg-[#0e0e10] sm:aspect-[2/1]">
      <svg
        data-svg
        class="absolute inset-0 h-full w-full select-none"
        viewBox="0 0 672 336"
        role="img"
        aria-label="Phóng to từ sợi tóc xuống nguyên tử silicon, các vật được vẽ đúng tỉ lệ với nhau"
      >
        <defs>
          <linearGradient id="hs-hair" x1="0" x2="1">
            <stop offset="0" stop-color="#241d19"></stop>
            <stop offset=".3" stop-color="#5c4a3e"></stop>
            <stop offset=".55" stop-color="#4a3b31"></stop>
            <stop offset="1" stop-color="#211a16"></stop>
          </linearGradient>
          <radialGradient id="hs-rbc">
            <stop offset="0" stop-color="#7d2b27"></stop>
            <stop offset=".5" stop-color="#92332d"></stop>
            <stop offset=".82" stop-color="#c0504a"></stop>
            <stop offset="1" stop-color="#9a3731"></stop>
          </radialGradient>
          <linearGradient id="hs-bac" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#3f7350"></stop>
            <stop offset="1" stop-color="#244531"></stop>
          </linearGradient>
          <radialGradient id="hs-si" cx=".4" cy=".38" r=".65">
            <stop offset="0" stop-color="#e4e4e7"></stop>
            <stop offset=".55" stop-color="#8b8b94"></stop>
            <stop offset="1" stop-color="#3f3f46"></stop>
          </radialGradient>
        </defs>
        <g data-things-g></g>
        <g data-labels class="font-mono" font-size="11" stroke="#0e0e10" stroke-width="3" stroke-linejoin="round" paint-order="stroke"></g>
      </svg>
      <div
        data-fov
        class="rounded-surface pointer-events-none absolute left-2 top-2 bg-[#0e0e10]/85 px-1.5 py-0.5 font-mono text-[11px] text-(--muted) empty:hidden"
      ></div>
    </div>
    <div class="border-t border-(--line) p-4">
      <!-- Every panel shares one grid cell, so the card keeps the height of the longest one. -->
      <div class="grid" aria-live="polite">
        {
          things.map((t, i) => (
            <div
              data-panel={i}
              class:list={[
                "col-start-1 row-start-1 transition-[opacity,visibility] duration-200 motion-reduce:transition-none",
                i > 0 && "invisible opacity-0",
              ]}
            >
              <h3 class="m-0 text-base font-medium leading-6 text-(--ink)">{t.title}</h3>
              <p class="mt-1.5 mb-0 text-sm leading-6 text-(--muted)">{t.body}</p>
            </div>
          ))
        }
      </div>
      <div class="mt-3">
        <input
          data-range
          type="range"
          min="0"
          max={things.length - 1}
          step="0.001"
          value="0"
          aria-label="Mức phóng to"
          class="block w-full cursor-pointer accent-[#eab308]"
        />
        <div class="relative mx-[7px] mt-1 h-5">
          {
            things.map((t, i) => (
              <button
                type="button"
                data-tick={i}
                title={t.label}
                aria-label={t.label}
                class="absolute top-0 grid h-5 w-5 -translate-x-1/2 place-items-center"
                style={`left:${(i / (things.length - 1)) * 100}%`}
              >
                <span class="block h-1.5 w-1.5 rounded-full bg-(--line-strong) transition-colors" />
              </button>
            ))
          }
        </div>
        <div class="flex justify-between gap-2 font-mono text-[11px] text-(--faint)">
          <span>sợi tóc</span>
          <span>nguyên tử</span>
        </div>
      </div>
    </div>
  </div>
  <figcaption class="mt-2 text-balance text-center text-sm text-(--muted)">
    Các vật được vẽ đúng tỉ lệ với nhau, theo kích thước điển hình. Vạch ngang cạnh mỗi sóng dài đúng một bước sóng.
  </figcaption>
</figure>

<script>
  type Thing = { key: string; label: string; title: string; body: string };
  type Shape = { w: number; h: number; draw: (side: number) => string };

  const NS = "http://www.w3.org/2000/svg";
  const ACCENT = "#eab308";
  const f3 = (n: number) => +n.toFixed(4);

  // A sine wave of two periods, centred on 0, plus a bracket marking one wavelength.
  function wave(lambda: number, color: string, side: number) {
    const w = lambda * 2;
    const a = lambda * 0.26;
    let d = "";
    for (let i = 0; i <= 96; i++) {
      const x = -w / 2 + (w * i) / 96;
      const y = -a * Math.sin((2 * Math.PI * (x + w / 2)) / lambda);
      d += (i ? "L" : "M") + f3(x) + "," + f3(y);
    }
    return (
      `<path d="${d}" fill="none" stroke="${color}" stroke-width="2.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/>` +
      bracket(-lambda / 2, lambda / 2, side * (a + lambda * 0.12), lambda * 0.05)
    );
  }

  function bracket(x0: number, x1: number, y: number, tick: number) {
    return `<path d="M${f3(x0)},${f3(y - tick)}V${f3(y + tick)}M${f3(x0)},${f3(y)}H${f3(x1)}M${f3(x1)},${f3(y - tick)}V${f3(y + tick)}" fill="none" stroke="#a1a1aa" stroke-width="1" vector-effect="non-scaling-stroke"/>`;
  }

  const SHAPES: Record<string, Shape> = {
    hair: {
      w: 70000,
      h: Infinity,
      draw: () => `<rect x="-35000" y="-20000000" width="70000" height="40000000" fill="url(#hs-hair)"/>`,
    },
    rbc: {
      w: 7000,
      h: 7000,
      draw: () => `<circle r="3500" fill="url(#hs-rbc)"/>`,
    },
    bac: {
      w: 2000,
      h: 620,
      draw: () => {
        let dots = "";
        const pts = [
          [-560, -90],
          [-300, 120],
          [-60, -150],
          [180, 60],
          [420, -60],
          [620, 130],
          [-760, 60],
        ];
        for (const [x, y] of pts) dots += `<circle cx="${x}" cy="${y}" r="34" fill="#6fb07f" opacity=".45"/>`;
        return (
          `<rect x="-1000" y="-310" width="2000" height="620" rx="310" fill="url(#hs-bac)" stroke="#6fb07f" stroke-width="1.5" vector-effect="non-scaling-stroke"/>` +
          dots
        );
      },
    },
    duv: { w: 386, h: 386 * 0.52, draw: (side) => wave(193, "#a78bfa", side) },
    virus: {
      w: 124,
      h: 124,
      draw: () => {
        let s = "";
        for (let i = 0; i < 18; i++) {
          const t = (i / 18) * Math.PI * 2;
          const c = Math.cos(t);
          const n = Math.sin(t);
          s += `<line x1="${f3(c * 48)}" y1="${f3(n * 48)}" x2="${f3(c * 58)}" y2="${f3(n * 58)}" stroke="#d68aa0" stroke-width="1.5" vector-effect="non-scaling-stroke"/><circle cx="${f3(c * 59)}" cy="${f3(n * 59)}" r="3" fill="#d68aa0"/>`;
        }
        return s + `<circle r="50" fill="#5a2f42" stroke="#d68aa0" stroke-width="1.5" vector-effect="non-scaling-stroke"/>`;
      },
    },
    gate: {
      w: 70,
      h: 64,
      draw: (side) =>
        `<rect x="-35" y="-5" width="70" height="10" rx="2" fill="#52525b"/>` +
        `<rect x="-32" y="-28" width="16" height="56" rx="2" fill="${ACCENT}"/>` +
        `<rect x="16" y="-28" width="16" height="56" rx="2" fill="${ACCENT}"/>` +
        bracket(-24, 24, side * 35, 2.5),
    },
    euv: { w: 27, h: 27 * 0.52, draw: (side) => wave(13.5, "#c4b5fd", side) },
    dna: {
      w: 6.8,
      h: 2,
      draw: () => {
        // Two strands of a double helix, seen from the side, with base pairs between them.
        const L = 6.8;
        const turn = 3.4;
        const r = 1;
        const strand = (phase: number) => {
          let d = "";
          for (let i = 0; i <= 120; i++) {
            const x = -L / 2 + (L * i) / 120;
            const y = r * Math.sin((2 * Math.PI * (x + L / 2)) / turn + phase);
            d += (i ? "L" : "M") + f3(x) + "," + f3(y);
          }
          return d;
        };
        let rungs = "";
        for (let x = -L / 2 + 0.17; x < L / 2; x += 0.34) {
          const y0 = r * Math.sin((2 * Math.PI * (x + L / 2)) / turn);
          const y1 = r * Math.sin((2 * Math.PI * (x + L / 2)) / turn + 2.2);
          rungs += `<line x1="${f3(x)}" y1="${f3(y0)}" x2="${f3(x)}" y2="${f3(y1)}" stroke="#5eead4" stroke-opacity=".35" stroke-width="1.5" vector-effect="non-scaling-stroke"/>`;
        }
        return (
          rungs +
          `<path d="${strand(0)}" fill="none" stroke="#5eead4" stroke-width="3" stroke-linecap="round" vector-effect="non-scaling-stroke"/>` +
          `<path d="${strand(2.2)}" fill="none" stroke="#2dd4bf" stroke-opacity=".7" stroke-width="3" stroke-linecap="round" vector-effect="non-scaling-stroke"/>`
        );
      },
    },
    si: {
      w: 0.22,
      h: 0.22,
      draw: () => `<circle r="0.11" fill="url(#hs-si)"/>`,
    },
  };

  const smooth = (t: number) => t * t * (3 - 2 * t);
  const clamp = (v: number, a: number, b: number) => Math.max(a, Math.min(b, v));

  function fmtWidth(nm: number) {
    const vi = (n: number, d: number) => n.toFixed(d).replace(".", ",");
    if (nm >= 1000) {
      const um = nm / 1000;
      return vi(um, um >= 10 ? 0 : 1) + " µm";
    }
    if (nm >= 10) return vi(nm, 0) + " nm";
    if (nm >= 1) return vi(nm, 1) + " nm";
    return vi(nm, 2) + " nm";
  }

  function initHowSmall(root: HTMLElement) {
    if (root.dataset.ready) return;
    root.dataset.ready = "1";
    const things = JSON.parse(root.dataset.things || "[]") as Thing[];
    const stage = root.querySelector("[data-stage]") as HTMLElement;
    const svg = root.querySelector("[data-svg]") as SVGSVGElement;
    const gThings = root.querySelector("[data-things-g]") as SVGGElement;
    const gLabels = root.querySelector("[data-labels]") as SVGGElement;
    const fov = root.querySelector("[data-fov]") as HTMLElement;
    const panels = Array.from(root.querySelectorAll("[data-panel]")) as HTMLElement[];
    const range = root.querySelector("[data-range]") as HTMLInputElement;
    const ticks = Array.from(root.querySelectorAll("[data-tick]")) as HTMLButtonElement[];

    const N = things.length;
    const shapes = things.map((t) => SHAPES[t.key]);
    // Lay the objects out left to right, each one a little to the right of the previous.
    const centers: number[] = [0];
    for (let i = 1; i < N; i++) {
      centers[i] = centers[i - 1] + shapes[i - 1].w / 2 + shapes[i].w * 0.6 + shapes[i].w / 2;
    }
    const fovs = shapes.map((s) => s.w * 3);

    // Labels go below even items and above odd ones, so neighbours never share a row.
    const sides = things.map((_, i) => (i % 2 === 0 ? 1 : -1));
    const groups = shapes.map((s, i) => {
      const g = document.createElementNS(NS, "g");
      g.innerHTML = s.draw(-sides[i]);
      gThings.appendChild(g);
      return g;
    });
    const labels = things.map((t) => {
      const el = document.createElementNS(NS, "text");
      el.textContent = t.label;
      gLabels.appendChild(el);
      return el;
    });
    const labelW: number[] = [];

    let W = 672;
    let H = 336;
    let v = 0;
    let shown = -1;

    function camera(at: number): [number, number] {
      let i = Math.floor(at);
      if (i >= N - 1) i = N - 2;
      const f = clamp(at - i, 0, 1);
      const F = Math.exp(Math.log(fovs[i]) + (Math.log(fovs[i + 1]) - Math.log(fovs[i])) * f);
      // Zoom toward the next object: its distance from the centre shrinks smoothly on screen.
      const k0 = W / fovs[i];
      const k = W / F;
      const dc = centers[i + 1] - centers[i];
      const cam = centers[i + 1] - (dc * k0 * (1 - smooth(f))) / k;
      return [F, cam];
    }

    function render() {
      const [F, cam] = camera(v);
      const k = W / F;
      const cur = Math.round(v);
      const sy = H / 2;

      // The frame-width readout sits top-left in the drawing; labels keep clear of it.
      fov.textContent = "Khung hình rộng " + fmtWidth(F);
      const pillR = fov.offsetLeft + fov.offsetWidth + 6;
      const pillB = fov.offsetTop + fov.offsetHeight + 3;

      const sxs = centers.map((c) => (c - cam) * k + W / 2);
      shapes.forEach((s, i) => {
        const g = groups[i];
        const el = labels[i];
        const pw = s.w * k;
        const sx = sxs[i];
        const left = sx - pw / 2;
        const right = sx + pw / 2;
        const visible = pw > 0.35 && right > -2 && left < W + 2;
        if (!visible) {
          g.setAttribute("display", "none");
          el.setAttribute("display", "none");
          return;
        }
        g.removeAttribute("display");
        g.setAttribute("transform", `translate(${sx.toFixed(2)} ${sy}) scale(${k})`);

        // Label
        // Only the current object and its neighbours get a label, so small specks don't crowd it.
        const span = Math.min(right, W) - Math.max(left, 0);
        const whole = left >= 0 && right <= W;
        // On narrow screens, skip the label of the next (smaller) object until we get close to it.
        const reach = W < 480 && i > v ? 0.8 : 1.7;
        const near = clamp((reach - Math.abs(i - v)) / 0.3, 0, 1);
        const o = clamp((pw - 4) / 10, 0, 1) * (whole ? 1 : clamp((span - 18) / 24, 0, 1)) * near;
        if (o <= 0.01) {
          el.setAttribute("display", "none");
          return;
        }
        el.removeAttribute("display");
        const offLeft = sx < 0;
        const text = offLeft ? "← " + things[i].label.split(" · ")[0] : things[i].label;
        if (el.textContent !== text) el.textContent = text;
        const half = Number.isFinite(s.h) ? (s.h / 2) * k : Infinity;
        let y = sides[i] > 0 ? sy + half + 16 : sy - half - 9;
        let x0: number;
        if (offLeft) {
          // The object is now a wall at the left edge: put its name just right of the wall.
          x0 = right + 8 < W * 0.6 ? Math.max(right + 8, 8) : 8;
          el.setAttribute("text-anchor", "start");
          el.setAttribute("x", x0.toFixed(1));
        } else {
          if (labelW[i] === undefined) labelW[i] = el.getComputedTextLength();
          const tw = labelW[i];
          const x = clamp(sx, 8 + tw / 2, W - 8 - tw / 2);
          x0 = x - tw / 2;
          el.setAttribute("text-anchor", "middle");
          el.setAttribute("x", x.toFixed(1));
          // Keep clear of the bigger neighbour on the left when the label reaches over it.
          const p = i - 1;
          if (p >= 0 && Math.abs(x - sxs[p]) < (shapes[p].w * k) / 2 + tw / 2) {
            const ph = (shapes[p].h / 2) * k;
            y = sides[i] > 0 ? Math.max(y, sy + ph + 16) : Math.min(y, sy - ph - 9);
          }
        }
        y = sides[i] > 0 ? Math.min(y, H - 9) : Math.max(y, 16);
        // Drop below the frame-width readout if the label would run under it.
        if (x0 < pillR && y - 9 < pillB) y = pillB + 9;
        el.setAttribute("y", y.toFixed(1));
        el.setAttribute("fill", i === cur ? "#ededed" : "#a1a1aa");
        el.setAttribute("opacity", o.toFixed(2));
      });
      if (cur !== shown) {
        shown = cur;
        // Only the panel for the nearest stop is visible, so a drag announces stops, not every step.
        panels.forEach((p, i) => {
          p.classList.toggle("invisible", i !== cur);
          p.classList.toggle("opacity-0", i !== cur);
        });
        range.setAttribute("aria-valuetext", things[cur].label);
        ticks.forEach((t, i) => {
          const dot = t.firstElementChild as HTMLElement;
          dot.style.background = i === cur ? ACCENT : "";
        });
      }
    }

    function resize() {
      W = Math.max(stage.clientWidth, 200);
      H = Math.max(stage.clientHeight, 150);
      labelW.length = 0;
      svg.setAttribute("viewBox", `0 0 ${W} ${H}`);
      render();
    }

    let anim = 0;
    let target = 0;
    const still = window.matchMedia("(prefers-reduced-motion: reduce)");
    function goTo(to: number) {
      cancelAnimationFrame(anim);
      anim = 0;
      target = to;
      if (still.matches) {
        v = to;
        range.value = String(v);
        render();
        return;
      }
      const from = v;
      const ms = 450 + 180 * Math.abs(to - from);
      const t0 = performance.now();
      const step = (now: number) => {
        const t = Math.min((now - t0) / ms, 1);
        const e = t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
        v = from + (to - from) * e;
        range.value = String(v);
        render();
        anim = t < 1 ? requestAnimationFrame(step) : 0;
      };
      anim = requestAnimationFrame(step);
    }

    range.addEventListener("input", () => {
      cancelAnimationFrame(anim);
      anim = 0;
      v = parseFloat(range.value);
      render();
    });
    // Letting go between two stops settles on the nearest one.
    range.addEventListener("change", () => goTo(Math.round(v)));
    // Arrow keys step one object at a time instead of the slider's tiny native step.
    range.addEventListener("keydown", (e) => {
      const d = e.key === "ArrowRight" || e.key === "ArrowUp" ? 1 : e.key === "ArrowLeft" || e.key === "ArrowDown" ? -1 : 0;
      if (!d) return;
      e.preventDefault();
      goTo(clamp(Math.round(anim ? target : v) + d, 0, N - 1));
    });
    ticks.forEach((t, i) => t.addEventListener("click", () => goTo(i)));

    if ("ResizeObserver" in window) new ResizeObserver(resize).observe(stage);
    resize();
    // Label widths are measured once; measure again when the web font arrives.
    document.fonts?.ready.then(resize);
  }

  const initAll = () => {
    (Array.from(document.querySelectorAll("[data-how-small]")) as HTMLElement[]).forEach(initHowSmall);
  };
  initAll();
  document.addEventListener("astro:page-load", initAll);
</script>
