---
/**
 * A few chokepoints in the chip supply chain: the share held by one company or
 * one place, against the 65% line that BCG and SIA used to count "single
 * points of failure". Bars grow in when the figure scrolls into view.
 */
const rows = [
  { what: "Máy quang khắc EUV", who: "ASML, Hà Lan", share: 100, note: "2025", label: "100%" },
  { what: "Năng lực sản xuất chip dưới 10nm", who: "Đài Loan", share: 92, note: "2019", label: "92%" },
  { what: "Chất cản quang cho EUV", who: "JSR, Tokyo Ohka, Shin-Etsu, Nhật Bản", share: 90, note: "2019", label: "~90%" },
  { what: "Máy quang khắc nói chung", who: "ASML, Hà Lan", share: 83, note: "2025", label: "83%" },
  { what: "Doanh thu đúc chip", who: "TSMC, Đài Loan", share: 72.5, note: "quý 2/2026", label: "72,5%" },
];
---

<figure class="not-prose my-8" data-chokepoints>
  <div class="rounded-surface border border-(--line) bg-(--surface) px-4 pb-4 pt-3">
    <p class="m-0 text-base font-medium text-(--ink)">Thị phần của một công ty hoặc một nơi</p>
    <div class="mt-4">
      <ul class="m-0 list-none space-y-4 p-0">
        {
          rows.map((r) => (
            <li>
              <p class="m-0 text-sm leading-5 text-(--ink)">
                {r.what} <span class="text-(--faint)">· {r.note}</span>
              </p>
              <p class="m-0 mb-1.5 text-xs leading-5 text-(--muted)">{r.who}</p>
              <div class="flex items-center gap-2">
                <div class="relative h-3 flex-1 rounded-[2px] bg-[#26262b]">
                  <div
                    data-bar
                    data-share={r.share}
                    class="absolute inset-y-0 left-0 w-0 rounded-r-[4px] rounded-l-[2px] bg-[#eab308] transition-[width] duration-[1100ms] ease-out"
                  />
                  <div class="absolute -inset-y-1 w-0 border-l-2 border-dotted border-[#ededed]" style="left:65%" />
                </div>
                <span class="w-11 shrink-0 text-right font-mono text-xs tabular-nums text-(--ink) sm:w-[3.25rem]">{r.label}</span>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="mt-3 flex items-center gap-2 font-mono text-[11px] text-(--faint)">
      <span class="inline-block h-3.5 border-l-2 border-dotted border-[#ededed]"></span>
      65%: ngưỡng BCG dùng để đếm các điểm nghẽn
    </div>
  </div>
  <figcaption class="mt-2 text-center text-sm text-(--muted)">
    Năm ghi cạnh từng dòng là năm của số liệu. Nguồn: ASML, BCG và SIA, The Japan Times, TrendForce.
  </figcaption>
</figure>

<script>
  function initChoke(root: HTMLElement) {
    if (root.dataset.ready) return;
    root.dataset.ready = "1";
    const bars = Array.from(root.querySelectorAll("[data-bar]")) as HTMLElement[];
    const grow = (instant: boolean) =>
      bars.forEach((b, i) => {
        b.style.transitionDelay = instant ? "0ms" : `${i * 140}ms`;
        if (instant) b.style.transitionDuration = "0ms";
        b.style.width = `${b.dataset.share}%`;
      });
    if (!("IntersectionObserver" in window) || window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      grow(true);
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          grow(false);
        }
      },
      { threshold: 0.4 }
    );
    io.observe(root);
  }

  const initAll = () => {
    (Array.from(document.querySelectorAll("[data-chokepoints]")) as HTMLElement[]).forEach(initChoke);
  };
  initAll();
  document.addEventListener("astro:page-load", initAll);
</script>
