---
/**
 * A few chokepoints in the chip supply chain: the share held by the leading
 * company or region, against the 65% line that BCG and SIA used to count "single
 * points of failure". Bars grow in when the figure scrolls into view.
 */
const rows = [
  { what: "Máy quang khắc EUV", who: "ASML, Hà Lan", share: 100, note: "2025", label: "100%" },
  { what: "Năng lực sản xuất chip dưới 10nm", who: "Đài Loan", share: 92, note: "2019", label: "92%" },
  { what: "Chất cản quang cho EUV", who: "JSR, Tokyo Ohka, Shin-Etsu, Nhật Bản", share: 90, note: "2019", label: "~90%" },
  { what: "Máy quang khắc nói chung", who: "ASML, Hà Lan", share: 83, note: "2025", label: "83%" },
  { what: "Sản xuất chip thuê", who: "TSMC, Đài Loan", share: 72.5, note: "quý 2/2026", label: "72,5%" },
];
---

<figure class="not-prose my-8" data-chokepoints>
  <div class="rounded-surface border border-(--line) bg-(--surface) p-4">
    <p class="m-0 text-base font-medium text-(--ink)">Thị phần của công ty hoặc khu vực dẫn đầu</p>
    {/* Axis row: same right margin as the tracks, so the label sits over the 65% lines. */}
    <div class="mt-3 flex gap-2" aria-hidden="true">
      <div class="relative h-4 flex-1">
        <span class="absolute bottom-0 -translate-x-1/2 font-mono text-xs leading-4 text-(--ink)" style="left:65%">65%</span>
      </div>
      <span class="w-11 shrink-0 sm:w-[3.25rem]"></span>
    </div>
    <ul class="m-0 mt-2 list-none space-y-4 p-0">
      {
        rows.map((r) => (
          <li>
            <p class="m-0 text-sm leading-5 text-(--ink)">
              {r.what} <span class="whitespace-nowrap text-(--faint)">· {r.note}</span>
            </p>
            <p class="m-0 mb-1.5 text-xs leading-5 text-(--muted)">{r.who}</p>
            <div class="flex items-center gap-2">
              <div class="relative h-3 flex-1 rounded-[2px] bg-[#26262b]">
                <div
                  data-bar
                  data-share={r.share}
                  class="absolute inset-y-0 left-0 w-0 rounded-r-[4px] rounded-l-[2px] bg-[#52525b] transition-[width] duration-[1100ms] ease-out"
                />
                <div
                  data-over
                  data-share={r.share}
                  class="absolute inset-y-0 w-0 rounded-r-[4px] bg-[#eab308] transition-[width] duration-[600ms] ease-out"
                  style="left:65%"
                />
                <div class="absolute -inset-y-1 w-px bg-(--ink)/70" style="left:65%" />
              </div>
              <span class="w-11 shrink-0 text-right font-mono text-xs tabular-nums text-(--ink) sm:w-[3.25rem]">{r.label}</span>
            </div>
          </li>
        ))
      }
    </ul>
    <p class="m-0 mt-4 font-mono text-xs text-(--faint)">65%: ngưỡng BCG dùng để đếm các điểm nghẽn</p>
  </div>
  <figcaption class="mt-2 text-balance text-center text-sm text-(--muted)">
    Năm ghi cạnh từng dòng là năm của số liệu.
    <span class="mt-0.5 block font-mono text-xs text-(--faint)">Nguồn: ASML, BCG và SIA, The Japan Times, TrendForce.</span>
  </figcaption>
</figure>

<script>
  function initChoke(root: HTMLElement) {
    if (root.dataset.ready) return;
    root.dataset.ready = "1";
    const bars = Array.from(root.querySelectorAll("[data-bar]")) as HTMLElement[];
    const overs = Array.from(root.querySelectorAll("[data-over]")) as HTMLElement[];
    // Grey bars grow to each share first; then the part past 65% turns accent.
    const grow = (instant: boolean) => {
      bars.forEach((b, i) => {
        b.style.transitionDelay = instant ? "0ms" : `${i * 140}ms`;
        if (instant) b.style.transitionDuration = "0ms";
        b.style.width = `${b.dataset.share}%`;
      });
      overs.forEach((o, i) => {
        o.style.transitionDelay = instant ? "0ms" : `${i * 140 + 700}ms`;
        if (instant) o.style.transitionDuration = "0ms";
        o.style.width = `${Math.max(0, +(o.dataset.share || 0) - 65)}%`;
      });
    };
    if (!("IntersectionObserver" in window) || window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      grow(true);
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          grow(false);
        }
      },
      { threshold: 0.4 }
    );
    io.observe(root);
  }

  const initAll = () => {
    (Array.from(document.querySelectorAll("[data-chokepoints]")) as HTMLElement[]).forEach(initChoke);
  };
  initAll();
  document.addEventListener("astro:page-load", initAll);
</script>
