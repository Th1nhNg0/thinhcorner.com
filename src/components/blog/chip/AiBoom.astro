---
/**
 * Nvidia's data center revenue per quarter, from the quarter ended April 2022
 * to the quarter ended July 2026, in billions of USD, from Nvidia's quarterly
 * reports. Nvidia's fiscal year ends in late January, so each bar is labelled
 * by the month its quarter ends. A marker shows the ChatGPT launch
 * (30 Nov 2022), a third of the way into the quarter ended January 2023.
 * Bars grow in when the chart scrolls into view; hover or tap shows a value.
 */
const quarters = [
  "4/2022", "7/2022", "10/2022", "1/2023", "4/2023", "7/2023", "10/2023", "1/2024", "4/2024",
  "7/2024", "10/2024", "1/2025", "4/2025", "7/2025", "10/2025", "1/2026", "4/2026", "7/2026",
];
const values = [
  3.75, 3.81, 3.83, 3.62, 4.28, 10.32, 14.51, 18.4, 22.56, 26.27, 30.77, 35.58, 39.11, 41.1, 51.2, 62.3, 75.2, 89.0,
];
const vi = (n: number) => n.toFixed(1).replace(".", ",");
---

<figure class="not-prose my-8" data-ai-boom data-quarters={JSON.stringify(quarters)} data-values={JSON.stringify(values)}>
  <div class="rounded-surface border border-(--line) bg-(--surface) p-4">
    <p class="m-0 text-base font-medium text-(--ink)">Doanh thu mảng trung tâm dữ liệu của Nvidia mỗi quý, tỷ USD</p>
    <div data-stage class="relative mt-2 w-full touch-pan-y">
      <svg
        data-svg
        class="block w-full select-none"
        role="img"
        aria-label="Biểu đồ cột doanh thu trung tâm dữ liệu của Nvidia theo quý, từ 3,8 tỷ USD trong quý kết thúc tháng 4 năm 2022 lên 89,0 tỷ USD trong quý kết thúc tháng 7 năm 2026. ChatGPT ra mắt ngày 30 tháng 11 năm 2022."
      ></svg>
      <div
        data-tip
        class="rounded-surface pointer-events-none absolute left-0 top-0 hidden whitespace-nowrap border border-(--line-strong) bg-(--page) px-2.5 py-1.5 font-mono text-xs leading-5 text-(--ink) shadow-lg"
      >
      </div>
    </div>
    <details class="mt-1 text-sm text-(--muted)">
      <summary class="cursor-pointer select-none font-mono text-xs text-(--faint)">Xem bảng số liệu</summary>
      <table class="mt-2 w-full max-w-xs font-mono text-xs tabular-nums">
        <thead>
          <tr class="text-left text-(--faint)"><th class="py-0.5 font-normal">Quý kết thúc</th><th class="py-0.5 text-right font-normal">Tỷ USD</th></tr>
        </thead>
        <tbody>
          {
            quarters.map((q, i) => (
              <tr class="border-t border-(--line)">
                <td class="py-0.5">{q}</td>
                <td class="py-0.5 text-right">{vi(values[i])}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </details>
  </div>
  <figcaption class="mt-2 text-balance text-center text-sm text-(--muted)">
    Năm tài chính của Nvidia kết thúc vào cuối tháng 1, nên mỗi cột được ghi theo tháng kết thúc quý.
    <span class="mt-0.5 block font-mono text-xs text-(--faint)">Nguồn: báo cáo kết quả kinh doanh hằng quý của Nvidia.</span>
  </figcaption>
</figure>

<script>
  const NS = "http://www.w3.org/2000/svg";
  const C_BAR = "#a1a1aa";
  const C_LAST = "#ededed";
  const vi = (n: number) => n.toFixed(1).replace(".", ",");

  function el(tag: string, attrs: Record<string, string | number>, text?: string) {
    const e = document.createElementNS(NS, tag);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    if (text !== undefined) e.textContent = text;
    return e;
  }

  function initBoom(root: HTMLElement) {
    if (root.dataset.ready) return;
    root.dataset.ready = "1";
    const quarters = JSON.parse(root.dataset.quarters || "[]") as string[];
    const values = JSON.parse(root.dataset.values || "[]") as number[];
    const stage = root.querySelector("[data-stage]") as HTMLElement;
    const svg = root.querySelector("[data-svg]") as SVGSVGElement;
    const tip = root.querySelector("[data-tip]") as HTMLElement;
    const N = values.length;
    const CHATGPT = 3; // the quarter ended January 2023 holds 30 Nov 2022
    const YMAX = 100;
    const M = { l: 30, r: 8, t: 30, b: 26 };

    let W = 640;
    let H = 320;
    let grown = false;
    let bars: SVGRectElement[] = [];
    let labels: SVGGElement | null = null;
    let slot = 0;
    let x0 = 0;
    let y0 = 0;
    let y = (_: number) => 0;
    let active = -1;

    document.addEventListener("pointerdown", (e) => {
      if (!stage.contains(e.target as Node)) hide();
    });

    function build() {
      W = Math.max(stage.clientWidth, 260);
      H = Math.round(Math.min(Math.max(W * 0.52, 240), 340));
      hide();
      svg.setAttribute("viewBox", `0 0 ${W} ${H}`);
      svg.setAttribute("height", String(H));
      svg.replaceChildren();
      x0 = M.l;
      const x1 = W - M.r;
      y0 = H - M.b;
      const y1 = M.t;
      slot = (x1 - x0) / N;
      y = (v: number) => y0 - ((y0 - y1) * v) / YMAX;

      const axis = el("g", { "font-size": 11, fill: "#8f8f98", class: "font-mono" });
      for (let v = 0; v <= YMAX; v += 25) {
        axis.appendChild(el("line", { x1: x0, x2: x1, y1: y(v), y2: y(v), stroke: v === 0 ? "#3f3f46" : "#27272a", "stroke-width": 1 }));
        axis.appendChild(el("text", { x: x0 - 6, y: y(v) + 4, "text-anchor": "end" }, String(v)));
      }
      // One year label under each quarter that ends in April.
      quarters.forEach((q, i) => {
        if (q.startsWith("4/")) axis.appendChild(el("text", { x: x0 + slot * i + slot / 2, y: y0 + 18, "text-anchor": "middle" }, q.slice(2)));
      });
      svg.appendChild(axis);

      // ChatGPT marker, a third of the way into its quarter.
      const mx = x0 + slot * (CHATGPT + 1 / 3);
      const mark = el("g", { class: "font-mono", "font-size": 12 });
      mark.appendChild(el("line", { x1: mx, x2: mx, y1: y(YMAX) - 14, y2: y0, stroke: "#71717a", "stroke-width": 1, "stroke-dasharray": "3 3" }));
      mark.appendChild(el("text", { x: mx + 6, y: y(YMAX) - 4, fill: "#ededed" }, W < 480 ? "ChatGPT" : "ChatGPT ra mắt"));
      mark.appendChild(el("text", { x: mx + 6, y: y(YMAX) + 12, fill: "#8f8f98", "font-size": 11 }, "30/11/2022"));
      svg.appendChild(mark);

      const bw = Math.max(slot * 0.68, 4);
      bars = values.map((_, i) => {
        const r = el("rect", {
          x: x0 + slot * i + (slot - bw) / 2,
          width: bw,
          y: y0,
          height: 0,
          rx: Math.min(2, bw / 4),
          fill: i === N - 1 ? C_LAST : C_BAR,
        }) as SVGRectElement;
        svg.appendChild(r);
        return r;
      });

      // Value labels on the first and last bar, shown once the bars have grown.
      labels = el("g", { class: "font-mono", "font-size": 12, opacity: 0 }) as SVGGElement;
      const lab = (i: number, c: string) =>
        labels!.appendChild(el("text", { x: x0 + slot * i + slot / 2, y: y(values[i]) - 6, "text-anchor": "middle", fill: c }, vi(values[i])));
      lab(0, "#a1a1aa");
      lab(N - 1, "#ededed");
      svg.appendChild(labels);

      const hit = el("rect", { x: 0, y: 0, width: W, height: H, fill: "transparent" });
      svg.appendChild(hit);
      hit.addEventListener("pointermove", (e) => show(e as PointerEvent));
      hit.addEventListener("pointerdown", (e) => show(e as PointerEvent));
      hit.addEventListener("pointerleave", (e) => {
        if ((e as PointerEvent).pointerType !== "touch") hide();
      });

      if (grown) paint(1, false);
    }

    function paint(p: number, stagger: boolean) {
      bars.forEach((b, i) => {
        // Each bar starts a little after the previous one.
        const local = stagger ? Math.max(0, Math.min(1, (p * (N + 6) - i) / 6)) : p;
        const e = 1 - Math.pow(1 - local, 3);
        const h = (y0 - y(values[i])) * e;
        b.setAttribute("y", String(y0 - h));
        b.setAttribute("height", String(h));
      });
      labels?.setAttribute("opacity", String(Math.max(0, Math.min(1, (p - 0.85) / 0.15))));
    }

    function show(e: PointerEvent) {
      const r = svg.getBoundingClientRect();
      const px = ((e.clientX - r.left) / r.width) * W;
      const i = Math.max(0, Math.min(N - 1, Math.floor((px - x0) / slot)));
      if (active !== i) {
        if (active >= 0) bars[active]?.setAttribute("fill", active === N - 1 ? C_LAST : C_BAR);
        active = i;
        bars[i]?.setAttribute("fill", "#ededed");
      }
      const k = r.width / W;
      tip.innerHTML = `<div class="text-(--faint)">Quý kết thúc ${quarters[i]}</div><div>${vi(values[i])} tỷ USD</div>`;
      tip.classList.remove("hidden");
      const tw = tip.offsetWidth;
      const cx = (x0 + slot * i + slot / 2) * k;
      let left = cx + 10;
      if (left + tw > r.width) left = cx - tw - 10;
      left = Math.max(0, Math.min(left, r.width - tw));
      tip.style.transform = `translate(${Math.round(left)}px, ${Math.round(M.t * k)}px)`;
    }

    function hide() {
      if (active >= 0) bars[active]?.setAttribute("fill", active === N - 1 ? C_LAST : C_BAR);
      active = -1;
      tip.classList.add("hidden");
    }

    function play() {
      if (grown) return;
      grown = true;
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        paint(1, false);
        return;
      }
      const t0 = performance.now();
      const ms = 1800;
      const step = (now: number) => {
        const t = Math.min((now - t0) / ms, 1);
        paint(t, true);
        if (t < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }

    build();
    if ("ResizeObserver" in window) {
      let lastW = stage.clientWidth;
      new ResizeObserver(() => {
        if (Math.abs(stage.clientWidth - lastW) < 2) return;
        lastW = stage.clientWidth;
        build();
      }).observe(stage);
    }
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            io.disconnect();
            play();
          }
        },
        { threshold: 0.4 }
      );
      io.observe(svg);
    } else play();
  }

  const initAll = () => {
    (Array.from(document.querySelectorAll("[data-ai-boom]")) as HTMLElement[]).forEach(initBoom);
  };
  initAll();
  document.addEventListener("astro:page-load", initAll);
</script>
