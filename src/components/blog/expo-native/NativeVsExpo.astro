---
/**
 * Every metric on one scale: native as a share of Expo, with Expo pinned at 100%
 * (the dashed line). All rows are "lower is better" (memory, time, size), so a
 * shorter bar is a win and a bar past the line is a loss. Real values sit under
 * each label; the change is the big number on the right.
 */
type Row = { label: string; expo: number; native: number; unit: string; digits?: number };
type Group = { name: string; note?: string; rows: Row[] };
type Props = { groups: Group[]; caption?: string };
const { groups, caption } = Astro.props;

const ratios = groups.flatMap((g) => g.rows.map((r) => r.native / r.expo));
const domain = Math.max(1, ...ratios) * 1.04;
const at = (ratio: number) => (ratio / domain) * 100;
const fmt = (v: number, digits = 0) =>
  v.toLocaleString("en-US", { minimumFractionDigits: digits, maximumFractionDigits: digits });

const rowsOf = (g: Group) =>
  g.rows.map((r) => {
    const ratio = r.native / r.expo;
    const change = ratio - 1;
    const verdict = Math.abs(change) < 0.03 ? "same" : change < 0 ? "win" : "loss";
    return {
      ...r,
      ratio,
      verdict,
      delta: verdict === "same" ? "≈" : `${change > 0 ? "+" : "−"}${Math.round(Math.abs(change) * 100)}%`,
      values: `${fmt(r.expo, r.digits)} → ${fmt(r.native, r.digits)} ${r.unit}`,
    };
  });
---

<figure class="not-prose my-12">
  <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-zinc-400">
    <span class="flex items-center gap-2">
      <span class="h-2.5 w-6 rounded-sm bg-[#c98500]" />Native, as a share of Expo
    </span>
    <span class="flex items-center gap-2">
      <span class="h-3.5 w-0 border-l border-dashed border-zinc-400" />Expo = 100%
    </span>
    <span>Shorter is better</span>
  </div>

  {
    groups.map((g) => (
      <div class="mt-8">
        <div class="flex flex-col gap-0.5 border-b border-[#27272a] pb-2 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
          <span class="text-sm font-medium text-zinc-100">{g.name}</span>
          {g.note && <span class="data-figure !text-xs sm:text-right">{g.note}</span>}
        </div>
        <div class="divide-y divide-[#1f1f23]">
          {rowsOf(g).map((r) => (
            <div class="grid grid-cols-[1fr_auto] items-center gap-x-4 gap-y-2 py-3 sm:grid-cols-[12rem_1fr_4rem]">
              <div class="min-w-0">
                <div class="text-sm text-zinc-200">{r.label}</div>
                <div class="data-figure mt-0.5 !text-xs">{r.values}</div>
              </div>
              <div
                class="relative col-span-2 row-start-2 h-3 sm:col-span-1 sm:row-start-auto"
                title={`Expo ${fmt(r.expo, r.digits)} ${r.unit} · Native ${fmt(r.native, r.digits)} ${r.unit}`}
              >
                <div class="absolute inset-y-0 left-0 rounded-sm bg-white/[0.06]" style={`width:${at(1)}%`} />
                <div
                  class:list={["absolute inset-y-0 left-0 rounded-sm", r.verdict === "loss" ? "bg-[#c98500]/45" : "bg-[#c98500]"]}
                  style={`width:${Math.max(0.6, at(r.ratio))}%`}
                />
                <div class="absolute -inset-y-1 w-0 border-l border-dashed border-zinc-400" style={`left:${at(1)}%`} />
              </div>
              <div
                class:list={[
                  "text-right font-mono text-lg leading-none",
                  r.verdict === "win" && "text-[#e3b341]",
                  r.verdict === "loss" && "text-zinc-400",
                  r.verdict === "same" && "text-zinc-500",
                ]}
              >
                {r.delta}
              </div>
            </div>
          ))}
        </div>
      </div>
    ))
  }
  {caption && <figcaption class="mt-6 text-sm text-zinc-500">{caption}</figcaption>}
</figure>
