---
/**
 * Daily value stacked by model. Serves both metrics, which need opposite scales.
 *
 * Stacked segments must sum to the bar height, which rules out a log scale. The
 * two metrics pull in opposite directions:
 *
 *   cost   — spans ~7x (median day $19.80 against a $140 peak), so a linear
 *            scale reads properly and the stacking stays strictly honest.
 *   tokens — spans ~13,000x because cache reads dominate. Linear leaves 41 of 71
 *            days under 2px (median 1.5px), so tokens use a log scale: the median
 *            day then renders at ~71px. The trade-off is that segment heights
 *            encode each model's share of that day rather than an absolute amount,
 *            so the caption states the scale and tooltips carry exact figures.
 *
 * Columns are flex children, so the series always fits its container without the
 * fixed-width overflow an SVG would introduce. Segments grow proportionally, so
 * they fill each column exactly with no rounding gaps.
 */
import type { StackDay, StackMetric, StackSeries } from "@/lib/ccusage";

type Props = {
  metric: StackMetric;
  series: StackSeries[];
  days: StackDay[];
  maxDayValue: number;
  /** Caption for the scale, shown beside the chart. */
  formatCost: (value: number) => string;
  formatCompact: (value: number) => string;
  formatDay: (period: string, includeYear?: boolean) => string;
};

const { metric, series, days, maxDayValue, formatCost, formatCompact, formatDay } =
  Astro.props;

const TRACK_HEIGHT = 112;
const MIN_COLUMN_PX = 1.5;
const isCost = metric === "cost";

const formatValue = (value: number) => (isCost ? formatCost(value) : formatCompact(value));

// Log floor sits a decade below the smallest active day, so the quietest day is
// still a readable 20px rather than a hairline.
const positives = days.map((day) => day.total).filter((value) => value > 0);
const logFloor = Math.log10(Math.max(1, (positives.length ? Math.min(...positives) : 1) / 10));
const logMax = Math.log10(Math.max(maxDayValue, 2));
const logSpan = Math.max(1e-6, logMax - logFloor);

const columnPercent = (total: number) => {
  if (total <= 0 || maxDayValue <= 0) return 0;
  const ratio = isCost
    ? total / maxDayValue
    : (Math.log10(total) - logFloor) / logSpan;
  const px = Math.max(MIN_COLUMN_PX, Math.min(1, ratio) * TRACK_HEIGHT);
  return (px / TRACK_HEIGHT) * 100;
};

// Resolved in frontmatter: Astro's compiler rejects a multi-line `return (` of
// JSX nested inside a map callback.
const columns = days.map((day) => ({
  period: day.period,
  percent: columnPercent(day.total),
  segments: series
    .map((entry, index) => {
      const value = day.values[index] ?? 0;
      return {
        color: entry.color,
        modelName: entry.modelName,
        value,
        cost: day.costs[index] ?? 0,
        tokens: day.tokens[index] ?? 0,
        dayShare: day.total > 0 ? (value / day.total) * 100 : 0,
      };
    })
    .filter((segment) => segment.value > 0),
}));

const monthGroups: Array<{ key: string; label: string; days: number }> = [];
for (const day of days) {
  const key = day.period.slice(0, 7);
  const current = monthGroups[monthGroups.length - 1];
  if (current && current.key === key) {
    current.days += 1;
  } else {
    monthGroups.push({
      key,
      label: new Date(`${day.period}T00:00:00Z`).toLocaleDateString("en-US", {
        month: "short",
        timeZone: "UTC",
      }),
      days: 1,
    });
  }
}
---

<div>
  <div class="flex items-baseline justify-between font-mono text-[10px] text-zinc-600">
    <span>stacked by model · {isCost ? "linear scale" : "log scale"}</span>
    <span>peak {formatValue(maxDayValue)}/day</span>
  </div>

  <div
    class="mt-2 flex items-end gap-px"
    style={`height:${TRACK_HEIGHT}px`}
    role="img"
    aria-label={`Daily ${isCost ? "estimated cost" : "token volume"}, stacked by model`}
  >
    {
      columns.map((column) => (
        <div class="flex flex-1 flex-col-reverse" style={`height:${column.percent}%`}>
          {column.segments.map((segment) => (
            <div
              class="w-full transition-[filter] hover:brightness-150 focus-visible:outline focus-visible:outline-1 focus-visible:outline-zinc-100"
              style={`flex:${segment.value} 1 0%;background:${segment.color}`}
              tabindex="0"
              role="img"
              aria-label={`${formatDay(column.period, true)}, ${segment.modelName}: ${formatValue(segment.value)}`}
              data-daily-tooltip={`${formatDay(column.period, true)} · ${segment.modelName} · ${formatValue(segment.value)} · ${segment.dayShare.toFixed(0)}% of day · ${isCost ? `${formatCompact(segment.tokens)} tokens` : `${formatCost(segment.cost)}`}`}
            />
          ))}
        </div>
      ))
    }
  </div>

  <!-- Month axis: flex-grow proportional to each month's active-day count -->
  <div class="mt-1.5 flex font-mono text-[10px] text-zinc-600">
    {
      monthGroups.map((group) => (
        <div class="relative min-w-0" style={`flex:${group.days} 1 0%`}>
          <span class="absolute left-0 top-0 whitespace-nowrap">{group.label}</span>
        </div>
      ))
    }
  </div>

  <ul class="mt-4 grid grid-cols-1 gap-x-5 gap-y-1.5 border-t border-[#27272a] pt-3 font-mono text-[11px] sm:grid-cols-2">
    {
      series.map((entry) => (
        <li class="flex items-baseline gap-2">
          <span
            class="size-2 shrink-0 translate-y-px"
            style={`background:${entry.color}`}
            aria-hidden="true"
          />
          <span class="min-w-0 flex-1 truncate text-zinc-400" title={entry.modelName}>
            {entry.modelName}
          </span>
          <span class="shrink-0 text-zinc-500">
            {formatValue(entry.value)} · {(entry.share * 100).toFixed(1)}%
          </span>
        </li>
      ))
    }
  </ul>
</div>
