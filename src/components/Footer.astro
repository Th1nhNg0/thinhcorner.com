---
import Container from "./Container.astro";
import CornerMark from "./CornerMark.astro";
import { AUTHOR_EMAIL, AUTHOR_NAME, SITE, SOCIAL_MEDIA } from "../../data/consts";

const siteLinks = [
  { href: "/writing", label: "Writing" },
  { href: "/projects", label: "Projects" },
  { href: "/data", label: "Data" },
  { href: "/now", label: "Now" },
];

const elsewhere = [
  { href: SOCIAL_MEDIA.github, label: "GitHub", external: true },
  { href: SOCIAL_MEDIA.linkedin, label: "LinkedIn", external: true },
  { href: `mailto:${AUTHOR_EMAIL}`, label: "Email", external: false },
  { href: "/rss.xml", label: "RSS", external: false },
].filter((link): link is { href: string; label: string; external: boolean } => Boolean(link.href));

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <Container>
    <div class="flex flex-col gap-8 py-10 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <a href="/" class="site-brand">
          <CornerMark class="size-4 shrink-0 text-[#eab308]" />
          <span>{SITE.title.replace("'", "’")}</span>
        </a>
        <p class="mt-3 max-w-[22rem] text-sm leading-relaxed text-zinc-500">
          Notes on technology, research and things I’m learning, written in Ho Chi Minh City.
        </p>
      </div>
      <div class="flex gap-14 text-sm sm:gap-16">
        <nav aria-label="Footer">
          <ul class="space-y-1">
            {
              siteLinks.map((link) => (
                <li>
                  <a href={link.href} class="footer-link">{link.label}</a>
                </li>
              ))
            }
          </ul>
        </nav>
        <ul class="space-y-1">
          {
            elsewhere.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="footer-link"
                  {...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                >
                  {link.label}
                  {link.external && <span class="sr-only">(opens in new tab)</span>}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <p class="border-t border-[#1f1f23] py-5 text-xs text-zinc-600">
      © {year} {AUTHOR_NAME}
    </p>
  </Container>
</footer>
