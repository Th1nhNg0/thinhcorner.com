---
// The site mark: a small rocket, the same shape as the favicon.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg viewBox="0 0 24 24" class={className} fill="currentColor" aria-hidden="true" focusable="false">
  <g transform="rotate(45 12 12)">
    <path d="M12 1.6c3.1 2.7 4.5 6.3 4.5 10.2v3.4h-9v-3.400c0-3.900 1.400-7.500 4.500-10.200z"></path>
    <path d="M7.500 11.200 4.200 15.200v3.300l3.300-1.700zM16.500 11.200l3.300 4v3.300l-3.300-1.700z"></path>
    <circle cx="12" cy="8.300" r="1.900" fill="var(--page)"></circle>
    <path d="M10.100 16.900h3.800L12 22.400z" opacity="0.7"></path>
  </g>
</svg>
