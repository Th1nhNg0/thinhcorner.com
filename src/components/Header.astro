---
import Container from "./Container.astro";

const pathname = Astro.url.pathname;
function isActive(href: string) {
  if (href === "/") return pathname === "/";
  return pathname.startsWith(href);
}
const navLinks = [
  { href: "/", label: "home" },
  { href: "/writing", label: "writing" },
  { href: "/now", label: "now" },
  { href: "/projects", label: "projects" },
  { href: "/data", label: "data" },
];
---

<a
  href="#main-content"
  class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-3 focus:z-50 focus:bg-[#eab308] focus:px-3 focus:py-1.5 focus:text-sm focus:text-black"
>
  Skip to content
</a>
<header>
  <Container>
    <nav
      class="scrollbar-hide flex h-12 items-center gap-5 overflow-x-auto"
      aria-label="Main navigation"
    >
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              "whitespace-nowrap text-sm transition-colors focus-visible:outline-none",
              isActive(link.href)
                ? "text-[#eab308]"
                : "text-zinc-500 hover:text-zinc-200",
            ]}
            aria-current={isActive(link.href) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </Container>
</header>
