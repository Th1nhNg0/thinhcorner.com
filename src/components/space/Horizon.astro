---
// The edge of a planet at the foot of the page, with the sun coming up behind it.
---

<svg class="site-horizon" viewBox="0 0 1440 160" preserveAspectRatio="none" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="hz-limb" x1="0" x2="1" y1="0" y2="0">
      <stop offset="0" stop-color="#fff" stop-opacity="0"></stop>
      <stop offset="0.3" stop-color="#fff" stop-opacity="0.22"></stop>
      <stop offset="0.62" stop-color="#fde68a" stop-opacity="0.75"></stop>
      <stop offset="0.68" stop-color="#eab308" stop-opacity="1"></stop>
      <stop offset="0.76" stop-color="#fde68a" stop-opacity="0.6"></stop>
      <stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
    </linearGradient>
    <linearGradient id="hz-ground" x1="0" x2="0" y1="0" y2="1">
      <stop offset="0.3" stop-color="#151518"></stop>
      <stop offset="1" stop-color="#0c0c0d"></stop>
    </linearGradient>
    <radialGradient id="hz-sun" cx="0.68" cy="0.42" r="0.5" gradientTransform="translate(0.68 0.42) scale(0.36 1) translate(-0.68 -0.42)">
      <stop offset="0" stop-color="#eab308" stop-opacity="0.34"></stop>
      <stop offset="0.5" stop-color="#eab308" stop-opacity="0.08"></stop>
      <stop offset="1" stop-color="#eab308" stop-opacity="0"></stop>
    </radialGradient>
    <linearGradient id="hz-air" x1="0" x2="0" y1="0" y2="1">
      <stop offset="0" stop-color="#fff" stop-opacity="0"></stop>
      <stop offset="1" stop-color="#fff" stop-opacity="0.05"></stop>
    </linearGradient>
    <clipPath id="hz-sky"><path d="M0 0H1440V150Q720 -30 0 150z"></path></clipPath>
  </defs>
  <g clip-path="url(#hz-sky)">
    <rect width="1440" height="160" fill="url(#hz-sun)"></rect>
  </g>
  <path d="M0 150Q720 -30 1440 150V160H0z" fill="url(#hz-ground)"></path>
  <path d="M0 150Q720 -30 1440 150" fill="none" stroke="url(#hz-limb)" stroke-width="1.5" vector-effect="non-scaling-stroke"></path>
</svg>
