---
// Stars behind the top of every page: a far layer, a near layer, and two sparse
// layers that fade in and out of step with each other so the sky twinkles.
---

<div class="site-sky" aria-hidden="true">
  <div class="site-sky-layer site-sky-far"></div>
  <div class="site-sky-layer site-sky-near"></div>
  <div class="site-sky-layer site-sky-twinkle site-sky-twinkle-a"></div>
  <div class="site-sky-layer site-sky-twinkle site-sky-twinkle-b"></div>
</div>
