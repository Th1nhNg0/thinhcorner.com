---
// Row of headline numbers shared by the /data pages.
interface Stat {
  label: string;
  value: string | number;
  note?: string;
}

interface Props {
  stats: Stat[];
  cols?: 3 | 4;
}

const { stats, cols = 4 } = Astro.props;
---

<dl class="data-stats" data-cols={cols}>
  {
    stats.map((stat) => (
      <div class="data-stat">
        <dt class="data-stat-label">{stat.label}</dt>
        <dd class="data-stat-value">{stat.value}</dd>
        {stat.note && <dd class="data-stat-note">{stat.note}</dd>}
      </div>
    ))
  }
</dl>
